#!/usr/bin/env bash
# One-shot checksum-gated recovery for the two fixed Marmic HPC tools.

set -euo pipefail
umask 077

die() {
    printf 'recovery failed: %s\n' "$1" >&2
    exit 1
}

[[ "$#" -eq 6 ]] || \
    die "expected dispatcher, commit, two checksums, and two payload sizes"
dispatcher="$1"
commit="$2"
expected_dispatcher="$3"
expected_job="$4"
dispatcher_size="$5"
job_size="$6"

[[ "$dispatcher" =~ ^/[A-Za-z0-9._/-]+/nf-gtd-hpc-remote$ ]] || \
    die "dispatcher path is invalid"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || die "commit is invalid"
[[ "$expected_dispatcher" =~ ^[0-9a-f]{64}$ ]] || \
    die "dispatcher checksum is invalid"
[[ "$expected_job" =~ ^[0-9a-f]{64}$ ]] || die "job checksum is invalid"
[[ "$dispatcher_size" =~ ^[1-9][0-9]{0,6}$ ]] || \
    die "dispatcher payload size is invalid"
[[ "$job_size" =~ ^[1-9][0-9]{0,6}$ ]] || \
    die "job payload size is invalid"
(( dispatcher_size <= 2097152 )) || die "dispatcher payload is too large"
(( job_size <= 2097152 )) || die "job payload is too large"

tool_dir="$(dirname "$dispatcher")"
root="$(dirname "$tool_dir")"
job="$tool_dir/nf-gtd-hpc-smoke-job"
locks="$root/_locks"
bootstrap_used=false
root_bootstrap_used=false
pixi_path_bootstrap_used=false
pixi_executable=""

[[ "$dispatcher" == "$tool_dir/nf-gtd-hpc-remote" ]] || \
    die "dispatcher target is inconsistent"
if [[ ! -e "$root" && ! -L "$root" ]]; then
    existing_root_anchor="$root"
    while [[ ! -e "$existing_root_anchor" && ! -L "$existing_root_anchor" ]]; do
        parent="$(dirname "$existing_root_anchor")"
        [[ "$parent" != "$existing_root_anchor" ]] || \
            die "cannot locate an existing run-root ancestor"
        existing_root_anchor="$parent"
    done
    [[ "$existing_root_anchor" != / && -d "$existing_root_anchor" && \
       ! -L "$existing_root_anchor" && -O "$existing_root_anchor" && \
       "$root" == "$existing_root_anchor"/* ]] || \
        die "run-root ancestor is unsafe"
    mkdir -p "$root" || die "cannot create fixed run root"
    [[ "$(cd "$root" && pwd -P)" == "$root" ]] || \
        die "created run root resolves outside the fixed path"
    chmod 0700 "$root"
    root_bootstrap_used=true
fi
[[ -d "$root" && ! -L "$root" && -O "$root" ]] || \
    die "run root is unsafe"
if [[ ! -e "$tool_dir" && ! -L "$tool_dir" ]]; then
    mkdir "$tool_dir" || die "cannot create fixed tool directory"
    chmod 0700 "$tool_dir"
    bootstrap_used=true
fi
[[ -d "$tool_dir" && ! -L "$tool_dir" && -O "$tool_dir" ]] || \
    die "tool directory is unsafe"
dispatcher_present=false
job_present=false
if [[ -e "$dispatcher" || -L "$dispatcher" ]]; then
    [[ -f "$dispatcher" && ! -L "$dispatcher" && -O "$dispatcher" ]] || \
        die "installed dispatcher is unsafe"
    dispatcher_present=true
fi
if [[ -e "$job" || -L "$job" ]]; then
    [[ -f "$job" && ! -L "$job" && -O "$job" ]] || \
        die "installed job script is unsafe"
    job_present=true
fi
if [[ "$dispatcher_present" == true && "$job_present" == true ]]; then
    bootstrap_used=false
elif [[ "$dispatcher_present" == false && "$job_present" == false ]]; then
    bootstrap_used=true
else
    die "fixed tool installation is partial"
fi

pixi_path="$tool_dir/pixi.path"
if [[ -e "$pixi_path" || -L "$pixi_path" ]]; then
    [[ -f "$pixi_path" && ! -L "$pixi_path" && -O "$pixi_path" ]] || \
        die "installed Pixi path record is unsafe"
    IFS= read -r pixi_executable < "$pixi_path" || \
        die "cannot read installed Pixi path record"
else
    [[ "${USER:-}" =~ ^[A-Za-z0-9._-]+$ ]] || \
        die "remote user name is unsafe"
    pixi_executable="/home/${USER}/.local/bin/pixi"
    if [[ ! -x "$pixi_executable" ]]; then
        pixi_executable="$(command -v pixi || true)"
    fi
    [[ "$pixi_executable" =~ ^/[A-Za-z0-9._/-]+$ && \
       -x "$pixi_executable" ]] || \
        die "Pixi is unavailable for fixed tool bootstrap"
    printf '%s\n' "$pixi_executable" > "$pixi_path"
    chmod 0600 "$pixi_path"
    pixi_path_bootstrap_used=true
fi
[[ "$pixi_executable" =~ ^/[A-Za-z0-9._/-]+$ && \
   -x "$pixi_executable" ]] || die "recorded Pixi executable is unsafe"
pixi_version="$("$pixi_executable" --version 2>&1)" || \
    die "Pixi version check failed"
[[ "$pixi_version" =~ ^pixi[[:space:]]+0\.76\.2$ ]] || \
    die "Pixi 0.76.2 is required"

mkdir -p "$locks"
exec 9>"$locks/deploy-tools.lock"
flock -x 9
staging="$(mktemp -d "$tool_dir/.recover-tools.XXXXXXXX")" || \
    die "cannot create recovery staging directory"
cleanup() {
    chmod -R u+w "$staging" >"$staging/cleanup.log" 2>&1 || true
    rm -rf -- "$staging"
}
trap cleanup EXIT

new_dispatcher="$staging/nf-gtd-hpc-remote"
new_job="$staging/nf-gtd-hpc-smoke-job"
previous_dispatcher="$staging/previous-nf-gtd-hpc-remote"
previous_job="$staging/previous-nf-gtd-hpc-smoke-job"
record="$staging/deployed-tools.json"
extra_payload="$staging/extra-payload"

head -c "$dispatcher_size" >"$new_dispatcher" || \
    die "cannot read dispatcher payload"
[[ "$(wc -c <"$new_dispatcher")" -eq "$dispatcher_size" ]] || \
    die "dispatcher payload is truncated"
head -c "$job_size" >"$new_job" || die "cannot read job payload"
[[ "$(wc -c <"$new_job")" -eq "$job_size" ]] || \
    die "job payload is truncated"
head -c 1 >"$extra_payload" || die "cannot check payload boundary"
[[ ! -s "$extra_payload" ]] || die "recovery payload contains trailing bytes"

actual_dispatcher="$(sha256sum "$new_dispatcher" | awk '{print $1}')"
actual_job="$(sha256sum "$new_job" | awk '{print $1}')"
[[ "$actual_dispatcher" == "$expected_dispatcher" ]] || \
    die "dispatcher checksum differs from local review"
[[ "$actual_job" == "$expected_job" ]] || \
    die "job checksum differs from local review"
bash -n "$new_dispatcher" "$new_job" || die "new tool syntax is invalid"
grep -Fq 'deploy-tools) deploy_tools "$@" ;;' "$new_dispatcher" || \
    die "new dispatcher omits the normal upgrade operation"

if [[ "$bootstrap_used" == false ]]; then
    cp -p -- "$dispatcher" "$previous_dispatcher" || \
        die "cannot preserve the previous dispatcher"
    cp -p -- "$job" "$previous_job" || \
        die "cannot preserve the previous job script"
fi
chmod 0555 "$new_dispatcher" "$new_job"
cat >"$record" <<EOF
{
  "schema_version": "1.0",
  "commit": "$commit",
  "dispatcher_sha256": "$actual_dispatcher",
  "smoke_job_sha256": "$actual_job",
  "deployed_at": "$(date -u '+%Y-%m-%dT%H:%M:%SZ')",
  "recovery_used": true,
  "bootstrap_used": $bootstrap_used,
  "root_bootstrap_used": $root_bootstrap_used,
  "pixi_path_bootstrap_used": $pixi_path_bootstrap_used,
  "pixi_executable": "$pixi_executable"
}
EOF

rollback_tools() {
    if [[ "$bootstrap_used" == true ]]; then
        rm -f -- "$dispatcher" "$job"
    else
        mv -f -- "$previous_job" "$job" >"$staging/rollback.log" 2>&1 || true
        mv -f -- "$previous_dispatcher" "$dispatcher" \
            >>"$staging/rollback.log" 2>&1 || true
    fi
}
if ! mv -f -- "$new_job" "$job" || ! mv -f -- "$new_dispatcher" "$dispatcher"; then
    rollback_tools
    die "atomic tool replacement failed"
fi
if [[ "$(sha256sum "$dispatcher" | awk '{print $1}')" != "$actual_dispatcher" ]] || \
    [[ "$(sha256sum "$job" | awk '{print $1}')" != "$actual_job" ]] || \
    ! mv -f -- "$record" "$tool_dir/deployed-tools.json"; then
    rollback_tools
    die "installed tool verification failed"
fi

printf 'deployed\n'
