run_unknown_screen() {
    local qualification="$RUN/artifacts/qualification"
    local first_trace resume_trace cache_counts total cached
    local legacy_phenix_manifest refreshed_phenix_manifest expected_phenix_sha256
    local mr_inventory directory outcome_name crystal_id count
    local expected_mr_total=0 actual_mr_total=0
    local -a owned_a_packages=()
    local -a crystallographic_holds=()
    local -a expected_review_stages=()
    local -a outcome_ids=()
    local -a expected_ids=()
    UNKNOWN_SCREEN_INPUTS="$RUN/artifacts/unknown-screen/inputs"
    UNKNOWN_SCREEN_DISCOVERY="$RUN/artifacts/unknown-screen/phase3_provider_discovery"
    UNKNOWN_SCREEN_PREPARATION="$RUN/artifacts/unknown-screen/provider_preparation"
    UNKNOWN_SCREEN_OUT="$RUN/artifacts/unknown-screen/results"
    mkdir -p \
        "$qualification" \
        "$UNKNOWN_SCREEN_OUT" \
        "$RUN/cache/unknown-screen-nextflow" \
        "$RUN/execution"
    load_p0_config
    PHENIX_MANIFEST="$(<"$RUN/state/phenix-manifest")"
    CRYSTALS="$UNKNOWN_SCREEN_INPUTS/phase3_crystals.json"
    [[ -d "$UNKNOWN_SCREEN_INPUTS" && ! -L "$UNKNOWN_SCREEN_INPUTS" && \
       -d "$UNKNOWN_SCREEN_INPUTS/localisation_bundle" && \
       -d "$UNKNOWN_SCREEN_DISCOVERY" && ! -L "$UNKNOWN_SCREEN_DISCOVERY" && \
       -d "$UNKNOWN_SCREEN_PREPARATION" && ! -L "$UNKNOWN_SCREEN_PREPARATION" ]] || \
        return 2
    GTD="$RUN/source/.pixi/envs/hpc/bin/genome-to-diffraction"
    NEXTFLOW="$RUN/source/.pixi/envs/hpc/bin/nextflow"
    JAVA_CMD="$RUN/source/.pixi/envs/hpc/lib/jvm/bin/java"
    [[ -x "$GTD" && -x "$NEXTFLOW" && -x "$JAVA_CMD" ]] || return 2
    export PATH="$RUN/source/.pixi/envs/hpc/bin:${PATH:-/usr/bin:/bin}"
    export JAVA_CMD
    export NXF_HOME="$RUN/cache/nextflow-home"
    "$GTD" --no-progress --log-format json \
        structure-search validate-phase3-provider-discovery-package \
        --package "$UNKNOWN_SCREEN_DISCOVERY"
    "$GTD" --no-progress --log-format json \
        structure-search validate-phase3-provider-login-stage \
        --preparation "$UNKNOWN_SCREEN_PREPARATION"
    legacy_phenix_manifest="$PHENIX_MANIFEST"
    expected_phenix_sha256="$(<"$RUN/state/phenix-manifest-sha256")"
    [[ "$expected_phenix_sha256" =~ $CHECKSUM_RE && \
       "$(sha256sum "$legacy_phenix_manifest" | awk '{print $1}')" == \
       "$expected_phenix_sha256" ]] || return 2
    refreshed_phenix_manifest="$qualification/unknown-screen-phenix-manifest.json"
    "$GTD" --log-format json --no-progress phenix verify \
        --manifest "$legacy_phenix_manifest" \
        --verification-log "$qualification/unknown-screen-phenix-verification.log" \
        --no-command-timeout
    cp -- "$legacy_phenix_manifest" "$refreshed_phenix_manifest"
    PHENIX_MANIFEST="$refreshed_phenix_manifest"

    cd "$RUN/execution"
    PHASE=test
    printf 'phase=unknown_screen_first profile=unknown-screen\n'
    run_unknown_screen_nextflow first
    cp -a "$UNKNOWN_SCREEN_OUT/pipeline_info" \
        "$qualification/unknown-screen-first-pipeline-info"
    (
        cd "$UNKNOWN_SCREEN_OUT"
        while IFS= read -r relative; do
            relative="${relative#./}"
            sha256sum "$relative"
        done < <(find . -xdev -type f ! -path './pipeline_info/*' -print | LC_ALL=C sort)
    ) > "$qualification/unknown-screen-before-resume.sha256"
    printf 'phase=unknown_screen_resume profile=unknown-screen\n'
    run_unknown_screen_nextflow resume -resume
    cp -a "$UNKNOWN_SCREEN_OUT/pipeline_info" \
        "$qualification/unknown-screen-resume-pipeline-info"
    (
        cd "$UNKNOWN_SCREEN_OUT"
        while IFS= read -r relative; do
            relative="${relative#./}"
            sha256sum "$relative"
        done < <(find . -xdev -type f ! -path './pipeline_info/*' -print | LC_ALL=C sort)
    ) > "$qualification/unknown-screen-after-resume.sha256"
    cmp -s \
        "$qualification/unknown-screen-before-resume.sha256" \
        "$qualification/unknown-screen-after-resume.sha256" || return 4
    first_trace="$qualification/unknown-screen-first-pipeline-info/trace.tsv"
    resume_trace="$qualification/unknown-screen-resume-pipeline-info/trace.tsv"
    [[ -f "$first_trace" && -f "$resume_trace" ]] || return 4
    mr_inventory="$qualification/unknown-screen-first-mr-inventory.tsv"
    printf 'crystal_id\tinitial_mr_task_count\n' > "$mr_inventory"
    awk -F '\t' '
        NR == 1 {
            for (i = 1; i <= NF; i++) {
                if ($i == "process") process_column = i
                if ($i == "tag") tag_column = i
            }
            next
        }
        process_column > 0 && tag_column > 0 &&
        $process_column ~ /RUN_PHASE3_FIRST_COPY_PHASER$/ {
            parts_count = split($tag_column, parts, ":")
            if (parts_count == 3 && parts[1] == "phase3-first-copy") {
                counts[parts[2]]++
            }
        }
        END {
            for (crystal_id in counts) {
                print crystal_id "\t" counts[crystal_id]
            }
        }
    ' "$first_trace" | LC_ALL=C sort >> "$mr_inventory"
    write_trace_identity_manifest "$first_trace" \
        "$qualification/unknown-screen-first-task-identities.tsv"
    write_trace_identity_manifest "$resume_trace" \
        "$qualification/unknown-screen-resume-task-identities.tsv"
    cmp -s \
        "$qualification/unknown-screen-first-task-identities.tsv" \
        "$qualification/unknown-screen-resume-task-identities.tsv" || return 4
    cache_counts="$(awk -F '\t' '
        NR == 1 {
            for (i = 1; i <= NF; i++) if ($i == "status") status_column = i
            next
        }
        status_column > 0 { total++; if ($status_column == "CACHED") cached++ }
        END { printf "%d %d", total, cached }
    ' "$resume_trace")"
    read -r total cached <<< "$cache_counts"
    [[ "$total" =~ $INTEGER_RE && "$cached" =~ $INTEGER_RE && \
       "$total" -ge 8 && "$cached" -eq "$total" ]] || return 4
    awk -F '\t' '
        NR == 1 {
            for (i = 1; i <= NF; i++) if ($i == "process") process_column = i
            next
        }
        process_column > 0 && $process_column ~ \
            /(RETRIEVE_AFDB_EXACT|REGISTER_PDB_COORDINATES|SEARCH_PDB_SEQUENCES|SEARCH_PHASE3_FOLDSEEK_BATCH)/ {
            forbidden++
        }
        END { exit forbidden == 0 ? 0 : 1 }
    ' "$first_trace" || return 4
    [[ -f "$UNKNOWN_SCREEN_OUT/phase3_offline_provider_input/phase3_offline_provider_input.json" ]] || \
        return 4
    mapfile -d '' -t owned_a_packages < <(
        find "$UNKNOWN_SCREEN_OUT" -maxdepth 1 -type d \
            -name 'phase3_owned_a_review_*' -print0
    )
    mapfile -d '' -t crystallographic_holds < <(
        find "$UNKNOWN_SCREEN_OUT" -maxdepth 1 -type d \
            -name 'phase3_crystallographic_hold_*' -print0
    )
    mapfile -d '' -t expected_review_stages < <(
        find "$UNKNOWN_SCREEN_INPUTS/crystallographic_review_stage/stages" \
            -mindepth 1 -maxdepth 1 -type d -print0
    )
    [[ "$(( ${#owned_a_packages[@]} + ${#crystallographic_holds[@]} ))" -eq 3 && \
       "${#expected_review_stages[@]}" -eq 3 ]] || return 4
    for directory in "${owned_a_packages[@]}"; do
        outcome_name="${directory##*/}"
        outcome_ids+=("${outcome_name#phase3_owned_a_review_}")
    done
    for directory in "${crystallographic_holds[@]}"; do
        outcome_name="${directory##*/}"
        outcome_ids+=("${outcome_name#phase3_crystallographic_hold_}")
    done
    for directory in "${expected_review_stages[@]}"; do
        expected_ids+=("${directory##*/}")
    done
    mapfile -t outcome_ids < <(printf '%s\n' "${outcome_ids[@]}" | LC_ALL=C sort -u)
    mapfile -t expected_ids < <(printf '%s\n' "${expected_ids[@]}" | LC_ALL=C sort -u)
    [[ "${#outcome_ids[@]}" -eq 3 && "${#expected_ids[@]}" -eq 3 && \
       "${outcome_ids[*]}" == "${expected_ids[*]}" ]] || return 4
    for directory in "${owned_a_packages[@]}"; do
        outcome_name="${directory##*/}"
        crystal_id="${outcome_name#phase3_owned_a_review_}"
        count="$(awk -F '\t' -v crystal_id="$crystal_id" \
            'NR > 1 && $1 == crystal_id { print $2 }' "$mr_inventory")"
        [[ "$count" == 25 ]] || return 4
        expected_mr_total=$((expected_mr_total + 25))
    done
    for directory in "${crystallographic_holds[@]}"; do
        outcome_name="${directory##*/}"
        crystal_id="${outcome_name#phase3_crystallographic_hold_}"
        count="$(awk -F '\t' -v crystal_id="$crystal_id" \
            'NR > 1 && $1 == crystal_id { print $2 }' "$mr_inventory")"
        [[ -z "$count" || "$count" == 0 ]] || return 4
    done
    actual_mr_total="$(awk -F '\t' \
        'NR > 1 { total += $2 } END { print total + 0 }' "$mr_inventory")"
    [[ "$actual_mr_total" == "$expected_mr_total" ]] || return 4
    (
        cd "$UNKNOWN_SCREEN_OUT"
        while IFS= read -r relative; do
            relative="${relative#./}"
            sha256sum "$relative"
        done < <(
            find . -xdev -type f \
                ! -path './pipeline_info/*' \
                ! -path './phase3_offline_provider_input/*' \
                -print | LC_ALL=C sort
        )
    ) > "$qualification/unknown-screen-output-checksums.sha256"
    [[ -s "$qualification/unknown-screen-output-checksums.sha256" ]] || return 4
    sha256sum \
        "$UNKNOWN_SCREEN_DISCOVERY/phase3_provider_discovery_manifest.json" \
        "$UNKNOWN_SCREEN_PREPARATION/provider_preparation.json" \
        "$UNKNOWN_SCREEN_INPUTS/localisation_bundle/localisation_batch_manifest.json" \
        "$UNKNOWN_SCREEN_INPUTS/localisation_bundle/first_wave_policy.json" \
        "$UNKNOWN_SCREEN_INPUTS/localisation_bundle/group_localisation_evidence.jsonl" \
        "$UNKNOWN_SCREEN_INPUTS/localisation_bundle/first_wave_sequence_group_ids.txt" \
        "$UNKNOWN_SCREEN_INPUTS/localisation_bundle/excluded_sequence_group_ids.txt" \
        "$UNKNOWN_SCREEN_INPUTS/localisation_bundle/gel-evidence.json" \
        "$UNKNOWN_SCREEN_INPUTS/localisation_bundle/raw/psortb-terse.tsv" \
        "$UNKNOWN_SCREEN_INPUTS/localisation_bundle/raw/deeptmhmm-topologies.3line" \
        "$UNKNOWN_SCREEN_INPUTS/localisation_bundle/container_execution/localisation_container_execution.json" \
        "$UNKNOWN_SCREEN_INPUTS/localisation_bundle/container_execution/psortb-container.log" \
        "$UNKNOWN_SCREEN_INPUTS/localisation_bundle/container_execution/deeptmhmm-container.log" \
        "$PHENIX_MANIFEST" \
        "$UNKNOWN_SCREEN_OUT/phase3_offline_provider_input/phase3_offline_provider_input.json" \
        "$qualification/unknown-screen-before-resume.sha256" \
        "$qualification/unknown-screen-after-resume.sha256" \
        "$qualification/unknown-screen-output-checksums.sha256" \
        "$qualification/unknown-screen-first-task-identities.tsv" \
        "$qualification/unknown-screen-resume-task-identities.tsv" \
        "$mr_inventory" \
        "$first_trace" \
        "$resume_trace" \
        > "$qualification/unknown-screen-checksums.sha256"
    printf 'unknown_screen_status=passed\n'
}

