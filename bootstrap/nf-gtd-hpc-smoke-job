track = sys.argv[2]
output = pathlib.Path(sys.argv[3])
with trace.open(encoding="utf-8", newline="") as handle:
    rows = list(csv.DictReader(handle, delimiter="\t"))
if not rows or any(not row.get("process") or not row.get("status") for row in rows):
    raise SystemExit("M6 first-pass trace is incomplete")


def process_name(row):
    return row["process"].rsplit(":", 1)[-1]


truthless = {"M6_IMPORT_CATALOGUE", "M6_SEARCH_PDB", "M6_SEARCH_FOLDSEEK"}
cached = [row for row in rows if row["status"] == "CACHED"]
completed = [row for row in rows if row["status"] == "COMPLETED"]
if track == "operational":
    if cached or len(completed) != len(rows):
        raise SystemExit("M6 operational first pass reused an unexpected task")
else:
    if (
        not cached
        or any(process_name(row) not in truthless for row in cached)
        or any(
            row["status"] != ("CACHED" if process_name(row) in truthless else "COMPLETED")
            for row in rows
        )
    ):
        raise SystemExit("M6 leakage did not reuse only complete truthless tasks")
output.write_text(
    json.dumps(
        {
            "schema_version": "1.0",
            "track": track,
            "first_task_count": len(rows),
            "truthless_cached_task_count": len(cached),
            "track_specific_completed_task_count": len(completed),
            "cross_track_truthless_cache_reuse": track == "leakage",
            "track_specific_cache_reuse": False,
        },
        indent=2,
        sort_keys=True,
    )
    + "\n",
    encoding="utf-8",
)
PY
    before="$qualification/m6-before-resume.sha256"
    after="$qualification/m6-after-resume.sha256"
    (
        cd "$output"
        sha256sum \
            m6_scientific_summary.json \
            m6_execution_verification.json \
            m6_case_results.jsonl \
            m6_candidate_rankings.jsonl \
            m6_candidate_rankings.jsonl.gz \
            m6_model_policy_results.jsonl \
            m6_first_copy_results.jsonl \
            m6_additional_copy_results.jsonl \
            m6_refinement_results.jsonl \
            m6_sequence_results.jsonl \
            m6_sequence_summary.jsonl
    ) > "$before"
    printf 'phase=m6_nextflow_resume profile=%s track=%s\n' "$PROFILE" "$M6_TRACK"
    run_m6_nextflow resume -resume
    cp -a "$M6_RESULTS_ROOT/pipeline_info" \
        "$qualification/m6-resume-pipeline-info"
    cache_counts="$(awk -F '\t' '
        NR == 1 { for (i = 1; i <= NF; i++) if ($i == "status") column = i; next }
        column > 0 { total++; if ($column == "CACHED") cached++ }
        END { printf "%d %d", total, cached }
    ' "$qualification/m6-resume-pipeline-info/trace.tsv")"
    read -r total cached <<< "$cache_counts"
    expected="$(awk 'NR > 1 && NF { count++ } END { print count + 0 }' \
        "$qualification/m6-first-pipeline-info/trace.tsv")"
    [[ "$expected" -gt 0 && "$total" -eq "$expected" && \
       "$cached" -eq "$expected" ]] || return 4
    "$GTD" --log-format json --no-progress benchmark collect-m6-child-outputs \
        --track "$M6_TRACK" \
        --trace "$qualification/m6-resume-pipeline-info/trace.tsv" \
        --baseline "$qualification/m6-first-child-outputs.json" \
        --output "$qualification/m6-resume-child-outputs.json"
    cat > "$qualification/m6-resume-cache-evidence.json" <<EOF
{
  "schema_version": "1.0",
  "cache_mechanism": "nextflow_resume",
  "first_task_count": $expected,
  "cached_resume_task_count": $cached,
  "first_child_output_sha256": "$(sha256sum "$qualification/m6-first-child-outputs.json" | awk '{print $1}')",
  "resume_child_output_sha256": "$(sha256sum "$qualification/m6-resume-child-outputs.json" | awk '{print $1}')",
  "fully_cached_resume": true
}
EOF
    (
        cd "$output"
        sha256sum \
            m6_scientific_summary.json \
            m6_execution_verification.json \
            m6_case_results.jsonl \
            m6_candidate_rankings.jsonl \
            m6_candidate_rankings.jsonl.gz \
            m6_model_policy_results.jsonl \
            m6_first_copy_results.jsonl \
            m6_additional_copy_results.jsonl \
            m6_refinement_results.jsonl \
            m6_sequence_results.jsonl \
            m6_sequence_summary.jsonl
    ) > "$after"
    cmp -s "$before" "$after" || return 3
    replay_digest="$(sha256sum "$before" | awk '{print $1}')"
    read -r child_jobs peak_jobs peak_cpu peak_memory peak_phenix < <(
        "$RUN/source/.pixi/envs/hpc/bin/python" - \
            "$qualification/m6-child-resource-evidence.json" <<'PY'
import json, pathlib, sys
record = json.loads(pathlib.Path(sys.argv[1]).read_text())
print(
    record["child_job_count"],
    record["peak_running_jobs"],
    record["peak_aggregate_cpus"],
    record["peak_aggregate_memory_gb"],
    record["peak_concurrent_phenix_jobs"],
)
PY
    )
    cat > "$qualification/m6-resume-check.json" <<EOF
{
  "schema_version": "1.0",
  "track": "$M6_TRACK",
  "deterministic_replay_equivalent": true,
  "resume_equivalent": true,
  "first_task_count": $expected,
  "cached_resume_task_count": $cached,
  "output_inventory_sha256": "$replay_digest"
}
EOF
    cat > "$qualification/m6-runtime-provenance.json" <<EOF
{
  "schema_version": "1.1",
  "profile": "$PROFILE",
  "track": "$M6_TRACK",
  "execution_model": "nextflow_dsl2_slurm_fanout",
  "maximum_cpu_count": 32,
  "maximum_memory_gb": 16.0,
  "maximum_concurrent_phenix_attempts": $peak_phenix,
  "scheduler_ceiling_hours": 24.0,
  "tool_runtime_timeouts": false,
  "child_job_count": $child_jobs,
  "peak_running_jobs": $peak_jobs,
  "peak_aggregate_cpu_count": $peak_cpu,
  "peak_aggregate_memory_gb": $peak_memory,
  "execution_policy": "$M6_EXECUTION_POLICY_ID"
}
EOF
    cp "$output/m6_scientific_summary.json" \
        "$qualification/m6-scientific-summary.json"
    cp "$output/m6_execution_verification.json" \
        "$qualification/m6-execution-verification.json"
    cp "$output/m6_case_results.jsonl" \
        "$qualification/m6-case-results.jsonl"
    cp "$output/m6_candidate_rankings.jsonl.gz" \
        "$qualification/m6-candidate-rankings.jsonl.gz"
    cp "$output/m6_model_policy_results.jsonl" \
        "$qualification/m6-model-policy-results.jsonl"
    cp "$output/m6_sequence_summary.jsonl" \
        "$qualification/m6-sequence-summary.jsonl"

    log_count="$(find "$output" -type f \( -name PHASER.log -o -name phaser.log \) \
        -print | wc -l | awk '{print $1}')"
    printf 'total_phaser_logs=%s included_log_tails_max=64 lines_per_tail=50\n' \
        "$log_count" > "$qualification/m6-phaser-log-tails.txt"
    while IFS= read -r -d '' log; do
        (( included < 64 )) || break
        relative="${log#"$output/"}"
        printf '===== %s =====\n' "$relative" \
            >> "$qualification/m6-phaser-log-tails.txt"
        tail -n 50 "$log" >> "$qualification/m6-phaser-log-tails.txt"
        included=$((included + 1))
    done < <(find "$output" -type f \( -name PHASER.log -o -name phaser.log \) \
        -print0 | sort -z)
    sha256sum \
        "$qualification/m6-scientific-summary.json" \
        "$qualification/m6-execution-verification.json" \
        "$qualification/m6-case-results.jsonl" \
        "$qualification/m6-candidate-rankings.jsonl.gz" \
        "$qualification/m6-model-policy-results.jsonl" \
        "$qualification/m6-sequence-summary.jsonl" \
        "$qualification/m6-resume-check.json" \
        "$qualification/m6-runtime-provenance.json" \
        "$qualification/m6-child-resource-evidence.json" \
        "$qualification/m6-cross-track-cache-evidence.json" \
        "$qualification/m6-resume-cache-evidence.json" \
        "$qualification/m6-first-child-outputs.json" \
        "$qualification/m6-resume-child-outputs.json" \
        "$qualification/m6-phenix-verification.log" \
        "$qualification/m6-phaser-log-tails.txt" \
        "$M6_PHENIX_MANIFEST" \
        "$M6_DATABASE_MANIFEST" \
        "$M6_IMPORT_ROOT/runner_manifest.json" \
        > "$qualification/m6-scientific-checksums.sha256"
    rm -f -- "$before" "$after"
    printf 'm6_scientific_status=complete track=%s\n' "$M6_TRACK"
}

