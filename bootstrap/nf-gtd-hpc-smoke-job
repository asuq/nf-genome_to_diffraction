import json
import pathlib
import re
import sys

eligible = {
    "M6_IMPORT_CATALOGUE",
    "M6_SEARCH_PDB",
    "M6_SEARCH_FOLDSEEK",
}
pattern = re.compile(r"Stored process > .*:(M6_[A-Z_]+)(?: \(([0-9]+)\))?")


def stored(path: pathlib.Path) -> dict[str, int]:
    records: dict[str, int] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        match = pattern.search(line)
        if match is None:
            continue
        process = match.group(1)
        records[process] = records.get(process, 0) + int(match.group(2) or 1)
    unexpected = set(records) - eligible
    if unexpected:
        raise SystemExit(f"track-specific M6 store reuse detected: {sorted(unexpected)}")
    return dict(sorted(records.items()))


first = stored(pathlib.Path(sys.argv[1]))
resume = stored(pathlib.Path(sys.argv[2]))
if set(resume) != eligible:
    raise SystemExit("M6 resume did not reuse every truthless shared-store stage")
pathlib.Path(sys.argv[3]).write_text(
    json.dumps(
        {
            "schema_version": "1.0",
            "eligible_processes": sorted(eligible),
            "first_run_reuse": first,
            "resume_reuse": resume,
            "truthless_only": True,
            "track_specific_reuse": False,
        },
        indent=2,
        sort_keys=True,
    )
    + "\n",
    encoding="utf-8",
)
PY
