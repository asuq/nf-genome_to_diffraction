#!/usr/bin/env bash
# Fixed Slurm job body for the reviewed multi-site profiles, including
# separately gated database-administration profiles.

set -euo pipefail
umask 077

RUN_ID_RE='^gtd-(smoke|p0|p1|p2-diverse|p2-control|p2|heteromer-smoke|phase3-phenix-probe|phase3-network-probe|unknown-discovery|unknown-screen|unknown-single-component|unknown-pass2|control-slice|control-matrix|m6-inputs|m6-nextflow-smoke|m6-operational|m6-leakage|m4-copy|t12|database)-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}-[0-9a-f]{8}$'
PROFILE_RE='^(smoke|p0|p1|p2-diverse|p2-control|p2|heteromer-smoke|phase3-phenix-probe|phase3-network-probe|unknown-discovery|unknown-screen|unknown-single-component|unknown-pass2|control-slice|control-matrix|m6-inputs|m6-nextflow-smoke|m6-operational|m6-leakage|m4-copy|t12|database)$'
CHECKSUM_RE='^[0-9a-f]{64}$'
INTEGER_RE='^[0-9]+$'
BYTE_COUNT_RE='^(0|[1-9][0-9]*)$'
SAFE_PATH_RE='^/[A-Za-z0-9._/-]+$'

# Slurm executes a spooled copy, so $0 no longer identifies _tooling. The fixed
# dispatcher derives the trusted run root and passes it explicitly.
RUN_ID="${1-}"
ROOT="${2-}"
PROFILE="${3-}"
[[ "$RUN_ID" =~ $RUN_ID_RE ]] || { printf 'invalid managed run ID\n' >&2; exit 2; }
[[ "$PROFILE" =~ $PROFILE_RE ]] || { printf 'invalid fixed profile\n' >&2; exit 2; }
[[ "$RUN_ID" == "gtd-${PROFILE}-"* ]] || {
    printf 'run ID does not match the fixed profile\n' >&2
    exit 2
}
[[ "${SLURM_JOB_ID:-}" =~ $INTEGER_RE ]] || {
    printf 'missing Slurm job ID\n' >&2
    exit 2
}
if [[ "$PROFILE" == database ]]; then
    if [[ "${SLURM_CPUS_PER_TASK:-}" != 4 ]]; then
        printf 'database build job requires exactly 4 allocated CPUs\n' >&2
        exit 2
    fi
fi
if [[ "$PROFILE" == heteromer-smoke && "${SLURM_CPUS_PER_TASK:-}" != 8 ]]; then
    printf 'heteromer smoke requires exactly 8 allocated CPUs\n' >&2
    exit 2
fi
if [[ ( "$PROFILE" == unknown-discovery || \
        "$PROFILE" == unknown-screen || \
        "$PROFILE" == unknown-single-component || \
        "$PROFILE" == unknown-pass2 ) && \
      "${SLURM_CPUS_PER_TASK:-}" != 8 ]]; then
    printf 'Phase III unknown profile requires exactly 8 allocated CPUs\n' >&2
    exit 2
fi
[[ "$ROOT" =~ $SAFE_PATH_RE && -d "$ROOT/runs" && -d "$ROOT/_locks" ]] || {
    printf 'invalid managed run root\n' >&2
    exit 2
}
RUN="$ROOT/runs/$RUN_ID"
[[ -d "$RUN/source" && -d "$RUN/state" && -d "$RUN/logs" ]] || {
    printf 'managed run is incomplete\n' >&2
    exit 2
}
RESOLVED_ROOT="$(cd "$ROOT" && pwd -P)"
if [[ "$RESOLVED_ROOT" != "$ROOT" ]]; then
    [[ -f "$RUN/state/site-id" && ! -L "$RUN/state/site-id" && \
        "$(<"$RUN/state/site-id")" == viper-cpu ]] || {
        printf 'managed run root is a non-Viper noncanonical path\n' >&2
        exit 2
    }
    # Viper presents /ptmp through a site mount alias whose physical backing
    # path differs on compute nodes. Keep the reviewed lexical root so all
    # recorded paths remain site-stable; the owned immutable run anchors it.
fi
[[ "$(<"$RUN/state/profile")" == "$PROFILE" ]] || {
    printf 'recorded profile does not match the job request\n' >&2
    exit 2
}
PIXI_BIN="$(<"$RUN/state/pixi-bin")"
[[ "$PIXI_BIN" =~ $SAFE_PATH_RE && -x "$PIXI_BIN" ]] || {
    printf 'recorded Pixi executable is invalid\n' >&2
    exit 2
}

SCRATCH_PARENT=""
SCRATCH_PARENT_CLEANUP=""
SCRATCH=""
SOURCE=""
M6_SITE_ID=""
M6_NEXTFLOW_PROFILE=""
M6_EXECUTION_POLICY=""
M6_EXECUTION_POLICY_ID=""
M6_EXECUTION_POLICY_SHA256=""
M6_APPTAINER_CACHE=""
M6_SMOKE_CACHE=""
M6_SMOKE_EXECUTION=""
M6_CACHE_ROOT=""
if [[ "$PROFILE" != database ]]; then
    SCRATCH_PARENT="${ROOT%/}/work"
    [[ "$SCRATCH_PARENT" =~ $SAFE_PATH_RE ]] || {
        printf 'Slurm scratch parent is not a safe absolute path\n' >&2
        exit 2
    }
    SCRATCH="${SCRATCH_PARENT%/}/nf-gtd-${SLURM_JOB_ID}-${RUN_ID}"
    SOURCE="$SCRATCH/source"
fi
STARTED_AT="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
PHASE=environment

atomic_text() {
    local path="$1"
    local value="$2"
    local temporary="${path}.tmp.$$"
    printf '%s\n' "$value" > "$temporary"
    mv -f -- "$temporary" "$path"
}

finalise() {
    local exit_code="$?"
    local failure_class scheduler_state ended_at result_tmp active_run="" active_job=""
    local active_lock=""
    local cleanup_failed=false reports_json='[]' retained_json='[]'
    trap - EXIT TERM INT
    set +e
    if (( exit_code == 0 )); then
        failure_class=success
        scheduler_state=COMPLETED
    elif [[ "$PHASE" == cancelled ]]; then
        failure_class=unknown_failure
        scheduler_state=CANCELLED
    elif [[ "$PHASE" == environment || "$PHASE" == preflight ]]; then
        failure_class=environment_failure
        scheduler_state=FAILED
    elif [[ "$PHASE" == test ]]; then
        failure_class=test_failure
        scheduler_state=FAILED
    else
        failure_class=software_failure
        scheduler_state=FAILED
    fi
    if [[ "$PROFILE" == database ]]; then
        exec 9>"$ROOT/_locks/submit.lock"
        flock -x 9
        active_lock="$ROOT/_locks/active-database"
        if [[ -f "$active_lock" ]]; then
            read -r active_run active_job < "$active_lock" || true
            if [[ "$active_run" == "$RUN_ID" && \
                  "$active_job" == "$SLURM_JOB_ID" ]]; then
                rm -f -- "$active_lock"
            fi
        fi
    fi
    if [[ -n "$SCRATCH" && -e "$SCRATCH" ]]; then
        chmod -R u+w "$SCRATCH" 2>>"$RUN/logs/cleanup-diagnostics.log" || true
        rm -rf -- "$SCRATCH"
        [[ ! -e "$SCRATCH" ]] || cleanup_failed=true
    fi
    if [[ -n "$SCRATCH_PARENT_CLEANUP" && -e "$SCRATCH_PARENT_CLEANUP" ]]; then
        rmdir -- "$SCRATCH_PARENT_CLEANUP" \
            2>>"$RUN/logs/cleanup-diagnostics.log" || cleanup_failed=true
    fi
    if [[ "$cleanup_failed" == true ]]; then
        printf 'scratch_cleanup_status=failed\n' >&2
        if (( exit_code == 0 )); then
            exit_code=6
            failure_class=filesystem_failure
            scheduler_state=FAILED
        fi
    else
        printf 'scratch_cleanup_status=success\n'
    fi
    if [[ "$PROFILE" == p0 ]]; then
        reports_json='["artifacts/qualification/resume-check.json"]'
        retained_json='["artifacts/p0","artifacts/qualification"]'
    elif [[ "$PROFILE" == p1 ]]; then
        reports_json='["artifacts/qualification/p1-qualification.json"]'
        retained_json='["artifacts/p1","artifacts/qualification"]'
    elif [[ "$PROFILE" == p2 ]]; then
        reports_json='["artifacts/qualification/p2-first-copy-result.json","artifacts/qualification/p2-first-copy-resume-check.json"]'
        retained_json='["artifacts/p0","artifacts/p1","artifacts/p2","artifacts/qualification"]'
    elif [[ "$PROFILE" == p2-diverse ]]; then
        reports_json='["artifacts/qualification/p2-diverse-summary.json","artifacts/qualification/p2-diverse-first-copy-resume-check.json"]'
        retained_json='["artifacts/p0","artifacts/p1","artifacts/p2-diverse","artifacts/qualification"]'
    elif [[ "$PROFILE" == p2-control ]]; then
        reports_json='["artifacts/qualification/p2-control-summary.json","artifacts/qualification/p2-control-resume-check.json"]'
        retained_json='["artifacts/p2-control","artifacts/qualification"]'
    elif [[ "$PROFILE" == heteromer-smoke ]]; then
        reports_json='["artifacts/qualification/heteromer-smoke-summary.json","artifacts/qualification/heteromer-multicopy-summary.json","artifacts/qualification/heteromer-catalogue-summary.json","artifacts/qualification/heteromer-control-slice-report.json","artifacts/qualification/heteromer-composition-assessments.jsonl","artifacts/qualification/phase3-placement-control-summary.json","artifacts/heteromer-smoke/phase3-control/phase3-9ecn-control-summary.json","artifacts/heteromer-smoke/phase3-control/component_C/component_search_result.json","artifacts/heteromer-smoke/phase3-control/component_C/phaser_per_placement_inventory.json","artifacts/heteromer-smoke/phase3-control/wrong_C/component_search_result.json","artifacts/heteromer-smoke/partner/partner_search_result.json","artifacts/heteromer-smoke/partner/phaser_per_placement_inventory.json","artifacts/heteromer-smoke/multicopy/partner/partner_search_result.json","artifacts/heteromer-smoke/multicopy/partner/phaser_per_placement_inventory.json","artifacts/heteromer-smoke/catalogue/partner/partner_search_result.json","artifacts/heteromer-smoke/catalogue/partner_attempt_summary.json"]'
        retained_json='["artifacts/heteromer-smoke","artifacts/qualification"]'
    elif [[ "$PROFILE" == phase3-phenix-probe ]]; then
        reports_json='["artifacts/qualification/phaser-interface-probe.json"]'
        retained_json='["artifacts/qualification"]'
    elif [[ "$PROFILE" == phase3-network-probe ]]; then
        reports_json='["artifacts/qualification/phase3-network-probe-summary.json","artifacts/qualification/network-probe/phase3-network-probe-child.json","artifacts/qualification/network-probe/phase3-network-probe-controller.json"]'
        retained_json='["artifacts/qualification"]'
    elif [[ "$PROFILE" == unknown-discovery ]]; then
        reports_json='["artifacts/unknown-discovery/results/phase3_provider_discovery/phase3_provider_discovery_manifest.json"]'
        retained_json='["artifacts/unknown-discovery","artifacts/qualification"]'
    elif [[ "$PROFILE" == unknown-screen ]]; then
        reports_json='["artifacts/unknown-screen/provider_preparation/provider_preparation.json","artifacts/unknown-screen/results/phase3_offline_provider_input/phase3_offline_provider_input.json"]'
        retained_json='["artifacts/unknown-screen","artifacts/qualification"]'
    elif [[ "$PROFILE" == unknown-single-component ]]; then
        reports_json='["artifacts/unknown-single-component/unknown_single_component_stage_manifest.json","artifacts/unknown-single-component/reviewed_crystals.json","artifacts/unknown-single-component/owned_run_registry/phase3_owned_run_registry.json"]'
        retained_json='["artifacts/unknown-single-component","artifacts/qualification"]'
    elif [[ "$PROFILE" == unknown-pass2 ]]; then
        reports_json='["artifacts/qualification/unknown-pass2-summary.json","artifacts/qualification/unknown-pass2-checksums.sha256"]'
        retained_json='["artifacts/unknown-pass2","artifacts/qualification"]'
    elif [[ "$PROFILE" == control-slice ]]; then
        reports_json='["artifacts/qualification/control-slice-summary.json","artifacts/qualification/control-slice-case-results.jsonl","artifacts/qualification/control-slice-first-copy-results.jsonl","artifacts/qualification/control-slice-copy-two-results.jsonl","artifacts/qualification/control-slice-refinement-results.jsonl","artifacts/qualification/control-slice-sequence-results.jsonl"]'
        retained_json='["artifacts/control-slice-inputs","artifacts/control-slice","artifacts/qualification"]'
    elif [[ "$PROFILE" == control-matrix ]]; then
        reports_json='["artifacts/qualification/control-matrix-summary.json","artifacts/qualification/control-matrix-case-results.jsonl","artifacts/qualification/control-matrix-first-copy-results.jsonl","artifacts/qualification/control-matrix-additional-copy-results.jsonl","artifacts/qualification/control-matrix-refinement-results.jsonl","artifacts/qualification/control-matrix-sequence-results.jsonl"]'
        retained_json='["artifacts/control-matrix-inputs","artifacts/control-matrix","artifacts/qualification"]'
    elif [[ "$PROFILE" == m6-inputs ]]; then
        reports_json='["artifacts/qualification/m6-input-qualification.json"]'
        retained_json='["artifacts/m6-runner-inputs","artifacts/qualification"]'
    elif [[ "$PROFILE" == m6-nextflow-smoke ]]; then
        reports_json='["artifacts/qualification/m6-nextflow-smoke-summary.json","artifacts/qualification/m6-nextflow-smoke-resume-check.json","artifacts/qualification/m6-nextflow-smoke-resource-evidence.json","artifacts/qualification/m6-nextflow-smoke-contract-evidence.json"]'
        retained_json='["artifacts/m6-nextflow-smoke","artifacts/qualification"]'
    elif [[ "$PROFILE" == m6-operational || "$PROFILE" == m6-leakage ]]; then
        reports_json='["artifacts/qualification/m6-scientific-summary.json","artifacts/qualification/m6-execution-verification.json","artifacts/qualification/m6-resume-check.json","artifacts/qualification/m6-runtime-provenance.json","artifacts/qualification/m6-resume-child-outputs.json"]'
        retained_json='["artifacts/m6-runner-inputs","artifacts/m6-nextflow-results","artifacts/qualification"]'
    elif [[ "$PROFILE" == m4-copy ]]; then
        reports_json='["artifacts/qualification/m4-copy-summary.json","artifacts/qualification/m4-copy-resume-check.json"]'
        retained_json='["artifacts/m4-copy-inputs","artifacts/m4-copy","artifacts/qualification"]'
    elif [[ "$PROFILE" == t12 ]]; then
        reports_json='["artifacts/qualification/t12-summary.json","artifacts/qualification/t12-resume-check.json"]'
        retained_json='["artifacts/t12-inputs","artifacts/t12","artifacts/qualification"]'
    elif [[ "$PROFILE" == database ]]; then
        reports_json='["artifacts/database/preflight.json"]'
        retained_json='["artifacts/database"]'
    fi
    ended_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    atomic_text "$RUN/state/exit-code" "$exit_code"
    atomic_text "$RUN/state/failure-class" "$failure_class"
    atomic_text "$RUN/state/phase" "completed"
    result_tmp="$RUN/state/job-result.json.tmp.$$"
    cat > "$result_tmp" <<EOF
{
  "schema_version": "1.0",
  "run_id": "$RUN_ID",
  "profile": "$PROFILE",
  "job_id": "$SLURM_JOB_ID",
  "started_at": "$STARTED_AT",
  "completed_at": "$ended_at",
  "scheduler_state": "$scheduler_state",
  "exit_code": $exit_code,
  "failure_class": "$failure_class",
  "standard_output": "logs/slurm-${SLURM_JOB_ID}.out",
  "standard_error": "logs/slurm-${SLURM_JOB_ID}.out",
  "application_log": "logs/${PROFILE}.log",
  "structured_test_reports": $reports_json,
  "retained_artifacts": $retained_json
}
EOF
    mv -f -- "$result_tmp" "$RUN/state/job-result.json"
    printf '{"event":"job_completed","profile":"%s","timestamp":"%s"}\n' \
        "$PROFILE" "$ended_at" >> "$RUN/events.jsonl"
    exit "$exit_code"
}

handle_signal() {
    local exit_code="$1"
    local signal_name="$2"
    PHASE=cancelled
    printf 'received_signal=%s\n' "$signal_name" >&2
    exit "$exit_code"
}

path_within_root() {
    local root="$1"
    local path="$2"
    [[ "$path" == "$root"/* ]]
}

write_trace_identity_manifest() {
    local trace="$1"
    local output="$2"
    awk -F '\t' '
        NR == 1 {
            for (i = 1; i <= NF; i++) {
                if ($i == "hash") hash_column = i
                if ($i == "process") process_column = i
                if ($i == "tag") tag_column = i
            }
            if (hash_column == 0 || process_column == 0 || tag_column == 0) exit 2
            next
        }
        { print $process_column "\t" $tag_column "\t" $hash_column }
    ' "$trace" | LC_ALL=C sort > "$output"
    [[ -s "$output" ]]
}

site_resolved_path() {
    local candidate="$1"
    local resolved suffix
    resolved="$(realpath -e "$candidate")" || return 1
    if [[ "$resolved" == "$candidate" ]]; then
        printf '%s\n' "$resolved"
        return 0
    fi
    [[ "$(<"$RUN/state/site-id")" == viper-cpu && \
        ( "$candidate" == "$ROOT" || "$candidate" == "$ROOT"/* ) ]] || return 1
    suffix="${candidate#"$ROOT"}"
    [[ "$resolved" == "$RESOLVED_ROOT$suffix" ]] || return 1
    printf '%s\n' "$resolved"
}

load_p0_config() {
    local config="$ROOT/_config/p0.paths"
    local expected actual allowed candidate resolved index
    local -a values=()
    [[ -f "$config" && ! -L "$config" && -O "$config" ]] || {
        printf 'fixed P0 configuration is absent or unsafe\n' >&2
        return 1
    }
    [[ "$(stat -c '%a' "$config")" == 600 ]] || {
        printf 'fixed P0 configuration must have mode 0600\n' >&2
        return 1
    }
    expected="$(<"$RUN/state/p0-config-sha256")"
    [[ "$expected" =~ $CHECKSUM_RE ]] || {
        printf 'recorded P0 configuration checksum is invalid\n' >&2
        return 1
    }
    actual="$(sha256sum "$config" | awk '{print $1}')"
    [[ "$actual" == "$expected" ]] || {
        printf 'P0 configuration changed after staging\n' >&2
        return 1
    }
    mapfile -t values < "$config"
    [[ "${#values[@]}" -eq 7 ]] || {
        printf 'P0 configuration must contain exactly seven path lines\n' >&2
        return 1
    }
    for candidate in "${values[@]}"; do
        [[ "$candidate" =~ $SAFE_PATH_RE ]] || {
            printf 'P0 configuration contains an unsafe path\n' >&2
            return 1
        }
    done
    allowed="$(realpath -e "${values[0]}")"
    [[ "$allowed" == "${values[0]}" && -d "$allowed" && \
        ! -L "${values[0]}" && -O "${values[0]}" ]] || {
        printf 'P0 allowed root must be a canonical regular directory\n' >&2
        return 1
    }
    [[ "$allowed" != / && "$allowed" != "${HOME:-}" ]] || {
        printf 'P0 allowed root is too broad\n' >&2
        return 1
    }
    for index in 1 2 3 5 6; do
        candidate="${values[$index]}"
        resolved="$(realpath -e "$candidate")"
        [[ "$resolved" == "$candidate" ]] || {
            printf 'P0 file path is not canonical: %s\n' "$candidate" >&2
            return 1
        }
        path_within_root "$allowed" "$resolved" || {
            printf 'P0 file escaped the configured allowed root\n' >&2
            return 1
        }
        [[ -f "$resolved" && ! -L "$candidate" ]] || {
            printf 'P0 input is not a regular file: %s\n' "$candidate" >&2
            return 1
        }
    done
    candidate="${values[4]}"
    resolved="$(realpath -e "$candidate")"
    [[ "$resolved" == "$candidate" ]] || {
        printf 'P0 database root is not canonical\n' >&2
        return 1
    }
    path_within_root "$allowed" "$resolved" || {
        printf 'P0 database root escaped the configured allowed root\n' >&2
        return 1
    }
    [[ -d "$resolved" && ! -L "$candidate" ]] || {
        printf 'P0 database root is not a regular directory\n' >&2
        return 1
    }

    P0_ALLOWED_ROOT="$allowed"
    CATALOGUES="${values[1]}"
    CRYSTALS="${values[2]}"
    PIPELINE_CONFIG="${values[3]}"
    DATABASE_ROOT="${values[4]}"
    EXPECTED_DATABASE_MANIFEST="${values[5]}"
    PHENIX_MANIFEST="${values[6]}"
    P0_CONFIG_PATH="$config"
}

load_database_config() {
    local config="$ROOT/_config/database.paths"
    local expected actual allowed candidate resolved manifest_parent
    local -a values=()
    [[ -f "$config" && ! -L "$config" && -O "$config" ]] || {
        printf 'fixed database configuration is absent or unsafe\n' >&2
        return 1
    }
    [[ "$(stat -c '%a' "$config")" == 600 ]] || {
        printf 'fixed database configuration must have mode 0600\n' >&2
        return 1
    }
    expected="$(<"$RUN/state/database-config-sha256")"
    [[ "$expected" =~ $CHECKSUM_RE ]] || {
        printf 'recorded database configuration checksum is invalid\n' >&2
        return 1
    }
    actual="$(sha256sum "$config" | awk '{print $1}')"
    [[ "$actual" == "$expected" ]] || {
        printf 'database configuration changed after staging\n' >&2
        return 1
    }
    mapfile -t values < "$config"
    [[ "${#values[@]}" -eq 7 ]] || {
        printf 'database configuration must contain exactly seven lines\n' >&2
        return 1
    }
    for candidate in "${values[0]}" "${values[1]}" "${values[2]}"; do
        [[ "$candidate" =~ $SAFE_PATH_RE ]] || {
            printf 'database configuration contains an unsafe path\n' >&2
            return 1
        }
    done
    for candidate in "${values[3]}" "${values[4]}" "${values[5]}" "${values[6]}"; do
        [[ "$candidate" =~ $BYTE_COUNT_RE && "${#candidate}" -le 13 ]] || {
            printf 'database configuration contains an invalid byte count\n' >&2
            return 1
        }
    done
    resolved="$(site_resolved_path "${values[0]}")" || {
        printf 'database allowed root is invalid\n' >&2
        return 1
    }
    allowed="${values[0]}"
    [[ -d "$resolved" && ! -L "$allowed" ]] || {
        printf 'database allowed root is invalid\n' >&2
        return 1
    }
    [[ "$allowed" != / && "$allowed" != "${HOME:-}" ]] || {
        printf 'database allowed root is too broad\n' >&2
        return 1
    }
    resolved="$(site_resolved_path "${values[1]}")" || {
        printf 'database root is invalid\n' >&2
        return 1
    }
    [[ -d "$resolved" && ! -L "${values[1]}" && -O "${values[1]}" ]] || {
        printf 'database root is invalid\n' >&2
        return 1
    }
    path_within_root "$allowed" "${values[1]}" || {
        printf 'database root escaped the allowed root\n' >&2
        return 1
    }
    [[ ! -e "${values[2]}" && ! -L "${values[2]}" ]] || {
        printf 'immutable database manifest output already exists\n' >&2
        return 1
    }
    manifest_parent="$(dirname "${values[2]}")"
    resolved="$(site_resolved_path "$manifest_parent")" || {
        printf 'database manifest parent is invalid\n' >&2
        return 1
    }
    [[ -d "$resolved" && ! -L "$manifest_parent" && -O "$manifest_parent" ]] || {
        printf 'database manifest parent is invalid\n' >&2
        return 1
    }
    path_within_root "$allowed" "${values[2]}" || {
        printf 'database manifest escaped the allowed root\n' >&2
        return 1
    }
    (( values[3] > 0 && values[3] <= 2000000000000 )) || {
        printf 'database storage cap is outside the fixed 2 TB boundary\n' >&2
        return 1
    }
    (( values[4] >= 0 && values[4] < values[3] )) || {
        printf 'database free-space headroom is invalid\n' >&2
        return 1
    }
    (( values[5] > 0 && values[5] <= values[3] )) || {
        printf 'required database capacity is invalid\n' >&2
        return 1
    }
    (( values[6] > 0 )) || {
        printf 'required scratch headroom is invalid\n' >&2
        return 1
    }

    DATABASE_ALLOWED_ROOT="$allowed"
    DATABASE_ROOT="${values[1]}"
    DATABASE_MANIFEST="${values[2]}"
    STORAGE_LIMIT_BYTES="${values[3]}"
    MINIMUM_FREE_BYTES="${values[4]}"
    REQUIRED_DATABASE_CAPACITY_BYTES="${values[5]}"
    MINIMUM_SCRATCH_FREE_BYTES="${values[6]}"
}

run_smoke() {
    mkdir -p "$SOURCE"
    cp -a "$RUN/source/." "$SOURCE/"
    chmod -R u+w "$SOURCE"
    [[ "$(git -C "$SOURCE" rev-parse HEAD)" == "$(<"$RUN/state/commit")" ]] || {
        printf 'scratch checkout commit mismatch\n' >&2
        return 2
    }
    cd "$SOURCE"
    printf 'phase=pixi_install profile=smoke\n'
    "$PIXI_BIN" install --environment default --frozen

    PHASE=test
    printf 'phase=foundation_check profile=smoke\n'
    "$PIXI_BIN" run --environment default check

    PHASE=software
    if [[ -n "$(git status --porcelain=v1 --untracked-files=no)" ]]; then
        printf 'foundation check modified tracked source files\n' >&2
        return 3
    fi
    printf 'smoke_status=success\n'
}

run_p0_nextflow() {
    local label="$1"
    shift
    "$NEXTFLOW" \
