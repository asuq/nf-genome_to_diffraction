#!/usr/bin/env bash
# Fixed Slurm job body for the reviewed smoke, P0, P1, P2, and separately gated
# database-administration profiles.

set -euo pipefail
umask 077

RUN_ID_RE='^gtd-(smoke|p0|p1|p2|database)-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}-[0-9a-f]{8}$'
PROFILE_RE='^(smoke|p0|p1|p2|database)$'
CHECKSUM_RE='^[0-9a-f]{64}$'
INTEGER_RE='^[0-9]+$'
BYTE_COUNT_RE='^(0|[1-9][0-9]*)$'
SAFE_PATH_RE='^/[A-Za-z0-9._/-]+$'
DATABASE_SCRATCH_ROOT='/dev/shm'

# Slurm executes a spooled copy, so $0 no longer identifies _tooling. The fixed
# dispatcher derives the trusted run root and passes it explicitly.
RUN_ID="${1-}"
ROOT="${2-}"
PROFILE="${3-}"
[[ "$RUN_ID" =~ $RUN_ID_RE ]] || { printf 'invalid managed run ID\n' >&2; exit 2; }
[[ "$PROFILE" =~ $PROFILE_RE ]] || { printf 'invalid fixed profile\n' >&2; exit 2; }
[[ "$RUN_ID" == "gtd-${PROFILE}-"* ]] || {
    printf 'run ID does not match the fixed profile\n' >&2
    exit 2
}
[[ "${SLURM_JOB_ID:-}" =~ $INTEGER_RE ]] || {
    printf 'missing Slurm job ID\n' >&2
    exit 2
}
if [[ "$PROFILE" == database && "${SLURM_CPUS_PER_TASK:-}" != 100 ]]; then
    printf 'database job requires exactly 100 allocated CPUs\n' >&2
    exit 2
fi
[[ "$ROOT" =~ $SAFE_PATH_RE && -d "$ROOT/runs" && -d "$ROOT/_locks" ]] || {
    printf 'invalid managed run root\n' >&2
    exit 2
}
[[ "$(cd "$ROOT" && pwd -P)" == "$ROOT" ]] || {
    printf 'managed run root is not canonical\n' >&2
    exit 2
}

RUN="$ROOT/runs/$RUN_ID"
[[ -d "$RUN/source" && -d "$RUN/state" && -d "$RUN/logs" ]] || {
    printf 'managed run is incomplete\n' >&2
    exit 2
}
[[ "$(<"$RUN/state/profile")" == "$PROFILE" ]] || {
    printf 'recorded profile does not match the job request\n' >&2
    exit 2
}
PIXI_BIN="$(<"$RUN/state/pixi-bin")"
[[ "$PIXI_BIN" =~ $SAFE_PATH_RE && -x "$PIXI_BIN" ]] || {
    printf 'recorded Pixi executable is invalid\n' >&2
    exit 2
}

SCRATCH_PARENT=""
SCRATCH_PARENT_CLEANUP=""
SCRATCH=""
SOURCE=""
if [[ "$PROFILE" != database ]]; then
    SCRATCH_PARENT="${SLURM_TMPDIR:-/dev/shm}"
    [[ "$SCRATCH_PARENT" =~ $SAFE_PATH_RE ]] || {
        printf 'Slurm scratch parent is not a safe absolute path\n' >&2
        exit 2
    }
    SCRATCH="${SCRATCH_PARENT%/}/nf-gtd-${SLURM_JOB_ID}-${RUN_ID}"
    SOURCE="$SCRATCH/source"
fi
STARTED_AT="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
PHASE=environment

atomic_text() {
    local path="$1"
    local value="$2"
    local temporary="${path}.tmp.$$"
    printf '%s\n' "$value" > "$temporary"
    mv -f -- "$temporary" "$path"
}

finalise() {
    local exit_code="$?"
    local failure_class scheduler_state ended_at result_tmp active_run="" active_job=""
    local active_lock="$ROOT/_locks/active-smoke"
    local cleanup_failed=false reports_json='[]' retained_json='[]'
    trap - EXIT TERM INT
    set +e
    if (( exit_code == 0 )); then
        failure_class=success
        scheduler_state=COMPLETED
    elif [[ "$PHASE" == cancelled ]]; then
        failure_class=unknown_failure
        scheduler_state=CANCELLED
    elif [[ "$PHASE" == environment || "$PHASE" == preflight ]]; then
        failure_class=environment_failure
        scheduler_state=FAILED
    elif [[ "$PHASE" == test ]]; then
        failure_class=test_failure
        scheduler_state=FAILED
    else
        failure_class=software_failure
        scheduler_state=FAILED
    fi
    exec 9>"$ROOT/_locks/submit.lock"
    flock -x 9
    if [[ "$PROFILE" == database ]]; then
        active_lock="$ROOT/_locks/active-database"
    fi
    if [[ -f "$active_lock" ]]; then
        read -r active_run active_job < "$active_lock" || true
        if [[ "$active_run" == "$RUN_ID" && "$active_job" == "$SLURM_JOB_ID" ]]; then
            rm -f -- "$active_lock"
        fi
    fi
    if [[ -n "$SCRATCH" && -e "$SCRATCH" ]]; then
        chmod -R u+w "$SCRATCH" 2>/dev/null || true
        rm -rf -- "$SCRATCH"
        [[ ! -e "$SCRATCH" ]] || cleanup_failed=true
    fi
    if [[ -n "$SCRATCH_PARENT_CLEANUP" && -e "$SCRATCH_PARENT_CLEANUP" ]]; then
        rmdir -- "$SCRATCH_PARENT_CLEANUP" 2>/dev/null || cleanup_failed=true
    fi
    if [[ "$cleanup_failed" == true ]]; then
        printf 'scratch_cleanup_status=failed\n' >&2
        if (( exit_code == 0 )); then
            exit_code=6
            failure_class=filesystem_failure
            scheduler_state=FAILED
        fi
    else
        printf 'scratch_cleanup_status=success\n'
    fi
    if [[ "$PROFILE" == p0 ]]; then
        reports_json='["artifacts/qualification/resume-check.json"]'
        retained_json='["artifacts/p0","artifacts/qualification"]'
    elif [[ "$PROFILE" == p1 ]]; then
        reports_json='["artifacts/qualification/p1-qualification.json"]'
        retained_json='["artifacts/p1","artifacts/qualification"]'
    elif [[ "$PROFILE" == p2 ]]; then
        reports_json='["artifacts/qualification/p2-first-copy-result.json","artifacts/qualification/p2-first-copy-resume-check.json"]'
        retained_json='["artifacts/p0","artifacts/p1","artifacts/p2","artifacts/qualification"]'
    elif [[ "$PROFILE" == database ]]; then
        reports_json='["artifacts/database/preflight.json"]'
        retained_json='["artifacts/database"]'
    fi
    ended_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    atomic_text "$RUN/state/exit-code" "$exit_code"
    atomic_text "$RUN/state/failure-class" "$failure_class"
    atomic_text "$RUN/state/phase" "completed"
    result_tmp="$RUN/state/job-result.json.tmp.$$"
    cat > "$result_tmp" <<EOF
{
  "schema_version": "1.0",
  "run_id": "$RUN_ID",
  "profile": "$PROFILE",
  "job_id": "$SLURM_JOB_ID",
  "started_at": "$STARTED_AT",
  "completed_at": "$ended_at",
  "scheduler_state": "$scheduler_state",
  "exit_code": $exit_code,
  "failure_class": "$failure_class",
  "standard_output": "logs/slurm-${SLURM_JOB_ID}.out",
  "standard_error": "logs/slurm-${SLURM_JOB_ID}.out",
  "application_log": "logs/${PROFILE}.log",
  "structured_test_reports": $reports_json,
  "retained_artifacts": $retained_json
}
EOF
    mv -f -- "$result_tmp" "$RUN/state/job-result.json"
    printf '{"event":"job_completed","profile":"%s","timestamp":"%s"}\n' \
        "$PROFILE" "$ended_at" >> "$RUN/events.jsonl"
    exit "$exit_code"
}

handle_signal() {
    local exit_code="$1"
    local signal_name="$2"
    PHASE=cancelled
    printf 'received_signal=%s\n' "$signal_name" >&2
    exit "$exit_code"
}

path_within_root() {
    local root="$1"
    local path="$2"
    [[ "$path" == "$root"/* ]]
}

load_p0_config() {
    local config="$ROOT/_config/p0.paths"
    local expected actual allowed candidate resolved index
    local -a values=()
    [[ -f "$config" && ! -L "$config" && -O "$config" ]] || {
        printf 'fixed P0 configuration is absent or unsafe\n' >&2
        return 1
    }
    [[ "$(stat -c '%a' "$config")" == 600 ]] || {
        printf 'fixed P0 configuration must have mode 0600\n' >&2
        return 1
    }
    expected="$(<"$RUN/state/p0-config-sha256")"
    [[ "$expected" =~ $CHECKSUM_RE ]] || {
        printf 'recorded P0 configuration checksum is invalid\n' >&2
        return 1
    }
    actual="$(sha256sum "$config" | awk '{print $1}')"
    [[ "$actual" == "$expected" ]] || {
        printf 'P0 configuration changed after staging\n' >&2
        return 1
    }
    mapfile -t values < "$config"
    [[ "${#values[@]}" -eq 7 ]] || {
        printf 'P0 configuration must contain exactly seven path lines\n' >&2
        return 1
    }
    for candidate in "${values[@]}"; do
        [[ "$candidate" =~ $SAFE_PATH_RE ]] || {
            printf 'P0 configuration contains an unsafe path\n' >&2
            return 1
        }
    done
    allowed="$(realpath -e "${values[0]}")"
    [[ "$allowed" == "${values[0]}" && -d "$allowed" && \
        ! -L "${values[0]}" && -O "${values[0]}" ]] || {
        printf 'P0 allowed root must be a canonical regular directory\n' >&2
        return 1
    }
    [[ "$allowed" != / && "$allowed" != "${HOME:-}" ]] || {
        printf 'P0 allowed root is too broad\n' >&2
        return 1
    }
    for index in 1 2 3 5 6; do
        candidate="${values[$index]}"
        resolved="$(realpath -e "$candidate")"
        [[ "$resolved" == "$candidate" ]] || {
            printf 'P0 file path is not canonical: %s\n' "$candidate" >&2
            return 1
        }
        path_within_root "$allowed" "$resolved" || {
            printf 'P0 file escaped the configured allowed root\n' >&2
            return 1
        }
        [[ -f "$resolved" && ! -L "$candidate" ]] || {
            printf 'P0 input is not a regular file: %s\n' "$candidate" >&2
            return 1
        }
    done
    candidate="${values[4]}"
    resolved="$(realpath -e "$candidate")"
    [[ "$resolved" == "$candidate" ]] || {
        printf 'P0 database root is not canonical\n' >&2
        return 1
    }
    path_within_root "$allowed" "$resolved" || {
        printf 'P0 database root escaped the configured allowed root\n' >&2
        return 1
    }
    [[ -d "$resolved" && ! -L "$candidate" ]] || {
        printf 'P0 database root is not a regular directory\n' >&2
        return 1
    }

    P0_ALLOWED_ROOT="$allowed"
    CATALOGUES="${values[1]}"
    CRYSTALS="${values[2]}"
    PIPELINE_CONFIG="${values[3]}"
    DATABASE_ROOT="${values[4]}"
    EXPECTED_DATABASE_MANIFEST="${values[5]}"
    PHENIX_MANIFEST="${values[6]}"
    P0_CONFIG_PATH="$config"
}

load_database_config() {
    local config="$ROOT/_config/database.paths"
    local expected actual allowed candidate resolved manifest_parent
    local -a values=()
    [[ -f "$config" && ! -L "$config" && -O "$config" ]] || {
        printf 'fixed database configuration is absent or unsafe\n' >&2
        return 1
    }
    [[ "$(stat -c '%a' "$config")" == 600 ]] || {
        printf 'fixed database configuration must have mode 0600\n' >&2
        return 1
    }
    expected="$(<"$RUN/state/database-config-sha256")"
    [[ "$expected" =~ $CHECKSUM_RE ]] || {
        printf 'recorded database configuration checksum is invalid\n' >&2
        return 1
    }
    actual="$(sha256sum "$config" | awk '{print $1}')"
    [[ "$actual" == "$expected" ]] || {
        printf 'database configuration changed after staging\n' >&2
        return 1
    }
    mapfile -t values < "$config"
    [[ "${#values[@]}" -eq 7 ]] || {
        printf 'database configuration must contain exactly seven lines\n' >&2
        return 1
    }
    for candidate in "${values[0]}" "${values[1]}" "${values[2]}"; do
        [[ "$candidate" =~ $SAFE_PATH_RE ]] || {
            printf 'database configuration contains an unsafe path\n' >&2
            return 1
        }
    done
    for candidate in "${values[3]}" "${values[4]}" "${values[5]}" "${values[6]}"; do
        [[ "$candidate" =~ $BYTE_COUNT_RE && "${#candidate}" -le 13 ]] || {
            printf 'database configuration contains an invalid byte count\n' >&2
            return 1
        }
    done
    allowed="$(realpath -e "${values[0]}")"
    [[ "$allowed" == "${values[0]}" && -d "$allowed" && ! -L "${values[0]}" ]] || {
        printf 'database allowed root is invalid\n' >&2
        return 1
    }
    [[ "$allowed" != / && "$allowed" != "${HOME:-}" ]] || {
        printf 'database allowed root is too broad\n' >&2
        return 1
    }
    resolved="$(realpath -e "${values[1]}")"
    [[ "$resolved" == "${values[1]}" && -d "$resolved" && \
        ! -L "${values[1]}" && -O "${values[1]}" ]] || {
        printf 'database root is invalid\n' >&2
        return 1
    }
    path_within_root "$allowed" "$resolved" || {
        printf 'database root escaped the allowed root\n' >&2
        return 1
    }
    [[ ! -e "${values[2]}" && ! -L "${values[2]}" ]] || {
        printf 'immutable database manifest output already exists\n' >&2
        return 1
    }
    manifest_parent="$(dirname "${values[2]}")"
    resolved="$(realpath -e "$manifest_parent")"
    [[ "$resolved" == "$manifest_parent" && -d "$resolved" && \
        ! -L "$manifest_parent" && -O "$manifest_parent" ]] || {
        printf 'database manifest parent is invalid\n' >&2
        return 1
    }
    path_within_root "$allowed" "${values[2]}" || {
        printf 'database manifest escaped the allowed root\n' >&2
        return 1
    }
    (( values[3] > 0 && values[3] <= 2000000000000 )) || {
        printf 'database storage cap is outside the fixed 2 TB boundary\n' >&2
        return 1
    }
    (( values[4] >= 0 && values[4] < values[3] )) || {
        printf 'database free-space headroom is invalid\n' >&2
        return 1
    }
    (( values[5] > 0 && values[5] <= values[3] )) || {
        printf 'required database capacity is invalid\n' >&2
        return 1
    }
    (( values[6] > 0 )) || {
        printf 'required scratch headroom is invalid\n' >&2
        return 1
    }

    DATABASE_ALLOWED_ROOT="$allowed"
    DATABASE_ROOT="${values[1]}"
    DATABASE_MANIFEST="${values[2]}"
    STORAGE_LIMIT_BYTES="${values[3]}"
    MINIMUM_FREE_BYTES="${values[4]}"
    REQUIRED_DATABASE_CAPACITY_BYTES="${values[5]}"
    MINIMUM_SCRATCH_FREE_BYTES="${values[6]}"
}

run_smoke() {
    mkdir -p "$SOURCE"
    cp -a "$RUN/source/." "$SOURCE/"
    chmod -R u+w "$SOURCE"
    [[ "$(git -C "$SOURCE" rev-parse HEAD)" == "$(<"$RUN/state/commit")" ]] || {
        printf 'scratch checkout commit mismatch\n' >&2
        return 2
    }
    cd "$SOURCE"
    printf 'phase=pixi_install profile=smoke\n'
    "$PIXI_BIN" install --environment default --frozen

    PHASE=test
    printf 'phase=foundation_check profile=smoke\n'
    "$PIXI_BIN" run --environment default check

    PHASE=software
    if [[ -n "$(git status --porcelain=v1 --untracked-files=no)" ]]; then
        printf 'foundation check modified tracked source files\n' >&2
        return 3
    fi
    printf 'smoke_status=success\n'
}

run_p0_nextflow() {
    local label="$1"
    shift
    "$NEXTFLOW" \
        -log "$RUN/logs/nextflow-${label}.log" \
        run "$RUN/source/main.nf" \
        "$@" \
        -profile marmic \
        --catalogues "$CATALOGUES" \
        --crystals "$CRYSTALS" \
        --config "$PIPELINE_CONFIG" \
        --database_manifest "$VERIFIED_DATABASE_MANIFEST" \
        --phenix_manifest "$PHENIX_MANIFEST" \
        --profile_mode pilot \
        --review_mode prepare \
        --outdir "$P0_OUT" \
        --cache_root "$RUN/cache"
}

run_p0() {
    local total cached cache_counts trace
    local qualification="$RUN/artifacts/qualification"
    P0_OUT="$RUN/artifacts/p0"
    VERIFIED_DATABASE_MANIFEST="$qualification/database_manifest.p0-revalidated.json"
    mkdir -p "$qualification" "$P0_OUT" "$RUN/cache" "$RUN/execution"

    load_p0_config
    cp -- "$P0_CONFIG_PATH" "$qualification/p0.paths.snapshot"
    sha256sum \
        "$P0_CONFIG_PATH" \
        "$CATALOGUES" \
        "$CRYSTALS" \
        "$PIPELINE_CONFIG" \
        "$EXPECTED_DATABASE_MANIFEST" \
        "$PHENIX_MANIFEST" \
        > "$qualification/input-checksums.sha256"

    cd "$RUN/source"
    printf 'phase=pixi_environment_verify profile=p0\n'
    [[ -f "$RUN/state/hpc-environment-status" && \
        "$(<"$RUN/state/hpc-environment-status")" == ready ]] || {
        printf 'locked P0 environment was not prepared during staging\n' >&2
        return 2
    }
    GTD="$RUN/source/.pixi/envs/hpc/bin/genome-to-diffraction"
    NEXTFLOW="$RUN/source/.pixi/envs/hpc/bin/nextflow"
    JAVA_CMD="$RUN/source/.pixi/envs/hpc/lib/jvm/bin/java"
    [[ -x "$GTD" && -x "$NEXTFLOW" && -x "$JAVA_CMD" ]] || {
        printf 'locked P0 executables are unavailable\n' >&2
        return 2
    }
    export PATH="$RUN/source/.pixi/envs/hpc/bin:${PATH:-/usr/bin:/bin}"

    printf 'phase=phenix_verify profile=p0\n'
    "$GTD" --log-format json --no-progress phenix verify \
        --manifest "$PHENIX_MANIFEST" \
        --verification-log "$qualification/phenix-verification.log" \
        --no-command-timeout

    printf 'phase=database_revalidate_bounded profile=p0\n'
    EXPECTED_DATABASE_SHA256="$(<"$RUN/state/database-manifest-sha256")"
    [[ "$EXPECTED_DATABASE_SHA256" =~ $CHECKSUM_RE ]] || {
        printf 'recorded database manifest checksum is invalid\n' >&2
        return 2
    }
    [[ "$(sha256sum "$EXPECTED_DATABASE_MANIFEST" | awk '{print $1}')" == \
        "$EXPECTED_DATABASE_SHA256" ]] || {
        printf 'expected database manifest changed after staging\n' >&2
        return 2
    }
    "$GTD" --log-format json --no-progress databases prepare \
        --database-root "$DATABASE_ROOT" \
        --manifest "$VERIFIED_DATABASE_MANIFEST" \
        --expected-manifest "$EXPECTED_DATABASE_MANIFEST" \
        --expected-manifest-sha256 "$EXPECTED_DATABASE_SHA256" \
        --prepare-pdb-foldseek \
        --prepare-pdb-sequences \
        --prepare-prostt5 \
        --initialise-coordinate-cache \
        --verify-only \
        --threads 2

    export JAVA_CMD
    export NXF_HOME="$RUN/cache/nextflow-home"
    cd "$RUN/execution"
    PHASE=test
    printf 'phase=p0_first_run profile=p0\n'
    run_p0_nextflow first
    cp -a "$P0_OUT/pipeline_info" "$qualification/first-pipeline-info"

    printf 'phase=p0_resume_run profile=p0\n'
    run_p0_nextflow resume -resume
    cp -a "$P0_OUT/pipeline_info" "$qualification/resume-pipeline-info"

    trace="$qualification/resume-pipeline-info/trace.tsv"
    [[ -f "$trace" ]] || {
        printf 'resume trace was not produced\n' >&2
        return 4
    }
    cache_counts="$(awk -F '\t' '
        NR == 1 {
            for (i = 1; i <= NF; i++) if ($i == "status") status_column = i
            next
        }
        status_column > 0 { total++; if ($status_column == "CACHED") cached++ }
        END { printf "%d %d", total, cached }
    ' "$trace")"
    read -r total cached <<< "$cache_counts"
    [[ "$total" =~ $INTEGER_RE && "$cached" =~ $INTEGER_RE ]] || {
        printf 'resume trace cache counts are invalid\n' >&2
        return 4
    }
    [[ "$total" -ge 4 && "$cached" -eq "$total" ]] || {
        printf 'resume did not cache every deterministic P0 process: total=%s cached=%s\n' \
            "$total" "$cached" >&2
        return 4
    }
    cat > "$qualification/resume-check.json" <<EOF
{
  "schema_version": "1.0",
  "run_id": "$RUN_ID",
  "profile": "p0",
  "process_count": $total,
  "cached_process_count": $cached,
  "all_deterministic_processes_cached": true
}
EOF

    PHASE=software
    [[ "$(git -C "$RUN/source" rev-parse HEAD)" == "$(<"$RUN/state/commit")" ]] || {
        printf 'P0 source commit changed during execution\n' >&2
        return 3
    }
    [[ -z "$(git -C "$RUN/source" status --porcelain=v1 --untracked-files=no)" ]] || {
        printf 'P0 execution modified tracked source files\n' >&2
        return 3
    }
    printf 'p0_status=preflight_complete_downstream_deferred\n'
}

run_p1_nextflow() {
    local label="$1"
    shift
    "$NEXTFLOW" \
        -log "$RUN/logs/nextflow-p1-${label}.log" \
        run "$RUN/source/discover_structures.nf" \
        "$@" \
        -profile marmic \
        --sequence_groups "$P1_CATALOGUE_OUT/sequence_groups.jsonl" \
        --source_records "$P1_CATALOGUE_OUT/source_records.jsonl" \
        --database_manifest "$EXPECTED_DATABASE_MANIFEST" \
        --outdir "$P1_DISCOVERY_OUT" \
        --cache_root "$RUN/cache/p1-nextflow" \
        --prostt5_maximum_queries 128
}

run_p1_model_nextflow() {
    local label="$1"
    shift
    "$NEXTFLOW" \
        -log "$RUN/logs/nextflow-p1-model-${label}.log" \
        run "$RUN/source/prepare_models.nf" \
        "$@" \
        -profile marmic \
        --coordinate_sources \
        "$P1_PREFETCH_OUT/coordinate_sources.jsonl" \
        --sequence_groups "$P1_CATALOGUE_OUT/sequence_groups.jsonl" \
        --phenix_manifest "$PHENIX_MANIFEST" \
        --outdir "$P1_MODEL_OUT" \
        --cache_root "$RUN/cache/p1-model-nextflow"
}

run_p1() {
    local first_trace resume_trace model_first_trace model_resume_trace
    local model_cache_counts model_total model_cached model_record_count
    local qualification="$RUN/artifacts/qualification"
    local control_spec="$RUN/source/benchmarks/public-controls/pdb_8oox.yaml"
    PILOT_AFDB_MAP="$RUN/source/benchmarks/public-controls/afdb_accessions.tsv"
    P1_OUT="$RUN/artifacts/p1"
    P1_CATALOGUE_OUT="$P1_OUT/catalogue"
    P1_PREFETCH_OUT="$P1_OUT/afdb-login-prefetch"
    P1_DISCOVERY_OUT="$P1_OUT/discovery"
    P1_MODEL_OUT="$P1_OUT/model-preparation"
    mkdir -p \
        "$qualification" \
        "$P1_CATALOGUE_OUT" \
        "$P1_DISCOVERY_OUT" \
        "$P1_MODEL_OUT" \
        "$RUN/cache/p1-nextflow" \
        "$RUN/cache/p1-model-nextflow" \
        "$RUN/execution"

    load_p0_config
    cp -- "$P0_CONFIG_PATH" "$qualification/p1.paths.snapshot"
    sha256sum \
        "$P0_CONFIG_PATH" \
        "$CATALOGUES" \
        "$PIPELINE_CONFIG" \
        "$EXPECTED_DATABASE_MANIFEST" \
        "$PHENIX_MANIFEST" \
        "$control_spec" \
        "$PILOT_AFDB_MAP" \
        "$RUN/state/p1-login-prefetch.sha256" \
        > "$qualification/p1-input-checksums.sha256"

    cd "$RUN/source"
    printf 'phase=pixi_environment_verify profile=p1\n'
    [[ -f "$RUN/state/hpc-environment-status" && \
        "$(<"$RUN/state/hpc-environment-status")" == ready ]] || {
        printf 'locked P1 environment was not prepared during staging\n' >&2
        return 2
    }
    GTD="$RUN/source/.pixi/envs/hpc/bin/genome-to-diffraction"
    NEXTFLOW="$RUN/source/.pixi/envs/hpc/bin/nextflow"
    JAVA_CMD="$RUN/source/.pixi/envs/hpc/lib/jvm/bin/java"
    [[ -x "$GTD" && -x "$NEXTFLOW" && -x "$JAVA_CMD" ]] || {
        printf 'locked P1 executables are unavailable\n' >&2
        return 2
    }
    export PATH="$RUN/source/.pixi/envs/hpc/bin:${PATH:-/usr/bin:/bin}"
    EXPECTED_DATABASE_SHA256="$(<"$RUN/state/database-manifest-sha256")"
    [[ "$EXPECTED_DATABASE_SHA256" =~ $CHECKSUM_RE ]] || {
        printf 'recorded P1 database manifest checksum is invalid\n' >&2
        return 2
    }
    [[ "$(sha256sum "$EXPECTED_DATABASE_MANIFEST" | awk '{print $1}')" == \
        "$EXPECTED_DATABASE_SHA256" ]] || {
        printf 'P1 database manifest changed after staging\n' >&2
        return 2
    }

    PHASE=test
    printf 'phase=p1_login_prefetch_verify profile=p1\n'
    [[ -f "$RUN/state/p1-login-prefetch.sha256" ]] || {
        printf 'P1 login-prefetch checksum record is absent\n' >&2
        return 2
    }
    sha256sum -c "$RUN/state/p1-login-prefetch.sha256"
    [[ "$(awk 'NF { count++ } END { print count + 0 }' \
        "$P1_PREFETCH_OUT/coordinate_sources.jsonl")" -eq 1 ]] || {
        printf 'P1 login prefetch no longer contains exactly one coordinate\n' >&2
        return 4
    }

    export JAVA_CMD
    export NXF_HOME="$RUN/cache/nextflow-home"
    cd "$RUN/execution"
    printf 'phase=p1_first_run profile=p1\n'
    run_p1_nextflow first
    cp -a \
        "$P1_DISCOVERY_OUT/pipeline_info" \
        "$qualification/p1-first-pipeline-info"

    printf 'phase=p1_resume_run profile=p1\n'
    run_p1_nextflow resume -resume
    cp -a \
        "$P1_DISCOVERY_OUT/pipeline_info" \
        "$qualification/p1-resume-pipeline-info"

    printf 'phase=p1_model_first_run profile=p1\n'
    run_p1_model_nextflow first
    cp -a \
        "$P1_MODEL_OUT/pipeline_info" \
        "$qualification/p1-model-first-pipeline-info"

    printf 'phase=p1_model_resume_run profile=p1\n'
    run_p1_model_nextflow resume -resume
    cp -a \
        "$P1_MODEL_OUT/pipeline_info" \
        "$qualification/p1-model-resume-pipeline-info"

    first_trace="$qualification/p1-first-pipeline-info/trace.tsv"
    resume_trace="$qualification/p1-resume-pipeline-info/trace.tsv"
    [[ -f "$first_trace" && -f "$resume_trace" ]] || {
        printf 'P1 first/resume traces were not produced\n' >&2
        return 4
    }
    model_first_trace="$qualification/p1-model-first-pipeline-info/trace.tsv"
    model_resume_trace="$qualification/p1-model-resume-pipeline-info/trace.tsv"
    [[ -f "$model_first_trace" && -f "$model_resume_trace" ]] || {
        printf 'P1 model first/resume traces were not produced\n' >&2
        return 4
    }
    [[ -s "$P1_MODEL_OUT/predicted_model_preparation/processed_models.jsonl" && \
        -s "$P1_MODEL_OUT/predicted_model_preparation/model_preparation_manifest.json" ]] || {
        printf 'P1 predicted-model outputs were not produced\n' >&2
        return 4
    }
    model_record_count="$(wc -l < \
        "$P1_MODEL_OUT/predicted_model_preparation/processed_models.jsonl")"
    [[ "$model_record_count" -eq 1 ]] || {
        printf 'P1 expected exactly one mapped predicted model: observed=%s\n' \
            "$model_record_count" >&2
        return 4
    }
    model_cache_counts="$(awk -F '\t' '
        NR == 1 {
            for (i = 1; i <= NF; i++) if ($i == "status") status_column = i
            next
        }
        status_column > 0 { total++; if ($status_column == "CACHED") cached++ }
        END { printf "%d %d", total, cached }
    ' "$model_resume_trace")"
    read -r model_total model_cached <<< "$model_cache_counts"
    [[ "$model_total" -eq 1 && "$model_cached" -eq 1 ]] || {
        printf 'P1 predicted-model resume was not fully cached: total=%s cached=%s\n' \
            "$model_total" "$model_cached" >&2
        return 4
    }
    cat > "$qualification/p1-model-resume-check.json" <<EOF
{
  "schema_version": "1.0",
  "run_id": "$RUN_ID",
  "profile": "p1",
  "process_count": $model_total,
  "cached_process_count": $model_cached,
  "all_model_processes_cached": true
}
EOF
    printf 'phase=p1_qualification profile=p1\n'
    "$GTD" --log-format json --no-progress structure-search qualify-p1 \
        --sequence-groups "$P1_CATALOGUE_OUT/sequence_groups.jsonl" \
        --search-directory "$P1_DISCOVERY_OUT/pdb_sequence_search" \
        --control-specification "$control_spec" \
        --first-trace "$first_trace" \
        --resume-trace "$resume_trace" \
        --output "$qualification/p1-qualification.json"

    PHASE=software
    [[ "$(git -C "$RUN/source" rev-parse HEAD)" == \
        "$(<"$RUN/state/commit")" ]] || {
        printf 'P1 source commit changed during execution\n' >&2
        return 3
    }
    [[ -z "$(git -C "$RUN/source" status --porcelain=v1 --untracked-files=no)" ]] || {
        printf 'P1 execution modified tracked source files\n' >&2
        return 3
    }
    printf 'p1_status=direct_pdb_sequence_search_qualified\n'
    printf 'prostt5_foldseek_status=pilot_slice_complete_full_catalogue_pending\n'
    printf 'afdb_exact_status=login_prefetch_verified_compute_offline\n'
    printf 'predicted_model_status=confidence_processed_and_resume_cached\n'
}

run_p2_first_copy_nextflow() {
    local label="$1"
    shift
    "$NEXTFLOW" \
        -log "$RUN/logs/nextflow-p2-first-copy-${label}.log" \
        run "$RUN/source/screen_first_copy.nf" \
        "$@" \
        -profile marmic \
        --coordinate_sources "$P1_PREFETCH_OUT/coordinate_sources.jsonl" \
        --prepared_models "$P1_MODEL_OUT/predicted_model_preparation" \
        --sequence_groups "$P1_CATALOGUE_OUT/sequence_groups.jsonl" \
        --matthews "$P0_OUT/matthews/matthews_hypotheses.jsonl" \
        --preflight "$P0_OUT/preflight/mtz_preflight.jsonl" \
        --config "$PIPELINE_CONFIG" \
        --crystal_id CD6QS2P2G1_5 \
        --mtz "$P2_MTZ" \
        --phenix_manifest "$PHENIX_MANIFEST" \
        --outdir "$P2_FIRST_COPY_OUT" \
        --cache_root "$RUN/cache/p2-first-copy"
}

run_p2() {
    local p2_mtz_candidate result_directory result_json result_count hypothesis_count
    local first_trace resume_trace cache_counts total cached
    local -a result_directories=()
    local qualification="$RUN/artifacts/qualification"

    printf 'phase=p2_replay_p0 profile=p2\n'
    run_p0
    printf 'phase=p2_replay_p1 profile=p2\n'
    run_p1

    P2_OUT="$RUN/artifacts/p2"
    P2_FIRST_COPY_OUT="$P2_OUT/first-copy"
    mkdir -p "$P2_FIRST_COPY_OUT" "$RUN/cache/p2-first-copy"
    [[ "$(basename "$(dirname "$CRYSTALS")")" == manifests ]] || {
        printf 'P2 requires the checksum-frozen P0 bundle layout\n' >&2
        return 2
    }
    p2_mtz_candidate="$(dirname "$(dirname "$CRYSTALS")")/inputs/CD6QS2P2G1_5.mtz"
    P2_MTZ="$(realpath -e "$p2_mtz_candidate")" || {
        printf 'fixed CD6 MTZ cannot be resolved\n' >&2
        return 2
    }
    [[ "$P2_MTZ" == "$p2_mtz_candidate" && -f "$P2_MTZ" && \
        ! -L "$p2_mtz_candidate" ]] || {
        printf 'fixed CD6 MTZ is not canonical and regular\n' >&2
        return 2
    }
    path_within_root "$P0_ALLOWED_ROOT" "$P2_MTZ" || {
        printf 'fixed CD6 MTZ escaped the qualified input root\n' >&2
        return 2
    }

    sha256sum \
        "$P0_CONFIG_PATH" \
        "$PIPELINE_CONFIG" \
        "$P2_MTZ" \
        "$P0_OUT/preflight/mtz_preflight.jsonl" \
        "$P0_OUT/matthews/matthews_hypotheses.jsonl" \
        "$P1_PREFETCH_OUT/coordinate_sources.jsonl" \
        "$P1_CATALOGUE_OUT/sequence_groups.jsonl" \
        "$P1_MODEL_OUT/predicted_model_preparation/processed_models.jsonl" \
        "$P1_MODEL_OUT/predicted_model_preparation/model_preparation_manifest.json" \
        "$PHENIX_MANIFEST" \
        > "$qualification/p2-input-checksums.sha256"

    PHASE=test
    export JAVA_CMD
    export NXF_HOME="$RUN/cache/nextflow-home"
    cd "$RUN/execution"
    printf 'phase=p2_first_copy_first_run profile=p2 crystal=CD6QS2P2G1_5\n'
    run_p2_first_copy_nextflow first
    cp -a \
        "$P2_FIRST_COPY_OUT/pipeline_info" \
        "$qualification/p2-first-copy-first-pipeline-info"

    printf 'phase=p2_first_copy_resume_run profile=p2 crystal=CD6QS2P2G1_5\n'
    run_p2_first_copy_nextflow resume -resume
    cp -a \
        "$P2_FIRST_COPY_OUT/pipeline_info" \
        "$qualification/p2-first-copy-resume-pipeline-info"

    hypothesis_count="$(awk 'NF { count++ } END { print count + 0 }' \
        "$P2_FIRST_COPY_OUT/exact_predicted_funnel/mr_hypotheses.jsonl")"
    [[ "$hypothesis_count" -eq 1 ]] || {
        printf 'P2 expected exactly one bounded CD6 hypothesis: observed=%s\n' \
            "$hypothesis_count" >&2
        return 4
    }
    mapfile -t result_directories < <(
        find "$P2_FIRST_COPY_OUT" \
            -mindepth 1 \
            -maxdepth 1 \
            -type d \
            -name 'first_copy_phaser_mrhyp_*' \
            -print
    )
    result_count="${#result_directories[@]}"
    [[ "$result_count" -eq 1 ]] || {
        printf 'P2 expected exactly one first-copy result directory: observed=%s\n' \
            "$result_count" >&2
        return 4
    }
    result_directory="${result_directories[0]}"
    result_json="$result_directory/normalised_mr_result.json"
    "$GTD" --log-format json --no-progress contract validate \
        normalised-mr-result \
        "$result_json"
    cp -- "$result_json" "$qualification/p2-first-copy-result.json"
    cp -- \
        "$result_directory/phaser_command.json" \
        "$qualification/p2-first-copy-command.json"
    [[ ! -f "$result_directory/PHASER.log" ]] || \
        cp -- "$result_directory/PHASER.log" \
            "$qualification/p2-first-copy-PHASER.log"
    cp -- \
        "$result_directory/phenix.phaser.capture.log" \
        "$qualification/p2-first-copy-capture.log"
    [[ ! -f "$result_directory/PHASER.1.pdb" ]] || \
        cp -- "$result_directory/PHASER.1.pdb" \
            "$qualification/p2-first-copy-solution.pdb"
    [[ ! -f "$result_directory/PHASER.1.mtz" ]] || \
        cp -- "$result_directory/PHASER.1.mtz" \
            "$qualification/p2-first-copy-solution.mtz"

    first_trace="$qualification/p2-first-copy-first-pipeline-info/trace.tsv"
    resume_trace="$qualification/p2-first-copy-resume-pipeline-info/trace.tsv"
    [[ -f "$first_trace" && -f "$resume_trace" ]] || {
        printf 'P2 first/resume traces were not produced\n' >&2
        return 4
    }
    cache_counts="$(awk -F '\t' '
        NR == 1 {
            for (i = 1; i <= NF; i++) if ($i == "status") status_column = i
            next
        }
        status_column > 0 { total++; if ($status_column == "CACHED") cached++ }
        END { printf "%d %d", total, cached }
    ' "$resume_trace")"
    read -r total cached <<< "$cache_counts"
    [[ "$total" -eq 2 && "$cached" -eq 2 ]] || {
        printf 'P2 first-copy resume was not fully cached: total=%s cached=%s\n' \
            "$total" "$cached" >&2
        return 4
    }
    cat > "$qualification/p2-first-copy-resume-check.json" <<EOF
{
  "schema_version": "1.0",
  "run_id": "$RUN_ID",
  "profile": "p2",
  "crystal_id": "CD6QS2P2G1_5",
  "process_count": $total,
  "cached_process_count": $cached,
  "all_first_copy_processes_cached": true
}
EOF

    PHASE=software
    [[ "$(git -C "$RUN/source" rev-parse HEAD)" == \
        "$(<"$RUN/state/commit")" ]] || {
        printf 'P2 source commit changed during execution\n' >&2
        return 3
    }
    [[ -z "$(git -C "$RUN/source" status --porcelain=v1 --untracked-files=no)" ]] || {
        printf 'P2 execution modified tracked source files\n' >&2
        return 3
    }
    printf 'p2_status=cd6_first_copy_completed_and_resume_cached\n'
}

run_database() {
    local gtd real_aria2 wrapper_bin database_manifest_sha256
    local source_bundle source_bundle_sha256 actual_source_bundle_sha256
    local scratch_base scratch_parent

    load_database_config
    scratch_base="$(realpath -e "$DATABASE_SCRATCH_ROOT")"
    [[ "$scratch_base" == "$DATABASE_SCRATCH_ROOT" && -d "$scratch_base" && \
        ! -L "$DATABASE_SCRATCH_ROOT" && -w "$scratch_base" && \
        -x "$scratch_base" ]] || {
        printf 'fixed /dev/shm database root is unavailable or unsafe\n' >&2
        return 2
    }
    scratch_parent="${scratch_base%/}/nf-gtd-database-parent-${UID}-${SLURM_JOB_ID}-${RUN_ID}"
    [[ "$scratch_parent" =~ $SAFE_PATH_RE && \
        ! -e "$scratch_parent" && ! -L "$scratch_parent" ]] || {
        printf 'job-owned /dev/shm directory is unsafe or already exists\n' >&2
        return 2
    }
    mkdir -m 0700 -- "$scratch_parent" || {
        printf 'cannot create job-owned /dev/shm directory\n' >&2
        return 2
    }
    SCRATCH_PARENT_CLEANUP="$scratch_parent"
    SCRATCH_PARENT="$(realpath -e "$scratch_parent")"
    [[ "$SCRATCH_PARENT" =~ $SAFE_PATH_RE && -d "$SCRATCH_PARENT" && \
        ! -L "$SCRATCH_PARENT" && -O "$SCRATCH_PARENT" ]] || {
        printf 'job-owned /dev/shm directory failed validation\n' >&2
        return 2
    }
    printf 'scratch_parent_source=job_owned_dev_shm\n'
    [[ "$(stat -c '%d' "$SCRATCH_PARENT")" != \
        "$(stat -c '%d' "$DATABASE_ROOT")" ]] || {
        printf 'database scratch and durable root share a filesystem\n' >&2
        return 2
    }
    SCRATCH="${SCRATCH_PARENT%/}/nf-gtd-database-${SLURM_JOB_ID}-${RUN_ID}"
    [[ "$SCRATCH" == "$SCRATCH_PARENT"/* ]] || {
        printf 'database scratch escaped its parent\n' >&2
        return 2
    }
    mkdir "$SCRATCH"
    SOURCE="$SCRATCH/source"
    mkdir "$SOURCE" "$SCRATCH/tmp"
    cp -a "$RUN/source/." "$SOURCE/"
    chmod -R u+w "$SOURCE"
    [[ "$(git -C "$SOURCE" rev-parse HEAD)" == "$(<"$RUN/state/commit")" ]] || {
        printf 'database scratch checkout commit mismatch\n' >&2
        return 2
    }

    [[ -f "$RUN/state/hpc-environment-status" && \
        "$(<"$RUN/state/hpc-environment-status")" == ready ]] || {
        printf 'staged HPC environment readiness record is absent\n' >&2
        return 2
    }
    source_bundle="$RUN/artifacts/database/source_bundle.json"
    [[ -f "$source_bundle" && ! -L "$source_bundle" ]] || {
        printf 'staged database source bundle is absent or unsafe\n' >&2
        return 2
    }
    source_bundle_sha256="$(<"$RUN/state/database-source-bundle-sha256")"
    [[ "$source_bundle_sha256" =~ $CHECKSUM_RE ]] || {
        printf 'recorded database source bundle checksum is invalid\n' >&2
        return 2
    }
    actual_source_bundle_sha256="$(sha256sum "$source_bundle" | awk '{print $1}')"
    [[ "$actual_source_bundle_sha256" == "$source_bundle_sha256" ]] || {
        printf 'database source bundle changed after login-node staging\n' >&2
        return 2
    }
    export TMPDIR="$SCRATCH/tmp"
    printf 'phase=pixi_verify_offline profile=database\n'
    cd "$SOURCE"
    "$PIXI_BIN" install \
        --environment hpc \
        --frozen \
        --offline \
        --no-progress
    gtd="$SOURCE/.pixi/envs/hpc/bin/genome-to-diffraction"
    real_aria2="$SOURCE/.pixi/envs/hpc/bin/aria2c"
    [[ -x "$gtd" && -x "$real_aria2" ]] || {
        printf 'locked database executables are unavailable\n' >&2
        return 2
    }

    wrapper_bin="$SCRATCH/tool-wrappers"
    mkdir "$wrapper_bin"
    cat > "$wrapper_bin/aria2c" <<EOF
#!/usr/bin/env bash
exec "$real_aria2" --no-conf=true "\$@"
EOF
    chmod 0555 "$wrapper_bin/aria2c"
    export PATH="$wrapper_bin:$SOURCE/.pixi/envs/hpc/bin:/usr/bin:/bin"

    PHASE=preflight
    printf 'phase=database_preflight profile=database\n'
    "$gtd" --log-format json --no-progress databases preflight \
        --database-root "$DATABASE_ROOT" \
        --scratch-root "$SCRATCH" \
        --report "$RUN/artifacts/database/preflight.json" \
        --storage-limit-bytes "$STORAGE_LIMIT_BYTES" \
        --minimum-free-bytes "$MINIMUM_FREE_BYTES" \
        --required-database-capacity-bytes "$REQUIRED_DATABASE_CAPACITY_BYTES" \
        --minimum-scratch-free-bytes "$MINIMUM_SCRATCH_FREE_BYTES" \
        --source-bundle "$source_bundle"

    PHASE=database
    printf 'phase=database_prepare profile=database\n'
    "$gtd" --log-format json --no-progress databases prepare \
        --database-root "$DATABASE_ROOT" \
        --scratch-root "$SCRATCH" \
        --minimum-scratch-free-bytes "$MINIMUM_SCRATCH_FREE_BYTES" \
        --source-bundle "$source_bundle" \
        --manifest "$DATABASE_MANIFEST" \
        --prepare-pdb-foldseek \
        --prepare-pdb-sequences \
        --prepare-prostt5 \
        --initialise-coordinate-cache \
        --storage-limit-bytes "$STORAGE_LIMIT_BYTES" \
        --minimum-free-bytes "$MINIMUM_FREE_BYTES" \
        --lock-timeout-seconds 300 \
        --threads "$SLURM_CPUS_PER_TASK"

    database_manifest_sha256="$(sha256sum "$DATABASE_MANIFEST" | awk '{print $1}')"
    [[ "$database_manifest_sha256" =~ $CHECKSUM_RE ]] || {
        printf 'database manifest checksum failed\n' >&2
        return 2
    }
    cp -- "$DATABASE_MANIFEST" "$RUN/artifacts/database/database_manifest.json"
    printf '%s  %s\n' "$database_manifest_sha256" "$(basename "$DATABASE_MANIFEST")" \
        > "$RUN/artifacts/database/database_manifest.sha256"

    PHASE=verification
    printf 'phase=database_full_verify profile=database\n'
    "$gtd" --log-format json --no-progress databases prepare \
        --database-root "$DATABASE_ROOT" \
        --scratch-root "$SCRATCH" \
        --minimum-scratch-free-bytes "$MINIMUM_SCRATCH_FREE_BYTES" \
        --source-bundle "$source_bundle" \
        --manifest "$RUN/artifacts/database/database_manifest.full-verified.json" \
        --expected-manifest "$DATABASE_MANIFEST" \
        --expected-manifest-sha256 "$database_manifest_sha256" \
        --prepare-pdb-foldseek \
        --prepare-pdb-sequences \
        --prepare-prostt5 \
        --initialise-coordinate-cache \
        --verify-only \
        --full-verify \
        --storage-limit-bytes "$STORAGE_LIMIT_BYTES" \
        --minimum-free-bytes "$MINIMUM_FREE_BYTES" \
        --lock-timeout-seconds 300 \
        --threads "$SLURM_CPUS_PER_TASK"

    PHASE=software
    [[ "$(git -C "$SOURCE" rev-parse HEAD)" == "$(<"$RUN/state/commit")" ]] || {
        printf 'database source commit changed during execution\n' >&2
        return 3
    }
    [[ -z "$(git -C "$SOURCE" status --porcelain=v1 --untracked-files=no)" ]] || {
        printf 'database execution modified tracked source files\n' >&2
        return 3
    }
    printf 'database_status=prepared_and_full_verified\n'
}

trap finalise EXIT
trap 'handle_signal 143 TERM' TERM
trap 'handle_signal 130 INT' INT

if [[ "$PROFILE" == database ]]; then
    mkdir -p "$RUN/artifacts/database"
else
    mkdir -p "$SCRATCH" "$SCRATCH/tmp"
fi
exec > "$RUN/logs/${PROFILE}.log" 2>&1

printf 'run_id=%s\n' "$RUN_ID"
printf 'profile=%s\n' "$PROFILE"
printf 'job_id=%s\n' "$SLURM_JOB_ID"
printf 'compute_host=%s\n' "$(hostname -f)"
printf 'source_commit=%s\n' "$(<"$RUN/state/commit")"
printf 'pixi_executable=%s\n' "$PIXI_BIN"
"$PIXI_BIN" --version

export PIXI_CACHE_DIR="$ROOT/_cache/pixi"
if [[ "$PROFILE" != database ]]; then
    export TMPDIR="$SCRATCH/tmp"
fi
export NXF_ANSI_LOG=false
export NXF_DISABLE_CHECK_LATEST=true

case "$PROFILE" in
    smoke) run_smoke ;;
    p0) run_p0 ;;
    p1) run_p1 ;;
    p2) run_p2 ;;
    database) run_database ;;
esac

PHASE=success
printf 'profile_status=success\n'
