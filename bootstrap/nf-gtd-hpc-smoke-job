run_phase3_network_probe() {
    local qualification="$RUN/artifacts/qualification"
    local output="$qualification/network-probe"
    local execution="$RUN/execution/phase3-network-probe"
    local nextflow_profile site_config_relative site_config_sha256
    local worker_shell_relative worker_shell_sha256
    local site_config worker_shell actual_site_config_sha256
    local actual_worker_shell_sha256 outer_network_namespace
    local nextflow java python source_commit helper_commit checksums_tmp
    local candidate checksum relative

    [[ -f "$RUN/state/hpc-environment-status" && \
       "$(<"$RUN/state/hpc-environment-status")" == ready ]] || return 2
    [[ -f "$RUN/state/nextflow-profile" && \
       -f "$RUN/state/network-site-config-relative" && \
       -f "$RUN/state/network-site-config-sha256" && \
       -f "$RUN/state/network-shell-relative" && \
       -f "$RUN/state/network-shell-sha256" ]] || return 2
    nextflow_profile="$(<"$RUN/state/nextflow-profile")"
    site_config_relative="$(<"$RUN/state/network-site-config-relative")"
    site_config_sha256="$(<"$RUN/state/network-site-config-sha256")"
    worker_shell_relative="$(<"$RUN/state/network-shell-relative")"
    worker_shell_sha256="$(<"$RUN/state/network-shell-sha256")"
    [[ "$(<"$RUN/state/site-id")" == marmic && \
       "$nextflow_profile" == marmic && \
       "$site_config_relative" == conf/marmic.config && \
       "$worker_shell_relative" == bootstrap/nf-gtd-worker-offline-shell && \
       "$site_config_sha256" =~ $CHECKSUM_RE && \
       "$worker_shell_sha256" =~ $CHECKSUM_RE ]] || return 2
    site_config="$RUN/source/$site_config_relative"
    worker_shell="$RUN/source/$worker_shell_relative"
    [[ -f "$site_config" && ! -L "$site_config" && \
       -f "$worker_shell" && ! -L "$worker_shell" ]] || return 2
    actual_site_config_sha256="$(sha256sum "$site_config" | awk '{print $1}')"
    actual_worker_shell_sha256="$(sha256sum "$worker_shell" | awk '{print $1}')"
    [[ "$actual_site_config_sha256" == "$site_config_sha256" && \
       "$actual_worker_shell_sha256" == "$worker_shell_sha256" ]] || return 2

    nextflow="$RUN/source/.pixi/envs/hpc/bin/nextflow"
    java="$RUN/source/.pixi/envs/hpc/lib/jvm/bin/java"
    python="$RUN/source/.pixi/envs/hpc/bin/python"
    [[ -x "$nextflow" && -x "$java" && -x "$python" && \
       -x /usr/bin/unshare ]] || return 2
    outer_network_namespace="$(readlink /proc/self/ns/net)"
    [[ "$outer_network_namespace" =~ ^net:\[[0-9]+\]$ ]] || return 2
    source_commit="$(<"$RUN/state/commit")"
    helper_commit="$(git -C "$RUN/source" rev-parse HEAD:external/nf-helper)"
    [[ "$source_commit" =~ ^[0-9a-f]{40}$ && \
       "$helper_commit" =~ ^[0-9a-f]{40}$ ]] || return 2

    mkdir -p \
        "$qualification" \
        "$output" \
        "$execution" \
        "$RUN/cache/nextflow-home" \
        "$RUN/cache/phase3-network-probe"
    export PATH="$RUN/source/.pixi/envs/hpc/bin:${PATH:-/usr/bin:/bin}"
    export JAVA_CMD="$java"
    export NXF_HOME="$RUN/cache/nextflow-home"

    PHASE=test
    printf 'phase=phase3_network_probe profile=phase3-network-probe\n'
    cd "$execution"
    "$nextflow" \
        -log "$RUN/logs/phase3-network-probe-nextflow.log" \
        run "$RUN/source/qualification.nf" \
        -profile "$nextflow_profile" \
        -work-dir "$execution/work" \
        -with-trace "$qualification/phase3-network-probe-trace.tsv" \
        --qualification_stage phase3_network_probe \
        --outer_job_id "$SLURM_JOB_ID" \
        --outer_network_namespace "$outer_network_namespace" \
        --cache_root "$RUN/cache/phase3-network-probe" \
        --outdir "$output"

    "$python" -m genome_to_diffraction.execution.network_probe summarise \
        --child-report "$output/phase3-network-probe-child.json" \
        --controller-report "$output/phase3-network-probe-controller.json" \
        --run-id "$RUN_ID" \
        --site-id marmic \
        --source-commit "$source_commit" \
        --nf-helper-commit "$helper_commit" \
        --output "$qualification/phase3-network-probe-summary.json"

    checksums_tmp="$qualification/phase3-network-probe-checksums.sha256.tmp.$$"
    : > "$checksums_tmp"
    for candidate in \
        "$qualification/phase3-network-probe-summary.json" \
        "$qualification/phase3-network-probe-trace.tsv" \
        "$output/phase3-network-probe-child.json" \
        "$output/phase3-network-probe-controller.json"; do
        checksum="$(sha256sum "$candidate" | awk '{print $1}')"
        relative="${candidate#"$RUN/"}"
        printf '%s  %s\n' "$checksum" "$relative" >> "$checksums_tmp"
    done
    mv -f -- "$checksums_tmp" \
        "$qualification/phase3-network-probe-checksums.sha256"

    PHASE=software
    [[ "$(git -C "$RUN/source" rev-parse HEAD)" == "$source_commit" ]] || return 3
    [[ -z "$(git -C "$RUN/source" status --porcelain=v1 --untracked-files=no)" ]] || \
        return 3
    printf 'phase3_network_probe_status=child_and_controller_sockets_denied\n'
}

