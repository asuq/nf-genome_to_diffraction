load_m6_smoke_site_contract() {
    local expected_profile expected_policy_relative expected_policy_id
    local policy_relative actual_policy_sha state_name
    for state_name in \
        site-id \
        nextflow-profile \
        execution-policy-relative \
        execution-policy-id \
        execution-policy-sha256 \
        apptainer-cache-dir; do
        [[ -f "$RUN/state/$state_name" && ! -L "$RUN/state/$state_name" && \
           -O "$RUN/state/$state_name" ]] || {
            printf 'M6 site policy state is absent or unsafe\n' >&2
            return 1
        }
    done
    M6_SITE_ID="$(<"$RUN/state/site-id")"
    if [[ "$M6_SITE_ID" == viper-cpu ]]; then
        expected_profile=viper-cpu
        expected_policy_relative=benchmarks/m6/execution-nextflow-v1.yaml
        expected_policy_id=m6_nextflow_slurm_v1
    elif [[ "$M6_SITE_ID" == marmic ]]; then
        expected_profile=marmic
        expected_policy_relative=benchmarks/m6/execution-nextflow-marmic-v1.yaml
        expected_policy_id=m6_nextflow_slurm_marmic_v1
    else
        printf 'unsupported M6 smoke site identity\n' >&2
        return 1
    fi
    M6_NEXTFLOW_PROFILE="$(<"$RUN/state/nextflow-profile")"
    policy_relative="$(<"$RUN/state/execution-policy-relative")"
    M6_EXECUTION_POLICY_ID="$(<"$RUN/state/execution-policy-id")"
    M6_EXECUTION_POLICY_SHA256="$(<"$RUN/state/execution-policy-sha256")"
    M6_APPTAINER_CACHE="$(<"$RUN/state/apptainer-cache-dir")"
    [[ "$M6_NEXTFLOW_PROFILE" == "$expected_profile" && \
       "$policy_relative" == "$expected_policy_relative" && \
       "$M6_EXECUTION_POLICY_ID" == "$expected_policy_id" && \
       "$M6_EXECUTION_POLICY_SHA256" =~ $CHECKSUM_RE ]] || {
        printf 'M6 smoke site policy mapping changed after staging\n' >&2
        return 1
    }
    M6_EXECUTION_POLICY="$RUN/source/$policy_relative"
    [[ -f "$M6_EXECUTION_POLICY" && ! -L "$M6_EXECUTION_POLICY" && \
       -O "$M6_EXECUTION_POLICY" ]] || {
        printf 'fixed M6 execution policy is absent or unsafe\n' >&2
        return 1
    }
    actual_policy_sha="$(sha256sum "$M6_EXECUTION_POLICY" | awk '{print $1}')"
    [[ "$actual_policy_sha" == "$M6_EXECUTION_POLICY_SHA256" ]] || {
        printf 'fixed M6 execution policy changed after staging\n' >&2
        return 1
    }
    [[ "$M6_APPTAINER_CACHE" == "$RUN/cache/apptainer" && \
       -d "$M6_APPTAINER_CACHE" && ! -L "$M6_APPTAINER_CACHE" && \
       -O "$M6_APPTAINER_CACHE" ]] || {
        printf 'run-owned M6 Apptainer cache is unsafe\n' >&2
        return 1
    }
}

