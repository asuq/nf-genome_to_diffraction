run_p0() {
    local total cached cache_counts trace
    local qualification="$RUN/artifacts/qualification"
    P0_OUT="$RUN/artifacts/p0"
    VERIFIED_DATABASE_MANIFEST="$qualification/database_manifest.p0-revalidated.json"
    mkdir -p "$qualification" "$P0_OUT" "$RUN/cache" "$RUN/execution"

    load_p0_config
    cp -- "$P0_CONFIG_PATH" "$qualification/p0.paths.snapshot"
    sha256sum \
        "$P0_CONFIG_PATH" \
        "$CATALOGUES" \
        "$CRYSTALS" \
        "$PIPELINE_CONFIG" \
        "$EXPECTED_DATABASE_MANIFEST" \
        "$PHENIX_MANIFEST" \
        > "$qualification/input-checksums.sha256"

    cd "$RUN/source"
    printf 'phase=pixi_environment_verify profile=p0\n'
    [[ -f "$RUN/state/hpc-environment-status" && \
        "$(<"$RUN/state/hpc-environment-status")" == ready ]] || {
        printf 'locked P0 environment was not prepared during staging\n' >&2
        return 2
    }
    GTD="$RUN/source/.pixi/envs/hpc/bin/genome-to-diffraction"
    NEXTFLOW="$RUN/source/.pixi/envs/hpc/bin/nextflow"
    JAVA_CMD="$RUN/source/.pixi/envs/hpc/lib/jvm/bin/java"
    [[ -x "$GTD" && -x "$NEXTFLOW" && -x "$JAVA_CMD" ]] || {
        printf 'locked P0 executables are unavailable\n' >&2
        return 2
    }
    export PATH="$RUN/source/.pixi/envs/hpc/bin:${PATH:-/usr/bin:/bin}"

    printf 'phase=phenix_verify profile=p0\n'
    "$GTD" --log-format json --no-progress phenix verify \
        --manifest "$PHENIX_MANIFEST" \
        --verification-log "$qualification/phenix-verification.log" \
        --no-command-timeout

    printf 'phase=database_revalidate_bounded profile=p0\n'
    EXPECTED_DATABASE_SHA256="$(<"$RUN/state/database-manifest-sha256")"
    [[ "$EXPECTED_DATABASE_SHA256" =~ $CHECKSUM_RE ]] || {
        printf 'recorded database manifest checksum is invalid\n' >&2
        return 2
    }
    [[ "$(sha256sum "$EXPECTED_DATABASE_MANIFEST" | awk '{print $1}')" == \
        "$EXPECTED_DATABASE_SHA256" ]] || {
        printf 'expected database manifest changed after staging\n' >&2
        return 2
    }
    "$GTD" --log-format json --no-progress databases prepare \
        --database-root "$DATABASE_ROOT" \
        --manifest "$VERIFIED_DATABASE_MANIFEST" \
        --expected-manifest "$EXPECTED_DATABASE_MANIFEST" \
        --expected-manifest-sha256 "$EXPECTED_DATABASE_SHA256" \
        --prepare-pdb-foldseek \
        --prepare-pdb-sequences \
        --prepare-prostt5 \
        --initialise-coordinate-cache \
        --verify-only \
        --threads 2

    export JAVA_CMD
    export NXF_HOME="$RUN/cache/nextflow-home"
    cd "$RUN/execution"
    PHASE=test
    printf 'phase=p0_first_run profile=p0\n'
    run_p0_nextflow first
    cp -a "$P0_OUT/pipeline_info" "$qualification/first-pipeline-info"

    printf 'phase=p0_resume_run profile=p0\n'
    run_p0_nextflow resume -resume
    cp -a "$P0_OUT/pipeline_info" "$qualification/resume-pipeline-info"

    trace="$qualification/resume-pipeline-info/trace.tsv"
    [[ -f "$trace" ]] || {
        printf 'resume trace was not produced\n' >&2
        return 4
    }
    cache_counts="$(awk -F '\t' '
        NR == 1 {
            for (i = 1; i <= NF; i++) if ($i == "status") status_column = i
            next
        }
        status_column > 0 { total++; if ($status_column == "CACHED") cached++ }
        END { printf "%d %d", total, cached }
    ' "$trace")"
    read -r total cached <<< "$cache_counts"
    [[ "$total" =~ $INTEGER_RE && "$cached" =~ $INTEGER_RE ]] || {
        printf 'resume trace cache counts are invalid\n' >&2
        return 4
    }
    [[ "$total" -ge 4 && "$cached" -eq "$total" ]] || {
        printf 'resume did not cache every deterministic P0 process: total=%s cached=%s\n' \
            "$total" "$cached" >&2
        return 4
    }
    cat > "$qualification/resume-check.json" <<EOF
{
  "schema_version": "1.0",
  "run_id": "$RUN_ID",
  "profile": "p0",
  "process_count": $total,
  "cached_process_count": $cached,
  "all_deterministic_processes_cached": true
}
EOF

    PHASE=software
    [[ "$(git -C "$RUN/source" rev-parse HEAD)" == "$(<"$RUN/state/commit")" ]] || {
        printf 'P0 source commit changed during execution\n' >&2
        return 3
    }
    [[ -z "$(git -C "$RUN/source" status --porcelain=v1 --untracked-files=no)" ]] || {
        printf 'P0 execution modified tracked source files\n' >&2
        return 3
    }
    printf 'p0_status=preflight_complete_downstream_deferred\n'
}

