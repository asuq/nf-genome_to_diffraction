        "$qualification/m4-copy-first-pipeline-info"
    printf 'phase=m4_copy_resume_run profile=m4-copy candidate_count=11\n'
    run_m4_copy_nextflow resume -resume
    cp -a "$M4_RESULTS/pipeline_info" \
        "$qualification/m4-copy-resume-pipeline-info"
    cache_counts="$(awk -F '\t' '
        NR == 1 { for (i = 1; i <= NF; i++) if ($i == "status") column = i; next }
        column > 0 { total++; if ($column == "CACHED") cached++ }
        END { printf "%d %d", total, cached }
    ' "$qualification/m4-copy-resume-pipeline-info/trace.tsv")"
    read -r total cached <<< "$cache_counts"
    expected="$(awk 'NR > 1 && NF { count++ } END { print count + 0 }' \
        "$M4_INPUTS/seeds.tsv")"
    [[ "$expected" -eq 11 && "$total" -eq "$expected" && \
       "$cached" -eq "$expected" ]] || return 4

    mapfile -t directories < <(
        find "$M4_RESULTS" -mindepth 1 -maxdepth 1 -type d \
            -name 'additional_copy_sol_*' -print | LC_ALL=C sort
    )
    result_count="${#directories[@]}"
    [[ "$result_count" -eq "$expected" ]] || return 4
    results_tmp="$qualification/m4-copy-results.jsonl.tmp.$$"
    summaries_tmp="$qualification/m4-copy-series-summaries.jsonl.tmp.$$"
    commands_tmp="$qualification/m4-copy-commands.jsonl.tmp.$$"
    tails_tmp="$qualification/m4-copy-log-tails.txt.tmp.$$"
    : > "$results_tmp"
    : > "$summaries_tmp"
    : > "$commands_tmp"
    : > "$tails_tmp"
    for directory in "${directories[@]}"; do
        series="$directory/additional_copy_series_results.jsonl"
        series_summary="$directory/additional_copy_series_summary.json"
        [[ -s "$series" && ! -L "$series" && \
           -s "$series_summary" && ! -L "$series_summary" ]] || return 4
        attempts="$(awk 'NF { count++ } END { print count + 0 }' "$series")"
        [[ "$attempts" -ge 1 ]] || return 4
        attempt_count=$((attempt_count + attempts))
        series_supported="$(grep -c '"additional_copy_supported":true' "$series" || true)"
        supported_count=$((supported_count + series_supported))
        final_result="$(tail -n 1 "$series")"
        status="$(sed -n 's/.*"execution_status":"\([^"]*\)".*/\1/p' <<< "$final_result")"
        seed_id="$(sed -n 's/.*"seed_solution_id":"\([^"]*\)".*/\1/p' <<< "$final_result")"
        [[ -n "$status" && "$seed_id" == sol_* ]] || return 4
        if grep -Eq '"reached_expected_copy_count"[[:space:]]*:[[:space:]]*true' \
            "$series_summary"; then
            complete_count=$((complete_count + 1))
        elif [[ "$status" == completed_no_hit ]]; then
            no_addition_count=$((no_addition_count + 1))
        elif [[ "$status" != completed_hit ]]; then
            failed_count=$((failed_count + 1))
        fi
        cat -- "$series" >> "$results_tmp"
        "$RUN/source/.pixi/envs/hpc/bin/python" -c \
            'import json,sys; print(json.dumps(json.load(open(sys.argv[1])),sort_keys=True,separators=(",",":")))' \
            "$series_summary" >> "$summaries_tmp"
        while IFS= read -r command; do
            "$RUN/source/.pixi/envs/hpc/bin/python" -c \
                'import json,sys; print(json.dumps(json.load(open(sys.argv[1])),sort_keys=True,separators=(",",":")))' \
                "$command" >> "$commands_tmp"
        done < <(find "$directory" -type f -name phaser_command.json -print | LC_ALL=C sort)
        while IFS= read -r log_file; do
            printf 'seed_solution_id=%s attempt=%s tail_lines=200\n' \
                "$seed_id" "${log_file#"$directory/"}" >> "$tails_tmp"
            tail -n 200 "$log_file" >> "$tails_tmp"
        done < <(find "$directory" -type f -name PHASER.log -print | LC_ALL=C sort)
    done
    mv -f -- "$results_tmp" "$qualification/m4-copy-results.jsonl"
    mv -f -- "$summaries_tmp" "$qualification/m4-copy-series-summaries.jsonl"
    mv -f -- "$commands_tmp" "$qualification/m4-copy-commands.jsonl"
    mv -f -- "$tails_tmp" "$qualification/m4-copy-log-tails.txt"
    "$GTD" --log-format json --no-progress mr copy-report \
        --results "$qualification/m4-copy-results.jsonl" \
        --outdir "$qualification/m4-copy-count-report"
    cat > "$qualification/m4-copy-resume-check.json" <<EOF
{"schema_version":"1.0","run_id":"$RUN_ID","profile":"m4-copy","process_count":$total,"cached_process_count":$cached,"all_candidate_series_cached":true}
EOF
    cat > "$qualification/m4-copy-summary.json" <<EOF
{"schema_version":"1.0","run_id":"$RUN_ID","profile":"m4-copy","parent_run_id":"$(<"$RUN/state/parent-run-id")","attempted_seed_count":$result_count,"attempted_transition_count":$attempt_count,"supported_transition_count":$supported_count,"expected_copy_count_reached_count":$complete_count,"stopped_before_expected_count":$((result_count - complete_count)),"completed_no_addition_count":$no_addition_count,"candidate_failure_count":$failed_count,"all_parents_retained":true,"failed_addition_proves_absence":false,"selection_policy":"retain_all_and_rank_downstream_evidence","all_resume_processes_cached":true}
EOF
    checksums_tmp="$qualification/m4-copy-artifact-sha256.tsv.tmp.$$"
    printf 'sha256\tpath\n' > "$checksums_tmp"
    for candidate in \
        "$qualification/m4-copy-summary.json" \
        "$qualification/m4-copy-results.jsonl" \
        "$qualification/m4-copy-series-summaries.jsonl" \
        "$qualification/m4-copy-count-report/copy_count_assessments.jsonl" \
        "$qualification/m4-copy-count-report/copy_count_assessments.tsv" \
        "$qualification/m4-copy-count-report/copy_count_report.md" \
        "$qualification/m4-copy-count-report/copy_count_report_manifest.json" \
        "$qualification/m4-copy-commands.jsonl" \
        "$qualification/m4-copy-log-tails.txt" \
        "$qualification/m4-copy-resume-check.json" \
        "$qualification/m4-copy-input-checksums.sha256" \
        "$M4_INPUTS/m4_copy_stage_manifest.json"; do
        checksum="$(sha256sum "$candidate" | awk '{print $1}')"
        relative="${candidate#"$RUN/"}"
        printf '%s\t%s\n' "$checksum" "$relative" >> "$checksums_tmp"
    done
    mv -f -- "$checksums_tmp" "$qualification/m4-copy-artifact-sha256.tsv"
    PHASE=software
    [[ "$(git -C "$RUN/source" rev-parse HEAD)" == \
        "$(<"$RUN/state/commit")" ]] || return 3
    [[ -z "$(git -C "$RUN/source" status --porcelain=v1 --untracked-files=no)" ]] || \
        return 3
    printf 'm4_copy_status=all_approved_seeds_attempted_and_parents_retained\n'
}

run_t12_nextflow() {
    local label="$1"
    shift
    "$NEXTFLOW" \
        -log "$RUN/logs/nextflow-t12-${label}.log" \
        run "$RUN/source/refine_finalists.nf" \
        "$@" \
        -profile viper-cpu \
        --finalists "$T12_INPUTS/finalists.tsv" \
        --sequence_groups "$T12_INPUTS/inputs/sequence_groups.jsonl" \
        --source_records "$T12_INPUTS/inputs/source_records.jsonl" \
        --phenix_manifest "$T12_INPUTS/inputs/phenix_manifest.json" \
        --outdir "$T12_RESULTS" \
        --cache_root "$RUN/cache/t12"
}

run_t12() {
    local qualification="$RUN/artifacts/qualification"
    local cache_counts total cached expected result_count
    local refinements_tmp sequences_tmp commands_tmp tails_tmp checksums_tmp
    local directory candidate checksum relative log_file
    local completed_refinement failed_refinement completed_sequence failed_sequence
    local -a directories=()

    T12_INPUTS="$RUN/artifacts/t12-inputs"
    T12_RESULTS="$RUN/artifacts/t12"
    mkdir -p "$qualification" "$T12_RESULTS" "$RUN/cache/t12" "$RUN/execution"
    [[ -f "$RUN/state/t12-stage-manifest-sha256" && \
       "$(sha256sum "$T12_INPUTS/t12_stage_manifest.json" | awk '{print $1}')" == \
       "$(<"$RUN/state/t12-stage-manifest-sha256")" ]] || {
        printf 'T12 staged-input manifest changed before execution\n' >&2
        return 2
    }
    [[ -f "$RUN/state/hpc-environment-status" && \
       "$(<"$RUN/state/hpc-environment-status")" == ready ]] || return 2
    GTD="$RUN/source/.pixi/envs/hpc/bin/genome-to-diffraction"
    NEXTFLOW="$RUN/source/.pixi/envs/hpc/bin/nextflow"
    JAVA_CMD="$RUN/source/.pixi/envs/hpc/lib/jvm/bin/java"
    [[ -x "$GTD" && -x "$NEXTFLOW" && -x "$JAVA_CMD" ]] || return 2
    export PATH="$RUN/source/.pixi/envs/hpc/bin:${PATH:-/usr/bin:/bin}"
    export JAVA_CMD NXF_HOME="$RUN/cache/nextflow-home"
    export NF_HELPER_VIPER_COMPUTE_CONTROLLER=managed-slurm
    export NXF_APPTAINER_CACHEDIR=/ptmp/ashima/apptainer-cache

    PHASE=test
    printf 'phase=t12_phenix_verify profile=t12\n'
    "$GTD" --log-format json --no-progress phenix verify \
        --manifest "$T12_INPUTS/inputs/phenix_manifest.json" \
        --verification-log "$qualification/t12-phenix-verification.log" \
        --no-command-timeout
    sha256sum \
        "$T12_INPUTS/t12_stage_manifest.json" \
        "$T12_INPUTS/finalists.tsv" \
        "$T12_INPUTS/inputs/sequence_groups.jsonl" \
        "$T12_INPUTS/inputs/source_records.jsonl" \
        "$T12_INPUTS/inputs/preflight.jsonl" \
        "$T12_INPUTS/inputs/phenix_manifest.json" \
        > "$qualification/t12-input-checksums.sha256"

    cd "$RUN/execution"
    printf 'phase=t12_first_run profile=t12 candidate_count=11\n'
    run_t12_nextflow first
    cp -a "$T12_RESULTS/pipeline_info" \
        "$qualification/t12-first-pipeline-info"
    printf 'phase=t12_resume_run profile=t12 candidate_count=11\n'
    run_t12_nextflow resume -resume
    cp -a "$T12_RESULTS/pipeline_info" \
        "$qualification/t12-resume-pipeline-info"
    cache_counts="$(awk -F '\t' '
        NR == 1 { for (i = 1; i <= NF; i++) if ($i == "status") column = i; next }
        column > 0 { total++; if ($column == "CACHED") cached++ }
        END { printf "%d %d", total, cached }
    ' "$qualification/t12-resume-pipeline-info/trace.tsv")"
    read -r total cached <<< "$cache_counts"
    expected="$(awk 'NR > 1 && NF { count++ } END { print count + 0 }' \
        "$T12_INPUTS/finalists.tsv")"
    [[ "$expected" -eq 11 && "$total" -eq "$expected" && \
       "$cached" -eq "$expected" ]] || return 4

    mapfile -t directories < <(
        find "$T12_RESULTS" -mindepth 1 -maxdepth 1 -type d \
            -name 't12_sol_*' -print | LC_ALL=C sort
    )
    result_count="${#directories[@]}"
    [[ "$result_count" -eq "$expected" ]] || return 4
    refinements_tmp="$qualification/t12-refinement-results.jsonl.tmp.$$"
    sequences_tmp="$qualification/t12-sequence-results.jsonl.tmp.$$"
    commands_tmp="$qualification/t12-commands.jsonl.tmp.$$"
    tails_tmp="$qualification/t12-log-tails.txt.tmp.$$"
    : > "$refinements_tmp"
    : > "$sequences_tmp"
    : > "$commands_tmp"
    : > "$tails_tmp"
    for directory in "${directories[@]}"; do
        [[ -s "$directory/brief_refinement_result.jsonl" && \
           -s "$directory/sequence_map_result.jsonl" && \
           -s "$directory/t12_command.json" ]] || return 4
        cat -- "$directory/brief_refinement_result.jsonl" >> "$refinements_tmp"
        cat -- "$directory/sequence_map_result.jsonl" >> "$sequences_tmp"
        "$RUN/source/.pixi/envs/hpc/bin/python" -c \
            'import json,sys; print(json.dumps(json.load(open(sys.argv[1])),sort_keys=True,separators=(",",":")))' \
            "$directory/t12_command.json" >> "$commands_tmp"
        for log_file in \
            "$directory/phenix.refine.log" \
            "$directory/phenix.sequence_from_map.log"; do
            [[ -f "$log_file" ]] || continue
            printf 'candidate=%s log=%s tail_lines=200\n' \
                "$(basename "$directory")" "$(basename "$log_file")" >> "$tails_tmp"
            tail -n 200 "$log_file" >> "$tails_tmp"
        done
    done
    mv -f -- "$refinements_tmp" "$qualification/t12-refinement-results.jsonl"
    mv -f -- "$sequences_tmp" "$qualification/t12-sequence-results.jsonl"
    mv -f -- "$commands_tmp" "$qualification/t12-commands.jsonl"
    mv -f -- "$tails_tmp" "$qualification/t12-log-tails.txt"
    completed_refinement="$(grep -c '"execution_status":"completed' \
        "$qualification/t12-refinement-results.jsonl" || true)"
    failed_refinement=$((result_count - completed_refinement))
    completed_sequence="$(grep -c '"execution_status":"completed' \
        "$qualification/t12-sequence-results.jsonl" || true)"
    failed_sequence=$((result_count - completed_sequence))
    cat > "$qualification/t12-resume-check.json" <<EOF
{"schema_version":"1.0","run_id":"$RUN_ID","profile":"t12","process_count":$total,"cached_process_count":$cached,"all_candidate_processes_cached":true}
EOF
    cat > "$qualification/t12-summary.json" <<EOF
{"schema_version":"1.0","run_id":"$RUN_ID","profile":"t12","parent_run_id":"$(<"$RUN/state/parent-run-id")","candidate_count":$result_count,"completed_refinement_count":$completed_refinement,"failed_refinement_count":$failed_refinement,"completed_sequence_count":$completed_sequence,"failed_sequence_count":$failed_sequence,"all_candidates_retained":true,"selection_policy":"retain_all_supported_copy_two_parents","all_resume_processes_cached":true}
EOF
    checksums_tmp="$qualification/t12-artifact-sha256.tsv.tmp.$$"
    printf 'sha256\tpath\n' > "$checksums_tmp"
    for candidate in \
        "$qualification/t12-summary.json" \
        "$qualification/t12-resume-check.json" \
        "$qualification/t12-refinement-results.jsonl" \
        "$qualification/t12-sequence-results.jsonl" \
        "$qualification/t12-commands.jsonl" \
        "$qualification/t12-log-tails.txt" \
        "$qualification/t12-input-checksums.sha256" \
        "$T12_INPUTS/t12_stage_manifest.json"; do
        checksum="$(sha256sum "$candidate" | awk '{print $1}')"
        relative="${candidate#"$RUN/"}"
        printf '%s\t%s\n' "$checksum" "$relative" >> "$checksums_tmp"
    done
    mv -f -- "$checksums_tmp" "$qualification/t12-artifact-sha256.tsv"
    PHASE=software
    [[ "$(git -C "$RUN/source" rev-parse HEAD)" == \
        "$(<"$RUN/state/commit")" ]] || return 3
    [[ -z "$(git -C "$RUN/source" status --porcelain=v1 --untracked-files=no)" ]] || \
        return 3
    printf 't12_status=all_retained_copy_two_parents_refined_and_ranked\n'
}

run_database() {
    local gtd real_aria2 wrapper_bin database_manifest_sha256
    local source_bundle source_bundle_sha256 actual_source_bundle_sha256
    local scratch_base scratch_parent resolved_scratch

    load_database_config
    resolved_scratch="$(site_resolved_path "$ROOT/database-staging")" || {
        printf 'fixed /ptmp database staging root is unavailable or unsafe\n' >&2
        return 2
    }
    scratch_base="$ROOT/database-staging"
    [[ -d "$resolved_scratch" && ! -L "$scratch_base" && \
        -w "$resolved_scratch" && -x "$resolved_scratch" ]] || {
        printf 'fixed /ptmp database staging root is unavailable or unsafe\n' >&2
        return 2
    }
    scratch_parent="${scratch_base%/}/nf-gtd-database-parent-${UID}-${SLURM_JOB_ID}-${RUN_ID}"
    [[ "$scratch_parent" =~ $SAFE_PATH_RE && \
        ! -e "$scratch_parent" && ! -L "$scratch_parent" ]] || {
        printf 'job-owned /ptmp directory is unsafe or already exists\n' >&2
        return 2
    }
    mkdir -m 0700 -- "$scratch_parent" || {
        printf 'cannot create job-owned /ptmp directory\n' >&2
        return 2
    }
    SCRATCH_PARENT_CLEANUP="$scratch_parent"
    SCRATCH_PARENT="$(realpath -e "$scratch_parent")"
    [[ "$SCRATCH_PARENT" =~ $SAFE_PATH_RE && -d "$SCRATCH_PARENT" && \
        ! -L "$SCRATCH_PARENT" && -O "$SCRATCH_PARENT" ]] || {
        printf 'job-owned /ptmp directory failed validation\n' >&2
        return 2
    }
    printf 'scratch_parent_source=job_owned_ptmp\n'
    [[ "$(stat -c '%d' "$SCRATCH_PARENT")" == \
        "$(stat -c '%d' "$DATABASE_ROOT")" ]] || {
        printf 'database staging and durable root must share /ptmp filesystem\n' >&2
        return 2
    }
    SCRATCH="${SCRATCH_PARENT%/}/nf-gtd-database-${SLURM_JOB_ID}-${RUN_ID}"
    [[ "$SCRATCH" == "$SCRATCH_PARENT"/* ]] || {
        printf 'database scratch escaped its parent\n' >&2
        return 2
    }
    mkdir "$SCRATCH"
    SOURCE="$SCRATCH/source"
    mkdir "$SOURCE" "$SCRATCH/tmp"
    cp -a "$RUN/source/." "$SOURCE/"
    chmod -R u+w "$SOURCE"
    [[ "$(git -C "$SOURCE" rev-parse HEAD)" == "$(<"$RUN/state/commit")" ]] || {
        printf 'database scratch checkout commit mismatch\n' >&2
        return 2
    }

    [[ -f "$RUN/state/hpc-environment-status" && \
        "$(<"$RUN/state/hpc-environment-status")" == ready ]] || {
        printf 'staged HPC environment readiness record is absent\n' >&2
        return 2
    }
    source_bundle="$RUN/artifacts/database/source_bundle.json"
    [[ -f "$source_bundle" && ! -L "$source_bundle" ]] || {
        printf 'staged database source bundle is absent or unsafe\n' >&2
        return 2
    }
    source_bundle_sha256="$(<"$RUN/state/database-source-bundle-sha256")"
    [[ "$source_bundle_sha256" =~ $CHECKSUM_RE ]] || {
        printf 'recorded database source bundle checksum is invalid\n' >&2
        return 2
    }
    actual_source_bundle_sha256="$(sha256sum "$source_bundle" | awk '{print $1}')"
    [[ "$actual_source_bundle_sha256" == "$source_bundle_sha256" ]] || {
        printf 'database source bundle changed after login-node staging\n' >&2
        return 2
    }
    export TMPDIR="$SCRATCH/tmp"
    printf 'phase=pixi_verify_offline profile=database\n'
    cd "$SOURCE"
    "$PIXI_BIN" install \
        --environment hpc \
        --frozen \
        --offline \
        --no-progress
    gtd="$SOURCE/.pixi/envs/hpc/bin/genome-to-diffraction"
    real_aria2="$SOURCE/.pixi/envs/hpc/bin/aria2c"
    [[ -x "$gtd" && -x "$real_aria2" ]] || {
        printf 'locked database executables are unavailable\n' >&2
        return 2
    }

    wrapper_bin="$SCRATCH/tool-wrappers"
    mkdir "$wrapper_bin"
    cat > "$wrapper_bin/aria2c" <<EOF
#!/usr/bin/env bash
exec "$real_aria2" --no-conf=true "\$@"
EOF
    chmod 0555 "$wrapper_bin/aria2c"
    export PATH="$wrapper_bin:$SOURCE/.pixi/envs/hpc/bin:/usr/bin:/bin"

    PHASE=preflight
    printf 'phase=database_preflight profile=database\n'
    "$gtd" --log-format json --no-progress databases preflight \
        --database-root "$DATABASE_ROOT" \
        --scratch-root "$SCRATCH" \
        --report "$RUN/artifacts/database/preflight.json" \
        --storage-limit-bytes "$STORAGE_LIMIT_BYTES" \
        --minimum-free-bytes "$MINIMUM_FREE_BYTES" \
        --required-database-capacity-bytes "$REQUIRED_DATABASE_CAPACITY_BYTES" \
        --minimum-scratch-free-bytes "$MINIMUM_SCRATCH_FREE_BYTES" \
        --source-bundle "$source_bundle"

    PHASE=database
    printf 'phase=database_prepare profile=database\n'
    "$gtd" --log-format json --no-progress databases prepare \
        --database-root "$DATABASE_ROOT" \
        --scratch-root "$SCRATCH" \
        --minimum-scratch-free-bytes "$MINIMUM_SCRATCH_FREE_BYTES" \
        --source-bundle "$source_bundle" \
        --manifest "$DATABASE_MANIFEST" \
        --prepare-pdb-foldseek \
        --prepare-pdb-sequences \
        --prepare-prostt5 \
        --initialise-coordinate-cache \
        --storage-limit-bytes "$STORAGE_LIMIT_BYTES" \
        --minimum-free-bytes "$MINIMUM_FREE_BYTES" \
        --lock-timeout-seconds 300 \
        --threads "$SLURM_CPUS_PER_TASK"

    database_manifest_sha256="$(sha256sum "$DATABASE_MANIFEST" | awk '{print $1}')"
    [[ "$database_manifest_sha256" =~ $CHECKSUM_RE ]] || {
        printf 'database manifest checksum failed\n' >&2
        return 2
    }
    cp -- "$DATABASE_MANIFEST" "$RUN/artifacts/database/database_manifest.json"
    printf '%s  %s\n' "$database_manifest_sha256" "$(basename "$DATABASE_MANIFEST")" \
        > "$RUN/artifacts/database/database_manifest.sha256"

    PHASE=verification
    printf 'phase=database_full_verify profile=database\n'
    "$gtd" --log-format json --no-progress databases prepare \
        --database-root "$DATABASE_ROOT" \
        --scratch-root "$SCRATCH" \
        --minimum-scratch-free-bytes "$MINIMUM_SCRATCH_FREE_BYTES" \
        --source-bundle "$source_bundle" \
        --manifest "$RUN/artifacts/database/database_manifest.full-verified.json" \
        --expected-manifest "$DATABASE_MANIFEST" \
        --expected-manifest-sha256 "$database_manifest_sha256" \
        --prepare-pdb-foldseek \
        --prepare-pdb-sequences \
        --prepare-prostt5 \
        --initialise-coordinate-cache \
        --verify-only \
        --full-verify \
        --storage-limit-bytes "$STORAGE_LIMIT_BYTES" \
        --minimum-free-bytes "$MINIMUM_FREE_BYTES" \
        --lock-timeout-seconds 300 \
        --threads "$SLURM_CPUS_PER_TASK"

    PHASE=software
    [[ "$(git -C "$SOURCE" rev-parse HEAD)" == "$(<"$RUN/state/commit")" ]] || {
        printf 'database source commit changed during execution\n' >&2
        return 3
    }
    [[ -z "$(git -C "$SOURCE" status --porcelain=v1 --untracked-files=no)" ]] || {
        printf 'database execution modified tracked source files\n' >&2
        return 3
    }
    printf 'database_status=prepared_and_full_verified\n'
}

trap finalise EXIT
trap 'handle_signal 143 TERM' TERM
trap 'handle_signal 130 INT' INT

if [[ "$PROFILE" == database ]]; then
    mkdir -p "$RUN/artifacts/database"
else
    mkdir -p "$SCRATCH" "$SCRATCH/tmp"
fi
exec > "$RUN/logs/${PROFILE}.log" 2>&1

printf 'run_id=%s\n' "$RUN_ID"
printf 'profile=%s\n' "$PROFILE"
printf 'job_id=%s\n' "$SLURM_JOB_ID"
printf 'compute_host=%s\n' "$(hostname -f)"
printf 'source_commit=%s\n' "$(<"$RUN/state/commit")"
printf 'pixi_executable=%s\n' "$PIXI_BIN"
"$PIXI_BIN" --version

export PIXI_CACHE_DIR="$ROOT/_cache/pixi"
if [[ "$PROFILE" != database ]]; then
    export TMPDIR="$SCRATCH/tmp"
fi
export NXF_ANSI_LOG=false
export NXF_DISABLE_CHECK_LATEST=true

case "$PROFILE" in
    smoke) run_smoke ;;
    p0) run_p0 ;;
    p1) run_p1 ;;
    p2) run_p2 ;;
    p2-diverse) run_p2_diverse ;;
    p2-control) run_p2_control ;;
    control-slice) run_control_slice ;;
    control-matrix) run_control_matrix ;;
    m6-inputs) run_m6_inputs ;;
    m6-nextflow-smoke) run_m6_nextflow_smoke ;;
    m6-operational|m6-leakage) run_m6_scientific ;;
    m4-copy) run_m4_copy ;;
