        return 4
    }
    mapping_count="$(awk 'NF { count++ } END { print count + 0 }' \
        "$P2_DIVERSE_REGISTRATION_OUT/coordinate_hit_mappings.jsonl")"
    (( mapping_count >= 1 && mapping_count <= 25 )) || {
        printf 'P2-diverse registration escaped the 1..25 mapping bound\n' >&2
        return 4
    }

    sha256sum \
        "$RUN/state/p1-login-prefetch.sha256" \
        "$RUN/state/p2-diverse-login-stage.sha256" \
        "$P0_CONFIG_PATH" \
        "$PIPELINE_CONFIG" \
        "$P2_MTZ" \
        "$P0_OUT/preflight/mtz_preflight.jsonl" \
        "$P0_OUT/matthews/matthews_hypotheses.jsonl" \
        "$P1_PREFETCH_OUT/coordinate_sources.jsonl" \
        "$P1_CATALOGUE_OUT/sequence_groups.jsonl" \
        "$P1_MODEL_OUT/predicted_model_preparation/processed_models.jsonl" \
        "$P1_MODEL_OUT/predicted_model_preparation/model_preparation_manifest.json" \
        "$login_search_hits" \
        "$P2_DIVERSE_REGISTRATION_OUT/coordinate_sources.jsonl" \
        "$P2_DIVERSE_REGISTRATION_OUT/coordinate_hit_mappings.jsonl" \
        "$P2_DIVERSE_REGISTRATION_OUT/registration_manifest.json" \
        "$PHENIX_MANIFEST" \
        > "$qualification/p2-diverse-input-checksums.sha256"

    export JAVA_CMD
    export NXF_HOME="$RUN/cache/nextflow-home"
    cd "$RUN/execution"
    printf 'phase=p2_diverse_model_first_run profile=p2-diverse\n'
    run_p2_diverse_model_nextflow first
    cp -a \
        "$P2_DIVERSE_MODEL_OUT/pipeline_info" \
        "$qualification/p2-diverse-model-first-pipeline-info"
    printf 'phase=p2_diverse_model_resume_run profile=p2-diverse\n'
    run_p2_diverse_model_nextflow resume -resume
    cp -a \
        "$P2_DIVERSE_MODEL_OUT/pipeline_info" \
        "$qualification/p2-diverse-model-resume-pipeline-info"

    [[ -s "$P2_DIVERSE_MODEL_OUT/experimental_model_preparation/processed_models.jsonl" && \
       -s "$P2_DIVERSE_MODEL_OUT/experimental_model_preparation/model_preparation_manifest.json" ]] || {
        printf 'P2-diverse experimental-model outputs were not produced\n' >&2
        return 4
    }
    model_count="$(awk 'NF { count++ } END { print count + 0 }' \
        "$P2_DIVERSE_MODEL_OUT/experimental_model_preparation/processed_models.jsonl")"
    [[ "$model_count" -eq "$mapping_count" ]] || {
        printf 'P2-diverse model/mapping count differs: models=%s mappings=%s\n' \
            "$model_count" "$mapping_count" >&2
        return 4
    }

    model_first_trace="$qualification/p2-diverse-model-first-pipeline-info/trace.tsv"
    model_resume_trace="$qualification/p2-diverse-model-resume-pipeline-info/trace.tsv"
    [[ -f "$model_first_trace" && -f "$model_resume_trace" ]] || {
        printf 'P2-diverse model first/resume traces were not produced\n' >&2
        return 4
    }
    cache_counts="$(awk -F '\t' '
        NR == 1 {
            for (i = 1; i <= NF; i++) if ($i == "status") status_column = i
            next
        }
        status_column > 0 { total++; if ($status_column == "CACHED") cached++ }
        END { printf "%d %d", total, cached }
    ' "$model_resume_trace")"
    read -r model_total model_cached <<< "$cache_counts"
    [[ "$model_total" -eq 1 && "$model_cached" -eq 1 ]] || {
        printf 'P2-diverse model resume was not fully cached: total=%s cached=%s\n' \
            "$model_total" "$model_cached" >&2
        return 4
    }
    cat > "$qualification/p2-diverse-model-resume-check.json" <<EOF
{
  "schema_version": "1.0",
  "run_id": "$RUN_ID",
  "profile": "p2-diverse",
  "process_count": $model_total,
  "cached_process_count": $model_cached,
  "all_model_processes_cached": true
}
EOF

    printf 'phase=p2_diverse_first_copy_first_run profile=p2-diverse crystal=CD6QS2P2G1_5\n'
    run_p2_diverse_first_copy_nextflow first
    cp -a \
        "$P2_DIVERSE_FIRST_COPY_OUT/pipeline_info" \
        "$qualification/p2-diverse-first-copy-first-pipeline-info"
    printf 'phase=p2_diverse_first_copy_resume_run profile=p2-diverse crystal=CD6QS2P2G1_5\n'
    run_p2_diverse_first_copy_nextflow resume -resume
    cp -a \
        "$P2_DIVERSE_FIRST_COPY_OUT/pipeline_info" \
        "$qualification/p2-diverse-first-copy-resume-pipeline-info"

    hypothesis_count="$(awk 'NF { count++ } END { print count + 0 }' \
        "$P2_DIVERSE_FIRST_COPY_OUT/diverse_first_copy_funnel/mr_hypotheses.jsonl")"
    (( hypothesis_count >= 1 && hypothesis_count <= 25 )) || {
        printf 'P2-diverse hypothesis count escaped the 1..25 bound: %s\n' \
            "$hypothesis_count" >&2
        return 4
    }
    predicted_count="$(grep -c \
        '"structural_source_class":"predicted"' \
        "$P2_DIVERSE_FIRST_COPY_OUT/diverse_first_copy_funnel/mr_hypotheses.jsonl" || true)"
    experimental_count="$(grep -c \
        '"structural_source_class":"experimental"' \
        "$P2_DIVERSE_FIRST_COPY_OUT/diverse_first_copy_funnel/mr_hypotheses.jsonl" || true)"
    (( predicted_count >= 1 && experimental_count >= 1 )) || {
        printf 'P2-diverse funnel did not retain both predicted and experimental evidence\n' >&2
        return 4
    }
    mapfile -t result_directories < <(
        find "$P2_DIVERSE_FIRST_COPY_OUT" \
            -mindepth 1 \
            -maxdepth 1 \
            -type d \
            -name 'first_copy_phaser_mrhyp_*' \
            -print | LC_ALL=C sort
    )
    result_count="${#result_directories[@]}"
    [[ "$result_count" -eq "$hypothesis_count" ]] || {
        printf 'P2-diverse result/hypothesis count differs: results=%s hypotheses=%s\n' \
            "$result_count" "$hypothesis_count" >&2
        return 4
    }

    results_tmp="$qualification/p2-diverse-results.jsonl.tmp.$$"
    commands_tmp="$qualification/p2-diverse-commands.jsonl.tmp.$$"
    tails_tmp="$qualification/p2-diverse-log-tails.txt.tmp.$$"
    : > "$results_tmp"
    : > "$commands_tmp"
    : > "$tails_tmp"
    for result_directory in "${result_directories[@]}"; do
        result_json="$result_directory/normalised_mr_result.json"
        result_jsonl="$result_directory/normalised_mr_result.jsonl"
        command_json="$result_directory/phaser_command.json"
        [[ -f "$result_json" && ! -L "$result_json" && \
           -f "$result_jsonl" && ! -L "$result_jsonl" && \
           -f "$command_json" && ! -L "$command_json" ]] || {
            printf 'P2-diverse result bundle is incomplete: %s\n' \
                "$(basename "$result_directory")" >&2
            return 4
        }
        "$GTD" --log-format json --no-progress contract validate \
            normalised-mr-result "$result_json"
        "$GTD" --log-format json --no-progress contract validate \
            normalised-mr-result "$result_jsonl" --format json
        execution_status="$(sed -n \
            's/.*"execution_status":"\([^"]*\)".*/\1/p' "$result_jsonl")"
        pretty_execution_status="$(sed -n \
            's/.*"execution_status"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "$result_json")"
        expected_hypothesis="${result_directory##*/first_copy_phaser_}"
        actual_hypothesis="$(sed -n \
            's/.*"hypothesis_id":"\([^"]*\)".*/\1/p' "$result_jsonl")"
        pretty_hypothesis="$(sed -n \
            's/.*"hypothesis_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "$result_json")"
        [[ "$execution_status" == "$pretty_execution_status" && \
           "$actual_hypothesis" == "$expected_hypothesis" && \
           "$pretty_hypothesis" == "$expected_hypothesis" ]] || {
            printf 'P2-diverse JSON/JSONL result identity differs: %s\n' \
                "$expected_hypothesis" >&2
            return 4
        }
        case "$execution_status" in
            completed_hit)
                completed_hit_count=$((completed_hit_count + 1))
                ;;
            completed_no_hit)
                completed_no_hit_count=$((completed_no_hit_count + 1))
                ;;
            *)
                printf 'P2-diverse result did not complete scientifically: status=%s\n' \
                    "$execution_status" >&2
                return 4
                ;;
        esac
        cat -- "$result_jsonl" >> "$results_tmp"
        tr -d '\n' < "$command_json" >> "$commands_tmp"
        printf '\n' >> "$commands_tmp"
        printf '{"result_directory":"%s","tail_lines":200}\n' \
            "$(basename "$result_directory")" >> "$tails_tmp"
        if [[ -f "$result_directory/PHASER.log" && \
              ! -L "$result_directory/PHASER.log" ]]; then
            tail -n 200 "$result_directory/PHASER.log" >> "$tails_tmp"
        fi
        if [[ -f "$result_directory/phenix.phaser.capture.log" && \
              ! -L "$result_directory/phenix.phaser.capture.log" ]]; then
            tail -n 200 "$result_directory/phenix.phaser.capture.log" >> "$tails_tmp"
        fi
    done
    mv -f -- "$results_tmp" "$qualification/p2-diverse-results.jsonl"
    mv -f -- "$commands_tmp" "$qualification/p2-diverse-commands.jsonl"
    mv -f -- "$tails_tmp" "$qualification/p2-diverse-log-tails.txt"

    printf 'phase=p2_diverse_review_package profile=p2-diverse crystal=CD6QS2P2G1_5\n'
    review_directory="$qualification/p2-diverse-review"
    "$GTD" --log-format json --no-progress review build-mr-seed \
        --hypotheses \
        "$P2_DIVERSE_FIRST_COPY_OUT/diverse_first_copy_funnel/mr_hypotheses.jsonl" \
        --results "$qualification/p2-diverse-results.jsonl" \
        --result-root "$P2_DIVERSE_FIRST_COPY_OUT" \
        --funnel-manifest \
        "$P2_DIVERSE_FIRST_COPY_OUT/diverse_first_copy_funnel/funnel_manifest.json" \
        --sequence-groups "$P1_CATALOGUE_OUT/sequence_groups.jsonl" \
        --source-records "$P1_CATALOGUE_OUT/source_records.jsonl" \
        --matthews "$P0_OUT/matthews/matthews_hypotheses.jsonl" \
        --config "$PIPELINE_CONFIG" \
        --outdir "$review_directory"
    review_manifest="$review_directory/mr_seed_review_manifest.json"
    for candidate in \
        "$review_manifest" \
        "$review_directory/mr_seed_candidates.tsv" \
        "$review_directory/mr_seed_candidates.html" \
        "$review_directory/mr_seed_approval_candidates.tsv" \
        "$review_directory/approved_mr_seeds.tsv"; do
        [[ -f "$candidate" && ! -L "$candidate" ]] || {
            printf 'P2-diverse review package is incomplete: %s\n' \
                "$(basename "$candidate")" >&2
            return 4
        }
    done
    review_package_id="$(sed -n \
        's/^[[:space:]]*"package_id":[[:space:]]*"\([^"]*\)",*$/\1/p' \
        "$review_manifest")"
    [[ "$review_package_id" =~ ^reviewpkg_[a-f0-9]{64}$ ]] || {
        printf 'P2-diverse review package ID is invalid\n' >&2
        return 4
    }
    review_manifest_sha256="$(sha256sum "$review_manifest" | awk '{print $1}')"

    first_trace="$qualification/p2-diverse-first-copy-first-pipeline-info/trace.tsv"
    resume_trace="$qualification/p2-diverse-first-copy-resume-pipeline-info/trace.tsv"
    [[ -f "$first_trace" && -f "$resume_trace" ]] || {
        printf 'P2-diverse first-copy traces were not produced\n' >&2
        return 4
    }
    cache_counts="$(awk -F '\t' '
        NR == 1 {
            for (i = 1; i <= NF; i++) if ($i == "status") status_column = i
            next
        }
        status_column > 0 { total++; if ($status_column == "CACHED") cached++ }
        END { printf "%d %d", total, cached }
    ' "$resume_trace")"
    read -r total cached <<< "$cache_counts"
    expected_process_count=$((hypothesis_count + 1))
    [[ "$total" -eq "$expected_process_count" && "$cached" -eq "$total" ]] || {
        printf 'P2-diverse resume was not fully cached: expected=%s total=%s cached=%s\n' \
            "$expected_process_count" "$total" "$cached" >&2
        return 4
    }
    cat > "$qualification/p2-diverse-first-copy-resume-check.json" <<EOF
{
  "schema_version": "1.0",
  "run_id": "$RUN_ID",
  "profile": "p2-diverse",
  "crystal_id": "CD6QS2P2G1_5",
  "process_count": $total,
  "cached_process_count": $cached,
  "hypothesis_count": $hypothesis_count,
  "all_first_copy_processes_cached": true
}
EOF
    cat > "$qualification/p2-diverse-summary.json" <<EOF
{
  "schema_version": "1.0",
  "run_id": "$RUN_ID",
  "profile": "p2-diverse",
  "crystal_id": "CD6QS2P2G1_5",
  "maximum_first_copy_jobs": 25,
  "registered_mapping_count": $mapping_count,
  "experimental_model_count": $model_count,
  "hypothesis_count": $hypothesis_count,
  "predicted_hypothesis_count": $predicted_count,
  "experimental_hypothesis_count": $experimental_count,
  "result_count": $result_count,
  "completed_hit_count": $completed_hit_count,
  "completed_no_hit_count": $completed_no_hit_count,
  "mr_seed_review_package_id": "$review_package_id",
  "mr_seed_review_manifest_sha256": "$review_manifest_sha256",
  "login_pdb_search_sha256": "$login_search_sha256",
  "scheduled_pdb_search_sha256": "$scheduled_search_sha256",
  "all_results_completed_scientifically": true,
  "all_resume_processes_cached": true
}
EOF

    checksums_tmp="$qualification/p2-diverse-artifact-sha256.tsv.tmp.$$"
    printf 'sha256\tpath\n' > "$checksums_tmp"
    for candidate in \
        "$qualification/p2-diverse-summary.json" \
        "$qualification/p2-diverse-results.jsonl" \
        "$qualification/p2-diverse-commands.jsonl" \
        "$qualification/p2-diverse-log-tails.txt" \
        "$qualification/p2-diverse-model-resume-check.json" \
        "$qualification/p2-diverse-first-copy-resume-check.json" \
        "$review_directory/mr_seed_review_manifest.json" \
        "$review_directory/mr_seed_candidates.tsv" \
        "$review_directory/mr_seed_candidates.html" \
        "$review_directory/mr_seed_approval_candidates.tsv" \
        "$review_directory/approved_mr_seeds.tsv" \
        "$P2_DIVERSE_REGISTRATION_OUT/registration_manifest.json" \
        "$P2_DIVERSE_MODEL_OUT/experimental_model_preparation/model_preparation_manifest.json" \
        "$P2_DIVERSE_FIRST_COPY_OUT/diverse_first_copy_funnel/funnel_manifest.json" \
        "$first_trace" \
        "$resume_trace"; do
        checksum="$(sha256sum "$candidate" | awk '{print $1}')"
        relative="${candidate#"$RUN/"}"
        printf '%s\t%s\n' "$checksum" "$relative" >> "$checksums_tmp"
    done
    mv -f -- "$checksums_tmp" \
        "$qualification/p2-diverse-artifact-sha256.tsv"

    PHASE=software
    [[ "$(git -C "$RUN/source" rev-parse HEAD)" == \
        "$(<"$RUN/state/commit")" ]] || {
        printf 'P2-diverse source commit changed during execution\n' >&2
        return 3
    }
    [[ -z "$(git -C "$RUN/source" status --porcelain=v1 --untracked-files=no)" ]] || {
        printf 'P2-diverse execution modified tracked source files\n' >&2
        return 3
    }
    printf 'p2_diverse_status=bounded_multi_source_first_copy_complete_and_resume_cached\n'
}

run_p2_control_nextflow() {
    local label="$1"
    shift
    "$NEXTFLOW" \
        -log "$RUN/logs/nextflow-p2-control-${label}.log" \
        run "$RUN/source/screen_first_copy_controls.nf" \
        "$@" \
        -profile viper-cpu \
        --control_bundle "$P2_CONTROL_BUNDLE" \
        --sequence_groups "$P2_CONTROL_CATALOGUE/sequence_groups.jsonl" \
        --preflight "$P2_CONTROL_PREFLIGHT/mtz_preflight.jsonl" \
        --mtz "$P2_CONTROL_MTZ" \
        --phenix_manifest "$PHENIX_MANIFEST" \
        --outdir "$P2_CONTROL_RESULTS" \
        --cache_root "$RUN/cache/p2-control-first-copy"
}

run_p2_control() {
    local qualification="$RUN/artifacts/qualification"
    local control_root="$RUN/artifacts/p2-control/public-control"
    local cache_counts total cached result_directory result_jsonl role status
    local llg tfz placed packed positive_status="" negative_status=""
    local positive_pass=false negative_pass=false separated=false
    local positive_llg="null" positive_tfz="null"
    local negative_llg="null" negative_tfz="null"
    local results_tmp="$qualification/p2-control-results.jsonl.tmp.$$"
    local commands_tmp="$qualification/p2-control-commands.jsonl.tmp.$$"
    local tails_tmp="$qualification/p2-control-log-tails.txt.tmp.$$"
    local checksums_tmp candidate checksum relative
    local -a result_directories=()

    load_p0_config
    P2_CONTROL_CATALOGUE="$RUN/artifacts/p2-control/catalogue"
    P2_CONTROL_PREFLIGHT="$RUN/artifacts/p2-control/preflight"
    P2_CONTROL_BUNDLE="$RUN/artifacts/p2-control/control-bundle"
    P2_CONTROL_RESULTS="$RUN/artifacts/p2-control/first-copy"
    P2_CONTROL_MTZ="$control_root/derived/8OOX-autoproc-deposited.mtz"
    mkdir -p "$qualification" "$P2_CONTROL_PREFLIGHT" \
        "$P2_CONTROL_RESULTS" "$RUN/cache/p2-control-first-copy" \
        "$RUN/execution"

    cd "$RUN/source"
    [[ -f "$RUN/state/hpc-environment-status" && \
        "$(<"$RUN/state/hpc-environment-status")" == ready ]] || {
        printf 'locked P2-control environment was not prepared during staging\n' >&2
        return 2
    }
    GTD="$RUN/source/.pixi/envs/hpc/bin/genome-to-diffraction"
    NEXTFLOW="$RUN/source/.pixi/envs/hpc/bin/nextflow"
    JAVA_CMD="$RUN/source/.pixi/envs/hpc/lib/jvm/bin/java"
    [[ -x "$GTD" && -x "$NEXTFLOW" && -x "$JAVA_CMD" ]] || return 2
    export PATH="$RUN/source/.pixi/envs/hpc/bin:${PATH:-/usr/bin:/bin}"
    export JAVA_CMD NXF_HOME="$RUN/cache/nextflow-home"

    PHASE=test
    printf 'phase=p2_control_stage_verify profile=p2-control\n'
    [[ -f "$RUN/state/p2-control-login-stage.sha256" ]] || return 2
    sha256sum -c "$RUN/state/p2-control-login-stage.sha256"
    printf 'phase=p2_control_phenix_verify profile=p2-control\n'
    "$GTD" --log-format json --no-progress phenix verify \
        --manifest "$PHENIX_MANIFEST" \
        --verification-log "$qualification/p2-control-phenix-verification.log" \
        --no-command-timeout
    printf 'phase=p2_control_mtz_preflight profile=p2-control\n'
    "$GTD" --log-format json --no-progress diffraction preflight \
        --crystals "$control_root/manifests/crystals.json" \
        --phenix-manifest "$PHENIX_MANIFEST" \
        --no-xtriage-timeout \
        --outdir "$P2_CONTROL_PREFLIGHT"
    [[ "$(sha256sum "$EXPECTED_DATABASE_MANIFEST" | awk '{print $1}')" == \
        "$(<"$RUN/state/database-manifest-sha256")" ]] || return 2
    printf 'phase=p2_control_bundle profile=p2-control\n'
    "$GTD" --log-format json --no-progress benchmark build-first-copy-controls \
        --specification \
        "$RUN/source/benchmarks/public-controls/pdb_8oox_first_copy_controls.yaml" \
        --public-control-preparation "$control_root/manifests/preparation.json" \
        --database-manifest "$EXPECTED_DATABASE_MANIFEST" \
        --sequence-groups "$P2_CONTROL_CATALOGUE/sequence_groups.jsonl" \
        --preflight "$P2_CONTROL_PREFLIGHT/mtz_preflight.jsonl" \
        --outdir "$P2_CONTROL_BUNDLE"
    sha256sum "$RUN/state/p2-control-login-stage.sha256" \
        "$RUN/source/benchmarks/public-controls/pdb_8oox_first_copy_controls.yaml" \
        "$control_root/manifests/preparation.json" \
        "$EXPECTED_DATABASE_MANIFEST" \
        "$P2_CONTROL_CATALOGUE/sequence_groups.jsonl" \
        "$P2_CONTROL_PREFLIGHT/mtz_preflight.jsonl" \
        "$P2_CONTROL_BUNDLE/control_pair_manifest.json" \
        "$P2_CONTROL_MTZ" "$PHENIX_MANIFEST" \
        > "$qualification/p2-control-input-checksums.sha256"

    cd "$RUN/execution"
    printf 'phase=p2_control_first_run profile=p2-control\n'
    run_p2_control_nextflow first
    cp -a "$P2_CONTROL_RESULTS/pipeline_info" \
        "$qualification/p2-control-first-pipeline-info"
    printf 'phase=p2_control_resume_run profile=p2-control\n'
    run_p2_control_nextflow resume -resume
    cp -a "$P2_CONTROL_RESULTS/pipeline_info" \
        "$qualification/p2-control-resume-pipeline-info"
    cache_counts="$(awk -F '\t' '
        NR == 1 { for (i = 1; i <= NF; i++) if ($i == "status") column = i; next }
        column > 0 { total++; if ($column == "CACHED") cached++ }
        END { printf "%d %d", total, cached }
    ' "$qualification/p2-control-resume-pipeline-info/trace.tsv")"
    read -r total cached <<< "$cache_counts"
    [[ "$total" -eq 2 && "$cached" -eq 2 ]] || return 4

    mapfile -t result_directories < <(
        find "$P2_CONTROL_RESULTS" -mindepth 1 -maxdepth 1 -type d \
            -name 'first_copy_phaser_mrhyp_*' -print | LC_ALL=C sort
    )
    [[ "${#result_directories[@]}" -eq 2 ]] || return 4
    : > "$results_tmp"
    : > "$commands_tmp"
    : > "$tails_tmp"
    for result_directory in "${result_directories[@]}"; do
        result_jsonl="$result_directory/normalised_mr_result.jsonl"
        [[ -s "$result_jsonl" && ! -L "$result_jsonl" ]] || return 4
        role="$($GTD --no-progress contract canonicalise mr-hypothesis \
            "$P2_CONTROL_BUNDLE/hypotheses/${result_directory##*/first_copy_phaser_}.jsonl" \
            --format json | sed -n 's/.*"control_role":"\([^"]*\)".*/\1/p')"
        status="$(sed -n 's/.*"execution_status":"\([^"]*\)".*/\1/p' "$result_jsonl")"
        llg="$(sed -n 's/.*"llg":\([^,]*\).*/\1/p' "$result_jsonl")"
        tfz="$(sed -n 's/.*"tfz":\([^,]*\).*/\1/p' "$result_jsonl")"
        placed="$(sed -n 's/.*"placed_copy_count":\([0-9]*\).*/\1/p' "$result_jsonl")"
        packed="$(sed -n 's/.*"top_solution_packed":\([^,}]*\).*/\1/p' "$result_jsonl")"
        case "$role" in
            known_positive)
                positive_status="$status"; positive_llg="$llg"; positive_tfz="$tfz"
                if [[ "$status" == completed_hit && "$placed" == 1 && \
                      "$packed" == true ]]; then
                    positive_pass=true
                fi
                ;;
            deliberate_unrelated_negative)
                negative_status="$status"; negative_llg="$llg"; negative_tfz="$tfz"
                if [[ "$status" == completed_hit && "$placed" == 1 && \
                      "$packed" == true ]]; then
                    negative_pass=true
                fi
                ;;
            *) return 4 ;;
        esac
        cat -- "$result_jsonl" >> "$results_tmp"
        [[ -s "$result_directory/phaser_command.json" && \
