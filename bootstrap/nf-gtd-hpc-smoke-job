#!/usr/bin/env bash
# Fixed Slurm job body for the foundation-only smoke profile.

set -euo pipefail
umask 077

RUN_ID_RE='^gtd-smoke-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}-[0-9a-f]{8}$'
INTEGER_RE='^[0-9]+$'
SAFE_PATH_RE='^/[A-Za-z0-9._/-]+$'

# Slurm executes a spooled copy, so $0 no longer identifies _tooling. The fixed
# dispatcher derives the trusted run root and passes it as the second argument.
RUN_ID="${1-}"
ROOT="${2-}"
[[ "$RUN_ID" =~ $RUN_ID_RE ]] || { printf 'invalid managed run ID\n' >&2; exit 2; }
[[ "${SLURM_JOB_ID:-}" =~ $INTEGER_RE ]] || { printf 'missing Slurm job ID\n' >&2; exit 2; }
[[ "$ROOT" =~ $SAFE_PATH_RE && -d "$ROOT/runs" && -d "$ROOT/_locks" ]] || {
    printf 'invalid managed run root\n' >&2
    exit 2
}
[[ "$(cd "$ROOT" && pwd -P)" == "$ROOT" ]] || {
    printf 'managed run root is not canonical\n' >&2
    exit 2
}

RUN="$ROOT/runs/$RUN_ID"
[[ -d "$RUN/source" && -d "$RUN/state" && -d "$RUN/logs" ]] || {
    printf 'managed run is incomplete\n' >&2
    exit 2
}
PIXI_BIN="$(<"$RUN/state/pixi-bin")"
[[ "$PIXI_BIN" =~ $SAFE_PATH_RE && -x "$PIXI_BIN" ]] || {
    printf 'recorded Pixi executable is invalid\n' >&2
    exit 2
}

SCRATCH_PARENT="${SLURM_TMPDIR:-/dev/shm}"
[[ "$SCRATCH_PARENT" =~ $SAFE_PATH_RE ]] || {
    printf 'Slurm scratch parent is not a safe absolute path\n' >&2
    exit 2
}
SCRATCH="${SCRATCH_PARENT%/}/nf-gtd-${SLURM_JOB_ID}-${RUN_ID}"
SOURCE="$SCRATCH/source"
STARTED_AT="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
PHASE=environment

atomic_text() {
    local path="$1"
    local value="$2"
    local temporary="${path}.tmp.$$"
    printf '%s\n' "$value" > "$temporary"
    mv -f -- "$temporary" "$path"
}

finalise() {
    local exit_code="$?"
    local failure_class scheduler_state ended_at result_tmp active_run="" active_job=""
    local cleanup_failed=false
    trap - EXIT
    set +e
    if (( exit_code == 0 )); then
        failure_class=success
        scheduler_state=COMPLETED
    elif [[ "$PHASE" == environment ]]; then
        failure_class=environment_failure
        scheduler_state=FAILED
    elif [[ "$PHASE" == test ]]; then
        failure_class=test_failure
        scheduler_state=FAILED
    else
        failure_class=software_failure
        scheduler_state=FAILED
    fi
    exec 9>"$ROOT/_locks/submit.lock"
    flock -x 9
    if [[ -f "$ROOT/_locks/active-smoke" ]]; then
        read -r active_run active_job < "$ROOT/_locks/active-smoke" || true
        if [[ "$active_run" == "$RUN_ID" && "$active_job" == "$SLURM_JOB_ID" ]]; then
            rm -f -- "$ROOT/_locks/active-smoke"
        fi
    fi
    if [[ -e "$SCRATCH" ]]; then
        chmod -R u+w "$SCRATCH" 2>/dev/null || true
        rm -rf -- "$SCRATCH"
        [[ ! -e "$SCRATCH" ]] || cleanup_failed=true
    fi
    if [[ "$cleanup_failed" == true ]]; then
        printf 'scratch_cleanup_status=failed\n' >&2
        if (( exit_code == 0 )); then
            exit_code=6
            failure_class=filesystem_failure
            scheduler_state=FAILED
        fi
    else
        printf 'scratch_cleanup_status=success\n'
    fi
    ended_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    atomic_text "$RUN/state/exit-code" "$exit_code"
    atomic_text "$RUN/state/failure-class" "$failure_class"
    atomic_text "$RUN/state/phase" "completed"
    result_tmp="$RUN/state/job-result.json.tmp.$$"
    cat > "$result_tmp" <<EOF
{
  "schema_version": "1.0",
  "run_id": "$RUN_ID",
  "job_id": "$SLURM_JOB_ID",
  "started_at": "$STARTED_AT",
  "completed_at": "$ended_at",
  "scheduler_state": "$scheduler_state",
  "exit_code": $exit_code,
  "failure_class": "$failure_class",
  "standard_output": "logs/slurm-${SLURM_JOB_ID}.out",
  "standard_error": "logs/slurm-${SLURM_JOB_ID}.out",
  "application_log": "logs/smoke.log",
  "structured_test_reports": [],
  "retained_artifacts": []
}
EOF
    mv -f -- "$result_tmp" "$RUN/state/job-result.json"
    printf '{"event":"job_completed","timestamp":"%s"}\n' "$ended_at" \
        >> "$RUN/events.jsonl"
    exit "$exit_code"
}
trap finalise EXIT

mkdir -p "$SCRATCH" "$SOURCE" "$SCRATCH/tmp"
exec > "$RUN/logs/smoke.log" 2>&1

printf 'run_id=%s\n' "$RUN_ID"
printf 'job_id=%s\n' "$SLURM_JOB_ID"
printf 'compute_host=%s\n' "$(hostname -f)"
printf 'source_commit=%s\n' "$(<"$RUN/state/commit")"
printf 'pixi_executable=%s\n' "$PIXI_BIN"
"$PIXI_BIN" --version

cp -a "$RUN/source/." "$SOURCE/"
chmod -R u+w "$SOURCE"
[[ "$(git -C "$SOURCE" rev-parse HEAD)" == "$(<"$RUN/state/commit")" ]] || {
    printf 'scratch checkout commit mismatch\n' >&2
    exit 2
}

export PIXI_CACHE_DIR="$ROOT/_cache/pixi"
export TMPDIR="$SCRATCH/tmp"
export NXF_ANSI_LOG=false
export NXF_DISABLE_CHECK_LATEST=true
export NXF_HOME="$SCRATCH/nextflow-home"

cd "$SOURCE"
printf 'phase=pixi_install\n'
"$PIXI_BIN" install --environment default --frozen

PHASE=test
printf 'phase=foundation_check\n'
"$PIXI_BIN" run --environment default check

PHASE=software
if [[ -n "$(git status --porcelain=v1 --untracked-files=no)" ]]; then
    printf 'foundation check modified tracked source files\n' >&2
    exit 3
fi

PHASE=success
printf 'smoke_status=success\n'
