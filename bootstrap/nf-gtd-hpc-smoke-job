run_p1() {
    local first_trace resume_trace model_first_trace model_resume_trace
    local model_cache_counts model_total model_cached model_record_count
    local qualification="$RUN/artifacts/qualification"
    local control_spec="$RUN/source/benchmarks/public-controls/pdb_8oox.yaml"
    PILOT_AFDB_MAP="$RUN/source/benchmarks/public-controls/afdb_accessions.tsv"
    P1_OUT="$RUN/artifacts/p1"
    P1_CATALOGUE_OUT="$P1_OUT/catalogue"
    P1_PREFETCH_OUT="$P1_OUT/afdb-login-prefetch"
    P1_DISCOVERY_OUT="$P1_OUT/discovery"
    P1_MODEL_OUT="$P1_OUT/model-preparation"
    mkdir -p \
        "$qualification" \
        "$P1_CATALOGUE_OUT" \
        "$P1_DISCOVERY_OUT" \
        "$P1_MODEL_OUT" \
        "$RUN/cache/p1-nextflow" \
        "$RUN/cache/p1-model-nextflow" \
        "$RUN/execution"

    load_p0_config
    cp -- "$P0_CONFIG_PATH" "$qualification/p1.paths.snapshot"
    sha256sum \
        "$P0_CONFIG_PATH" \
        "$CATALOGUES" \
        "$PIPELINE_CONFIG" \
        "$EXPECTED_DATABASE_MANIFEST" \
        "$PHENIX_MANIFEST" \
        "$control_spec" \
        "$PILOT_AFDB_MAP" \
        "$RUN/state/p1-login-prefetch.sha256" \
        > "$qualification/p1-input-checksums.sha256"

    cd "$RUN/source"
    printf 'phase=pixi_environment_verify profile=p1\n'
    [[ -f "$RUN/state/hpc-environment-status" && \
        "$(<"$RUN/state/hpc-environment-status")" == ready ]] || {
        printf 'locked P1 environment was not prepared during staging\n' >&2
        return 2
    }
    GTD="$RUN/source/.pixi/envs/hpc/bin/genome-to-diffraction"
    NEXTFLOW="$RUN/source/.pixi/envs/hpc/bin/nextflow"
    JAVA_CMD="$RUN/source/.pixi/envs/hpc/lib/jvm/bin/java"
    [[ -x "$GTD" && -x "$NEXTFLOW" && -x "$JAVA_CMD" ]] || {
        printf 'locked P1 executables are unavailable\n' >&2
        return 2
    }
    export PATH="$RUN/source/.pixi/envs/hpc/bin:${PATH:-/usr/bin:/bin}"
    EXPECTED_DATABASE_SHA256="$(<"$RUN/state/database-manifest-sha256")"
    [[ "$EXPECTED_DATABASE_SHA256" =~ $CHECKSUM_RE ]] || {
        printf 'recorded P1 database manifest checksum is invalid\n' >&2
        return 2
    }
    [[ "$(sha256sum "$EXPECTED_DATABASE_MANIFEST" | awk '{print $1}')" == \
        "$EXPECTED_DATABASE_SHA256" ]] || {
        printf 'P1 database manifest changed after staging\n' >&2
        return 2
    }

    PHASE=test
    printf 'phase=p1_login_prefetch_verify profile=p1\n'
    [[ -f "$RUN/state/p1-login-prefetch.sha256" ]] || {
        printf 'P1 login-prefetch checksum record is absent\n' >&2
        return 2
    }
    sha256sum -c "$RUN/state/p1-login-prefetch.sha256"
    [[ "$(awk 'NF { count++ } END { print count + 0 }' \
        "$P1_PREFETCH_OUT/coordinate_sources.jsonl")" -eq 1 ]] || {
        printf 'P1 login prefetch no longer contains exactly one coordinate\n' >&2
        return 4
    }

    export JAVA_CMD
    export NXF_HOME="$RUN/cache/nextflow-home"
    cd "$RUN/execution"
    printf 'phase=p1_first_run profile=p1\n'
    run_p1_nextflow first
    cp -a \
        "$P1_DISCOVERY_OUT/pipeline_info" \
        "$qualification/p1-first-pipeline-info"

    printf 'phase=p1_resume_run profile=p1\n'
    run_p1_nextflow resume -resume
    cp -a \
        "$P1_DISCOVERY_OUT/pipeline_info" \
        "$qualification/p1-resume-pipeline-info"

    printf 'phase=p1_model_first_run profile=p1\n'
    run_p1_model_nextflow first
    cp -a \
        "$P1_MODEL_OUT/pipeline_info" \
        "$qualification/p1-model-first-pipeline-info"

    printf 'phase=p1_model_resume_run profile=p1\n'
    run_p1_model_nextflow resume -resume
    cp -a \
        "$P1_MODEL_OUT/pipeline_info" \
        "$qualification/p1-model-resume-pipeline-info"

    first_trace="$qualification/p1-first-pipeline-info/trace.tsv"
    resume_trace="$qualification/p1-resume-pipeline-info/trace.tsv"
    [[ -f "$first_trace" && -f "$resume_trace" ]] || {
        printf 'P1 first/resume traces were not produced\n' >&2
        return 4
    }
    model_first_trace="$qualification/p1-model-first-pipeline-info/trace.tsv"
    model_resume_trace="$qualification/p1-model-resume-pipeline-info/trace.tsv"
    [[ -f "$model_first_trace" && -f "$model_resume_trace" ]] || {
        printf 'P1 model first/resume traces were not produced\n' >&2
        return 4
    }
    [[ -s "$P1_MODEL_OUT/predicted_model_preparation/processed_models.jsonl" && \
        -s "$P1_MODEL_OUT/predicted_model_preparation/model_preparation_manifest.json" ]] || {
        printf 'P1 predicted-model outputs were not produced\n' >&2
        return 4
    }
    model_record_count="$(wc -l < \
        "$P1_MODEL_OUT/predicted_model_preparation/processed_models.jsonl")"
    [[ "$model_record_count" -eq 1 ]] || {
        printf 'P1 expected exactly one mapped predicted model: observed=%s\n' \
            "$model_record_count" >&2
        return 4
    }
    model_cache_counts="$(awk -F '\t' '
        NR == 1 {
            for (i = 1; i <= NF; i++) if ($i == "status") status_column = i
            next
        }
        status_column > 0 { total++; if ($status_column == "CACHED") cached++ }
        END { printf "%d %d", total, cached }
    ' "$model_resume_trace")"
    read -r model_total model_cached <<< "$model_cache_counts"
    [[ "$model_total" -eq 1 && "$model_cached" -eq 1 ]] || {
        printf 'P1 predicted-model resume was not fully cached: total=%s cached=%s\n' \
            "$model_total" "$model_cached" >&2
        return 4
    }
    cat > "$qualification/p1-model-resume-check.json" <<EOF
{
  "schema_version": "1.0",
  "run_id": "$RUN_ID",
  "profile": "p1",
  "process_count": $model_total,
  "cached_process_count": $model_cached,
  "all_model_processes_cached": true
}
EOF
    printf 'phase=p1_qualification profile=p1\n'
    "$GTD" --log-format json --no-progress structure-search qualify-p1 \
        --sequence-groups "$P1_CATALOGUE_OUT/sequence_groups.jsonl" \
        --search-directory "$P1_DISCOVERY_OUT/pdb_sequence_search" \
        --control-specification "$control_spec" \
        --first-trace "$first_trace" \
        --resume-trace "$resume_trace" \
        --output "$qualification/p1-qualification.json"

    PHASE=software
    [[ "$(git -C "$RUN/source" rev-parse HEAD)" == \
        "$(<"$RUN/state/commit")" ]] || {
        printf 'P1 source commit changed during execution\n' >&2
        return 3
    }
    [[ -z "$(git -C "$RUN/source" status --porcelain=v1 --untracked-files=no)" ]] || {
        printf 'P1 execution modified tracked source files\n' >&2
        return 3
    }
    printf 'p1_status=direct_pdb_sequence_search_qualified\n'
    printf 'prostt5_foldseek_status=pilot_slice_complete_full_catalogue_pending\n'
    printf 'afdb_exact_status=login_prefetch_verified_compute_offline\n'
    printf 'predicted_model_status=confidence_processed_and_resume_cached\n'
}

