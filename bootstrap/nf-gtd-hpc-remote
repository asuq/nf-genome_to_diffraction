status_run() {
    [[ "$#" -eq 2 ]] || fail wrapper_failure "status expects run ID and owner ID"
    local run_id="$1"
    local owner_id="$2"
    local run phase profile job_id="" scheduler_state exit_code="" failure_class="" terminal=false sacct_line
    require_owned_run "$run_id" "$owner_id"
    run="$(run_directory "$run_id")"
    phase="$(<"$run/state/phase")"
    profile="$(<"$run/state/profile")"
    validate_profile "$profile"
    if [[ -f "$run/state/job-id" ]]; then
        job_id="$(<"$run/state/job-id")"
        [[ "$job_id" =~ $INTEGER_RE ]] || fail wrapper_failure "recorded job ID is invalid"
        scheduler_state="$(scheduler_queue_state "$job_id")"
        if [[ -z "$scheduler_state" ]]; then
            sacct_line="$({
                sacct -n -P -j "$job_id" --format=State,ExitCode 2>"$DISCARD" || true
            } | awk -F'|' '$1 != "" {print; exit}')"
            scheduler_state="${sacct_line%%|*}"
            scheduler_state="${scheduler_state%% *}"
            scheduler_state="${scheduler_state%%+*}"
            exit_code="${sacct_line#*|}"
            exit_code="${exit_code%%:*}"
        fi
    else
        case "$phase" in
            staging) scheduler_state="STAGING" ;;
            staged) scheduler_state="STAGED" ;;
            stage_failed) scheduler_state="FAILED" ;;
            *) scheduler_state="UNKNOWN" ;;
        esac
    fi
    [[ -n "$scheduler_state" ]] || scheduler_state="UNKNOWN"
    if [[ -f "$run/state/failure-class" ]]; then
        failure_class="$(<"$run/state/failure-class")"
    fi
    if [[ -f "$run/state/exit-code" ]]; then
        exit_code="$(<"$run/state/exit-code")"
    fi
    case "$scheduler_state" in
        BOOT_FAIL|CANCELLED|COMPLETED|DEADLINE|FAILED|NODE_FAIL|OUT_OF_MEMORY|PREEMPTED|REVOKED|TIMEOUT)
            terminal=true
            ;;
    esac
    if [[ "$scheduler_state" == NODE_FAIL ]]; then
        failure_class=node_failure
    elif [[ "$scheduler_state" == OUT_OF_MEMORY ]]; then
        failure_class=environment_failure
    elif [[ "$scheduler_state" == CANCELLED ]]; then
        failure_class=unknown_failure
    elif [[ "$scheduler_state" == TIMEOUT ]]; then
        failure_class=environment_failure
    elif [[ -z "$failure_class" && "$scheduler_state" == COMPLETED ]]; then
        failure_class=success
    fi
    emit operation status
    emit run_id "$run_id"
    emit profile "$profile"
    emit phase "$phase"
    emit job_id "$job_id"
    emit scheduler_state "$scheduler_state"
    emit exit_code "$exit_code"
    emit failure_class "$failure_class"
    emit terminal "$terminal"
}

database_diagnostic_log() {
    [[ "$#" -eq 1 ]] || return 1
    local application_log="$1"
    local line candidate="" basename resolved logs_root
    database_config_readiness || return 1
    logs_root="$DATABASE_ROOT/logs"
    [[ -d "$logs_root" && ! -L "$logs_root" && -O "$logs_root" ]] || return 1
    while IFS= read -r line; do
        [[ "$line" == *"; see "* ]] || continue
        candidate="${line##*; see }"
        candidate="${candidate%% *}"
        candidate="${candidate%\",}"
    done < "$application_log"
    [[ -n "$candidate" && "$candidate" =~ $SAFE_PATH_RE ]] || return 1
    [[ "$(dirname "$candidate")" == "$logs_root" ]] || return 1
    basename="${candidate##*/}"
    [[ "$basename" =~ ^(pdb_foldseek|pdb_sequences|prostt5)\.(download|createdb|createindex|smoke)\.[0-9a-f]{32}\.log$ ]] || \
        return 1
    resolved="$(realpath -e "$candidate" 2>"$DISCARD")" || return 1
    [[ "$resolved" == "$candidate" && -f "$candidate" && ! -L "$candidate" && \
        -O "$candidate" ]] || return 1
    printf '%s' "$candidate"
}

require_database_retained_staging() {
    [[ "$#" -eq 2 ]] || \
        fail wrapper_failure "retained-staging resolver expects a log and mode"
    local application_log="$1"
    local allow_active="$2"
    local line candidate="" remainder basename resource resource_root resolved unsafe link link_resolved
    local link_count=0
    [[ "$allow_active" == true || "$allow_active" == false ]] || \
        fail wrapper_failure "retained-staging resolver mode is invalid"
    DATABASE_RETAINED_STAGING=""
    DATABASE_RETAINED_STAGING_SYMLINK_COUNT=0
    while IFS= read -r line; do
        [[ "$line" == *'"staging_path": "'* ]] || continue
        candidate="${line#*\"staging_path\": \"}"
        candidate="${candidate%%\"*}"
    done < "$application_log"
    if [[ -z "$candidate" && "$allow_active" == true ]]; then
        while IFS= read -r line; do
            [[ "$line" == *'"message": "starting database command"'* ]] || continue
            [[ "$line" == *'"write_roots": ["'* ]] || continue
            remainder="${line#*\"write_roots\": [\"}"
            candidate="${remainder%%\"*}"
            remainder="${remainder#*\"}"
            [[ "$remainder" == ']'* ]] || \
                fail filesystem_failure "cancelled command has multiple write roots"
        done < "$application_log"
    fi
    [[ -n "$candidate" ]] || \
        fail filesystem_failure "retained-staging path is absent from the application log"
    [[ "$candidate" =~ $SAFE_PATH_RE ]] || \
        fail filesystem_failure "retained-staging path contains unsafe characters"
    basename="${candidate##*/}"
    if [[ "$allow_active" == true ]]; then
        [[ "$basename" =~ ^\.staging-[0-9a-f]{32}(\.failed)?$ ]] || \
            fail filesystem_failure "retained-staging basename is not recognised"
    else
        [[ "$basename" =~ ^\.staging-[0-9a-f]{32}\.failed$ ]] || \
            fail filesystem_failure "failed-staging basename is not recognised"
    fi
    resource_root="$(dirname "$candidate")"
    resource="${resource_root##*/}"
    [[ "$resource" =~ ^(coordinate_cache|pdb_foldseek|pdb_sequences|prostt5)$ ]] || \
        fail filesystem_failure "failed-staging resource is not recognised"
    [[ "$(dirname "$resource_root")" == "$DATABASE_ROOT/resources" ]] || \
        fail filesystem_failure "failed-staging path is outside the configured resources"
    resolved="$(realpath -e "$candidate" 2>"$DISCARD")" || \
        fail filesystem_failure "failed-staging directory is absent or cannot be resolved"
    [[ "$resolved" == "$candidate" && -d "$candidate" && ! -L "$candidate" && \
        -O "$candidate" ]] || \
        fail filesystem_failure "failed-staging directory is non-canonical, unsafe, or foreign-owned"
    while IFS= read -r -d '' link; do
        link_resolved="$(realpath -e "$link" 2>"$DISCARD")" || \
            fail filesystem_failure "failed-staging directory contains a broken symbolic link"
        path_within_root "$resolved" "$link_resolved" || \
            fail filesystem_failure "failed-staging symbolic link escapes its staging tree"
        link_count=$((link_count + 1))
    done < <(find "$candidate" -xdev -type l -print0)
    unsafe="$(find "$candidate" -xdev \( ! -type d -a ! -type f -a ! -type l \) -print -quit)"
    [[ -z "$unsafe" ]] || \
        fail filesystem_failure "failed-staging directory contains a non-file entry"
    unsafe="$(find "$candidate" -xdev ! -user "$(id -u)" -print -quit)"
    [[ -z "$unsafe" ]] || \
        fail filesystem_failure "failed-staging directory contains foreign-owned content"
    DATABASE_RETAINED_STAGING="$candidate"
    DATABASE_RETAINED_STAGING_SYMLINK_COUNT="$link_count"
}

logs_run() {
    [[ "$#" -eq 3 ]] || fail wrapper_failure "logs expects run ID, owner ID, and line count"
    local run_id="$1"
    local owner_id="$2"
    local lines="$3"
    local run job_id="" log_path="" diagnostic_log="" content="" profile="" phase=""
    local main_lines diagnostic_lines
    require_owned_run "$run_id" "$owner_id"
    [[ "$lines" =~ $INTEGER_RE ]] || fail wrapper_failure "log line count is invalid"
    (( lines >= 1 && lines <= 2000 )) || fail wrapper_failure "log line count is outside 1..2000"
    run="$(run_directory "$run_id")"
    if [[ -f "$run/state/profile" ]]; then
        profile="$(<"$run/state/profile")"
        validate_profile "$profile"
    fi
    if [[ -f "$run/state/phase" ]]; then
        phase="$(<"$run/state/phase")"
    fi
    if [[ "$profile" == database && "$phase" =~ ^(staging|staged|stage_failed)$ && \
        -f "$run/logs/database-source-stage.log" ]]; then
        log_path="$run/logs/database-source-stage.log"
    elif [[ "$profile" == t12 && "$phase" =~ ^(t12_input_staging|staged|stage_failed)$ && \
        -f "$run/logs/t12-stage.log" ]]; then
        log_path="$run/logs/t12-stage.log"
    elif [[ -n "$profile" && -f "$run/logs/${profile}.log" ]]; then
        log_path="$run/logs/${profile}.log"
    elif [[ -f "$run/state/job-id" ]]; then
        job_id="$(<"$run/state/job-id")"
        [[ "$job_id" =~ $INTEGER_RE ]] || fail wrapper_failure "recorded job ID is invalid"
        log_path="$run/logs/slurm-${job_id}.out"
    fi
    if [[ "$profile" == database && "$log_path" == "$run/logs/database.log" ]]; then
        diagnostic_log="$(database_diagnostic_log "$log_path" || true)"
    fi
    if [[ -n "$diagnostic_log" ]]; then
        if (( lines == 1 )); then
            content="$(tail -n 1 -- "$diagnostic_log" | base64 | tr -d '\n')"
        else
            main_lines=$((lines / 2))
            diagnostic_lines=$((lines - main_lines - 1))
            content="$({
                tail -n "$main_lines" -- "$log_path"
                printf '%s\n' "--- failed database command log ---"
                tail -n "$diagnostic_lines" -- "$diagnostic_log"
            } | base64 | tr -d '\n')"
        fi
    elif [[ -n "$log_path" && -f "$log_path" ]]; then
        content="$(tail -n "$lines" -- "$log_path" | base64 | tr -d '\n')"
    fi
    emit operation logs
    emit run_id "$run_id"
    emit log_path "$log_path"
    emit diagnostic_log_path "$diagnostic_log"
    emit content_base64 "$content"
}

cancel_run() {
    [[ "$#" -eq 2 ]] || fail wrapper_failure "cancel expects run ID and owner ID"
    local run_id="$1"
    local owner_id="$2"
    local run job_id
    require_owned_run "$run_id" "$owner_id"
    run="$(run_directory "$run_id")"
    [[ -f "$run/state/job-id" ]] || fail wrapper_failure "run has no recorded scheduler job"
    job_id="$(<"$run/state/job-id")"
    [[ "$job_id" =~ $INTEGER_RE ]] || fail wrapper_failure "recorded job ID is invalid"
    scancel "$job_id" || fail scheduler_rejection "Slurm cancellation failed"
    atomic_text "$run/state/phase" "cancel_requested"
    append_event "$run" "cancel_requested"
    emit operation cancel
    emit run_id "$run_id"
    emit job_id "$job_id"
    emit scheduler_state CANCEL_REQUESTED
}

database_archive_failed_run() {
    [[ "$#" -eq 3 ]] || \
        fail wrapper_failure "database-archive-failed expects run ID, owner ID, and confirmation"
    local run_id="$1"
    local owner_id="$2"
    local confirmation="$3"
    local run profile phase failure_class="" expected_config source destination
    local basename file_count=0 total_bytes=0 timestamp record temporary candidate size
    local symlink_count=0 allow_active=false job_id queue_state sacct_line scheduler_state
    require_owned_run "$run_id" "$owner_id"
    [[ "$confirmation" == "$run_id" ]] || \
        fail wrapper_failure "database archive confirmation does not match"
    run="$(run_directory "$run_id")"
    [[ -f "$run/state/profile" ]] || fail wrapper_failure "run profile is absent"
    profile="$(<"$run/state/profile")"
    [[ "$profile" == database ]] || \
        fail wrapper_failure "database archive requires a database run"
    [[ -f "$run/state/phase" ]] || \
        fail wrapper_failure "terminal database phase is absent"
    phase="$(<"$run/state/phase")"
    if [[ "$phase" == completed ]]; then
        [[ -f "$run/state/failure-class" ]] || \
            fail wrapper_failure "terminal database failure class is absent"
        failure_class="$(<"$run/state/failure-class")"
        [[ "$failure_class" == software_failure ]] || \
            fail wrapper_failure "database archive requires a software failure"
    elif [[ "$phase" == cancel_requested ]]; then
        [[ -f "$run/state/job-id" ]] || \
            fail wrapper_failure "cancelled database job ID is absent"
        job_id="$(<"$run/state/job-id")"
        [[ "$job_id" =~ $INTEGER_RE ]] || \
            fail wrapper_failure "cancelled database job ID is invalid"
        queue_state="$(scheduler_queue_state "$job_id")"
        [[ -z "$queue_state" ]] || \
            fail scheduler_rejection "cancelled database job is still active"
        sacct_line="$({
            sacct -n -P -j "$job_id" --format=State,ExitCode 2>"$DISCARD" || true
        } | awk -F'|' 'NF >= 2 {print; exit}')"
        scheduler_state="${sacct_line%%|*}"
        scheduler_state="${scheduler_state%% *}"
        scheduler_state="${scheduler_state%%+*}"
        [[ "$scheduler_state" == CANCELLED ]] || \
            fail scheduler_rejection "database cancellation is not terminal"
        allow_active=true
    else
        fail wrapper_failure "database archive requires a terminal reviewed run"
    fi
    [[ -f "$run/logs/database.log" && ! -L "$run/logs/database.log" && \
        -O "$run/logs/database.log" ]] || \
        fail filesystem_failure "database application log is missing or unsafe"
    database_config_readiness || \
        fail environment_failure "database configuration is not ready"
    [[ -f "$run/state/database-config-sha256" ]] || \
        fail wrapper_failure "recorded database configuration checksum is absent"
    expected_config="$(<"$run/state/database-config-sha256")"
    [[ "$expected_config" =~ $CHECKSUM_RE && \
        "$expected_config" == "$DATABASE_CONFIG_SHA256" ]] || \
        fail wrapper_failure "database configuration changed after the failed run"
    require_database_retained_staging "$run/logs/database.log" "$allow_active"
    source="$DATABASE_RETAINED_STAGING"
    symlink_count="$DATABASE_RETAINED_STAGING_SYMLINK_COUNT"
    basename="${source##*/}"
    destination="$(dirname "$source")/${basename%.failed}.reviewed-${run_id}"
    [[ ! -e "$destination" && ! -L "$destination" ]] || \
        fail filesystem_failure "failed-staging archive destination already exists"
    while IFS= read -r -d '' candidate; do
        size="$(file_size "$candidate")"
        [[ "$size" =~ $BYTE_COUNT_RE ]] || \
            fail filesystem_failure "failed-staging file size is invalid"
        file_count=$((file_count + 1))
        total_bytes=$((total_bytes + size))
    done < <(find "$source" -xdev -type f -print0)
    [[ "$file_count" =~ $INTEGER_RE && "$total_bytes" =~ $BYTE_COUNT_RE ]] || \
        fail filesystem_failure "failed-staging inventory could not be measured"
    mv -- "$source" "$destination" || \
        fail filesystem_failure "failed staging could not be archived atomically"
    timestamp="$(now_utc)"
    record="$run/state/database-failed-staging-archive.json"
    temporary="${record}.tmp.$$"
    cat > "$temporary" <<EOF
{
  "schema_version": "1.0",
  "run_id": "$run_id",
  "archived_at": "$timestamp",
  "source": "$source",
  "destination": "$destination",
  "file_count": $file_count,
  "symlink_count": $symlink_count,
  "total_bytes": $total_bytes
}
EOF
    mv -f -- "$temporary" "$record"
    append_event "$run" "database_retained_staging_archived"
    emit operation database-archive-failed
    emit run_id "$run_id"
    emit archived true
    emit source "$source"
    emit destination "$destination"
    emit file_count "$file_count"
    emit symlink_count "$symlink_count"
    emit total_bytes "$total_bytes"
}

