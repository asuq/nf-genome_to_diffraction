expected: dict[PurePosixPath, str] = {}
digest_fields = {
    "brief_refine_001.pdb": "refined_model_sha256",
    "brief_refine_001.mtz": "refined_mtz_sha256",
    "brief_refine_2mFo-DFc.ccp4": "map_sha256",
    "brief_refine_mFo-DFc.ccp4": "difference_map_sha256",
}
for seed in sorted(refinement_by_seed):
    refinement = refinement_by_seed[seed]
    sequence = sequence_by_seed[seed]
    for basename, field in digest_fields.items():
        digest = refinement.get(field)
        if not isinstance(digest, str) or not digest_pattern.fullmatch(digest):
            raise ValueError("T12 refinement asset checksum is invalid")
        expected[PurePosixPath("artifacts/t12") / f"t12_{seed}" / basename] = digest
    digest = sequence.get("output_model_sha256")
    if not isinstance(digest, str) or not digest_pattern.fullmatch(digest):
        raise ValueError("T12 sequence asset checksum is invalid")
    expected[
        PurePosixPath("artifacts/t12") / f"t12_{seed}" / "sequence_from_map.pdb"
    ] = digest

for relative, digest_key in (
    (sequence_groups_relative, "sequence_groups_sha256"),
    (source_records_relative, "source_records_sha256"),
    (preflight_relative, "preflight_sha256"),
):
    digest = stage.get(digest_key)
    if not isinstance(digest, str) or not digest_pattern.fullmatch(digest):
        raise ValueError("T12 scientific-context checksum is invalid")
    expected[relative] = digest

total = 0
copied: list[str] = []
for relative, digest in expected.items():
    source = safe_file(relative)
    size = source.stat().st_size
    if size > maximum_file_bytes:
        raise ValueError(f"T12 review asset exceeds per-file limit: {relative}")
    total += size
    if total > maximum_total_bytes:
        raise ValueError("T12 review assets exceed total collection limit")
    if sha256_file(source) != digest:
        raise ValueError(f"T12 review asset checksum mismatch: {relative}")
    target = payload.joinpath(*relative.parts)
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, target, follow_symlinks=False)
    os.chmod(target, 0o400)
    if sha256_file(target) != digest:
        raise ValueError(f"staged T12 review asset checksum mismatch: {relative}")
    copied.append(relative.as_posix())
inventory.write_text("".join(f"{name}\n" for name in copied), encoding="ascii")
PY
    then
        message="$(tail -n 1 -- "$diagnostic" 2>"$DISCARD" || true)"
        rm -rf -- "$temporary"
        fail transfer_failure \
            "T12 review asset validation failed: ${message:-unknown error}"
    fi
    mapfile -t files < "$inventory"
    ((${#files[@]} >= 8)) || {
        rm -rf -- "$temporary"
        fail transfer_failure "T12 review asset inventory is incomplete"
    }
    if ! COPYFILE_DISABLE=1 tar -czf - -C "$payload" "${files[@]}"; then
        rm -rf -- "$temporary"
        fail transfer_failure "T12 review asset archive could not be streamed"
    fi
    rm -rf -- "$temporary"
}

clean_run() {
    [[ "$#" -eq 3 ]] || fail wrapper_failure "clean expects run ID, owner ID, and confirmation"
    local run_id="$1"
    local owner_id="$2"
    local confirmation="$3"
    local run job_id scheduler_state resolved
    require_owned_run "$run_id" "$owner_id"
    [[ "$confirmation" == "$run_id" ]] || fail wrapper_failure "clean confirmation does not match"
    run="$(run_directory "$run_id")"
    resolved="$(realpath "$run")"
    [[ "$resolved" == "$RUNS/$run_id" ]] || fail wrapper_failure "clean target escaped the run root"
    if [[ -f "$run/state/job-id" ]]; then
        job_id="$(<"$run/state/job-id")"
        [[ "$job_id" =~ $INTEGER_RE ]] || fail wrapper_failure "recorded job ID is invalid"
        scheduler_state="$(squeue -h -j "$job_id" -o '%T' 2>"$DISCARD" | head -n 1)"
        [[ -z "$scheduler_state" ]] || fail scheduler_rejection "cannot clean an active job"
    fi
    chmod -R u+w "$run/source"
    rm -rf -- "$run"
    emit operation clean
    emit run_id "$run_id"
    emit removed true
}

main() {
    if [[ ! -e "$DISCARD" ]]; then
        (umask 077; printf '' > "$DISCARD") || {
            printf 'cannot create the owned dispatcher discard file\n' >&2
            exit 1
        }
    fi
    discard_mode="$(stat -c '%a' "$DISCARD" 2>"$DISCARD" || \
        stat -f '%Lp' "$DISCARD" 2>"$DISCARD")"
    if [[ ! -f "$DISCARD" || -L "$DISCARD" || ! -O "$DISCARD" || \
        "$discard_mode" != 600 ]]; then
        printf 'dispatcher discard file is unsafe\n' >&2
        exit 1
    fi
    if ! { true <&0; } 2>"$DISCARD"; then
        exec 0<"$DISCARD"
    fi
    printf '' | base64 >"$DISCARD" 2>&1 || \
        fail environment_failure "base64 is unavailable"
    command -v flock >"$DISCARD" 2>&1 || \
        fail environment_failure "flock is unavailable"
    local operation="${1-}"
    [[ -n "$operation" ]] || fail wrapper_failure "operation is required"
    shift
    case "$operation" in
        deploy-tools) deploy_tools "$@" ;;
        phenix-runtime-migrate) phenix_runtime_migrate_run "$@" ;;
        readiness) readiness_p0 "$@" ;;
        p0-configure) p0_configure "$@" ;;
        p0-inputs-stage) p0_inputs_stage "$@" ;;
        unknown-discovery-inputs-stage) unknown_discovery_inputs_stage "$@" ;;
        unknown-screen-stage) unknown_screen_stage_run "$@" ;;
        unknown-single-component-stage) unknown_single_component_stage_run "$@" ;;
        unknown-pass2-inputs-stage) unknown_pass2_inputs_stage_run "$@" ;;
        database-readiness) database_readiness "$@" ;;
        database-runtime-configure) database_runtime_configure "$@" ;;
        stage) stage_run "$@" ;;
        stage-archive) stage_archive_run "$@" ;;
        m4-copy-stage) m4_copy_stage_run "$@" ;;
        m4-import-stage) m4_import_stage_run "$@" ;;
        control-slice-stage) control_slice_stage_run "$@" ;;
        control-matrix-stage) control_matrix_stage_run "$@" ;;
        m6-inputs-stage) m6_inputs_stage_run "$@" ;;
        m6-scientific-stage) m6_scientific_stage_run "$@" ;;
        m6-leakage-parent-bind) m6_leakage_parent_bind_run "$@" ;;
        t12-stage) t12_stage_run "$@" ;;
        database-stage) database_stage_run "$@" ;;
        submit) submit_run "$@" ;;
        database-submit) database_submit_run "$@" ;;
        database-archive-failed) database_archive_failed_run "$@" ;;
        status) status_run "$@" ;;
        logs) logs_run "$@" ;;
        collect) collect_run "$@" ;;
        review-collect) review_collect_run "$@" ;;
        t12-review-collect) t12_review_collect_run "$@" ;;
        cancel) cancel_run "$@" ;;
        clean) clean_run "$@" ;;
        *) fail wrapper_failure "unsupported remote operation" ;;
    esac
}

main "$@"
