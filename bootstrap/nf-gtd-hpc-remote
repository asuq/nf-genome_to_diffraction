    [[ "$(<"$run/state/profile")" == m6-leakage && \
       "$(<"$run/state/phase")" == staged && \
       ! -e "$run/state/job-id" ]] || \
        fail wrapper_failure "M6 leakage child is not safely staged"
    [[ "$(<"$parent/state/profile")" == m6-operational && \
       "$(<"$parent/state/phase")" == completed && \
