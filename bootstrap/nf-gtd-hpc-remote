        fail wrapper_failure "stage-archive expects nine fixed arguments"
    [[ "$6" != database ]] || \
        fail wrapper_failure "database profile requires database-stage"
    stage_run_common "$@"
}

m4_copy_stage_run() {
    [[ "$#" -eq 10 ]] || \
        fail wrapper_failure "m4-copy-stage expects ten fixed arguments"
    local run_id="$1"
    local commit="$2"
    local lock_sha256="$3"
    local owner_id="$4"
    local iteration="$5"
    local parent_run_id="$6"
    local parent_owner_id="$7"
    local decisions_sha256="$8"
    local review_sha256="$9"
    local decisions_base64="${10}"
    local run parent decisions stage_out gtd mtz_candidate mtz phenix_manifest
    local staged_manifest seed_count
    local -a p0_values=()

    validate_run_id "$parent_run_id"
    [[ "$parent_run_id" == gtd-p2-diverse-* ]] || \
        fail wrapper_failure "M4 parent must be a retained P2-diverse run"
    validate_owner "$parent_owner_id"
    [[ "$decisions_sha256" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "invalid M4 decisions checksum"
    [[ "$review_sha256" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "invalid M4 review checksum"
    require_owned_run "$parent_run_id" "$parent_owner_id"
    parent="$(run_directory "$parent_run_id")"
    [[ "$(<"$parent/state/profile")" == p2-diverse && \
       "$(<"$parent/state/phase")" == completed && \
       "$(<"$parent/state/failure-class")" == success && \
       "$(<"$parent/state/exit-code")" == 0 ]] || \
        fail wrapper_failure "M4 parent is not a retained successful P2-diverse run"
    [[ -f "$parent/artifacts/qualification/p2-diverse-review/mr_seed_review_manifest.json" && \
       "$(sha256sum "$parent/artifacts/qualification/p2-diverse-review/mr_seed_review_manifest.json" | awk '{print $1}')" == \
       "$review_sha256" ]] || \
        fail transfer_failure "retained M4 review manifest differs from local evidence"

    stage_run_common \
        "$run_id" "$commit" "$lock_sha256" "$owner_id" "$iteration" m4-copy
    run="$(run_directory "$run_id")"
    atomic_text "$run/state/phase" m4_input_staging
    atomic_text "$run/state/parent-run-id" "$parent_run_id"
    atomic_text "$run/state/parent-owner-id" "$parent_owner_id"
    atomic_text "$run/state/m4-decisions-sha256" "$decisions_sha256"
    atomic_text "$run/state/m4-review-manifest-sha256" "$review_sha256"
    decisions="$run/artifacts/m4-copy-decisions.tsv"
    if ! printf '%s' "$decisions_base64" | base64 -d > "$decisions" 2>"$DISCARD"; then
        atomic_text "$run/state/phase" stage_failed
        atomic_text "$run/state/failure-class" transfer_failure
        fail transfer_failure "M4 decisions are not valid base64"
    fi
    [[ -s "$decisions" && "$(file_size "$decisions")" -le 32768 && \
       "$(sha256sum "$decisions" | awk '{print $1}')" == "$decisions_sha256" ]] || {
        atomic_text "$run/state/phase" stage_failed
        atomic_text "$run/state/failure-class" transfer_failure
        fail transfer_failure "M4 decisions payload failed size or checksum validation"
    }
    mapfile -t p0_values < "$P0_CONFIG"
    [[ "${#p0_values[@]}" -eq 7 ]] || \
        fail wrapper_failure "P0 configuration changed during M4 staging"
    phenix_manifest="${p0_values[6]}"
    [[ "$(basename "$(dirname "${p0_values[2]}")")" == manifests ]] || \
        fail wrapper_failure "M4 requires the checksum-frozen P0 bundle layout"
    mtz_candidate="$(dirname "$(dirname "${p0_values[2]}")")/inputs/CD6QS2P2G1_5.mtz"
    mtz="$(realpath -e "$mtz_candidate")" || \
        fail filesystem_failure "fixed CD6 MTZ cannot be resolved for M4"
    [[ "$mtz" == "$mtz_candidate" && -f "$mtz" && ! -L "$mtz_candidate" ]] || \
        fail filesystem_failure "fixed CD6 MTZ is unsafe for M4"

    stage_out="$run/artifacts/m4-copy-inputs"
    gtd="$run/source/.pixi/envs/hpc/bin/genome-to-diffraction"
    if ! "$gtd" --log-format json --no-progress mr stage-add-copy \
        --parent-run "$parent" \
        --decisions "$decisions" \
        --review-manifest-sha256 "$review_sha256" \
        --mtz "$mtz" \
        --phenix-manifest "$phenix_manifest" \
        --outdir "$stage_out" \
        --expected-seed-count 11 \
        > "$run/logs/m4-copy-stage.log" 2>&1; then
        atomic_text "$run/state/phase" stage_failed
        atomic_text "$run/state/failure-class" test_failure
        append_event "$run" m4_copy_input_stage_failed
        fail test_failure "checksum-bound M4 input staging failed"
    fi
    staged_manifest="$stage_out/m4_copy_stage_manifest.json"
    [[ -f "$staged_manifest" && ! -L "$staged_manifest" ]] || \
        fail filesystem_failure "M4 stage manifest was not produced"
    seed_count="$(awk 'NR > 1 && NF { count++ } END { print count + 0 }' \
        "$stage_out/seeds.tsv")"
    [[ "$seed_count" -eq 11 ]] || \
        fail test_failure "M4 stage did not retain exactly 11 approved seeds"
    atomic_text "$run/state/m4-stage-manifest-sha256" \
        "$(sha256sum "$staged_manifest" | awk '{print $1}')"
    atomic_text "$run/state/phase" staged
    append_event "$run" m4_copy_inputs_ready
    emit operation m4-copy-stage
    emit run_id "$run_id"
    emit parent_run_id "$parent_run_id"
    emit seed_count "$seed_count"
    emit decisions_sha256 "$decisions_sha256"
    emit review_manifest_sha256 "$review_sha256"
    emit phase staged
}

t12_stage_run() {
    [[ "$#" -eq 9 ]] || \
        fail wrapper_failure "t12-stage expects nine fixed arguments"
    local run_id="$1" commit="$2" lock_sha256="$3" owner_id="$4"
    local iteration="$5" parent_run_id="$6" parent_owner_id="$7"
    local source_sha256="$8" source_size="$9"
    local parent run source_records stage_out gtd staged_manifest seed_count

    validate_run_id "$parent_run_id"
    [[ "$parent_run_id" == gtd-m4-copy-* ]] || \
        fail wrapper_failure "T12 parent must be a retained M4 run"
    validate_owner "$parent_owner_id"
    [[ "$source_sha256" =~ $CHECKSUM_RE && "$source_size" =~ $BYTE_COUNT_RE ]] || \
        fail wrapper_failure "invalid T12 source-record identity"
    (( source_size >= 1 && source_size <= MAX_T12_SOURCE_RECORD_BYTES )) || \
        fail wrapper_failure "T12 source-record crosswalk is outside the fixed limit"
    require_owned_run "$parent_run_id" "$parent_owner_id"
    parent="$(run_directory "$parent_run_id")"
    [[ "$(<"$parent/state/profile")" == m4-copy && \
       "$(<"$parent/state/phase")" == completed && \
       "$(<"$parent/state/failure-class")" == success && \
       "$(<"$parent/state/exit-code")" == 0 ]] || \
        fail wrapper_failure "T12 parent is not retained successful M4 evidence"
    [[ -f "$parent/artifacts/qualification/m4-copy-summary.json" && \
       -f "$parent/artifacts/qualification/m4-copy-results.jsonl" && \
       -f "$parent/artifacts/qualification/m4-copy-resume-check.json" ]] || \
        fail filesystem_failure "T12 parent evidence inventory is incomplete"

    stage_run_common \
        "$run_id" "$commit" "$lock_sha256" "$owner_id" "$iteration" t12
    run="$(run_directory "$run_id")"
    atomic_text "$run/state/phase" t12_input_staging
    atomic_text "$run/state/parent-run-id" "$parent_run_id"
    atomic_text "$run/state/parent-owner-id" "$parent_owner_id"
    atomic_text "$run/state/t12-source-records-sha256" "$source_sha256"
    source_records="$run/artifacts/t12-source-records.jsonl"
    head -c "$source_size" > "$source_records" || \
        fail transfer_failure "T12 source-record transfer failed"
    [[ "$(file_size "$source_records")" -eq "$source_size" && \
       "$(sha256sum "$source_records" | awk '{print $1}')" == "$source_sha256" ]] || \
        fail transfer_failure "T12 source-record crosswalk changed during transfer"

    stage_out="$run/artifacts/t12-inputs"
    gtd="$run/source/.pixi/envs/hpc/bin/genome-to-diffraction"
    if ! "$gtd" --log-format json --no-progress refinement stage \
        --parent-run "$parent" \
        --source-records "$source_records" \
        --outdir "$stage_out" \
        --expected-seed-count 11 \
        > "$run/logs/t12-stage.log" 2>&1; then
        atomic_text "$run/state/phase" stage_failed
        atomic_text "$run/state/failure-class" test_failure
        append_event "$run" t12_input_stage_failed
