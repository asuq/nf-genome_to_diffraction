    local input_id="$5" archive_sha256="$6" archive_size="$7"
    local execution_identity_id="$8" finding_closure_id="$9" file_count="${10}"
    local run parent profile archive staging output python observed_count
    local source_commit source_tree finding_ledger_sha256
    validate_run_id "$run_id"
    validate_owner "$owner_id"
    validate_run_id "$parent_run_id"
    validate_owner "$parent_owner_id"
    [[ "$input_id" =~ ^phase3pass2inputs_[0-9a-f]{64}$ && \
       "$archive_sha256" =~ $CHECKSUM_RE && \
       "$archive_size" =~ $BYTE_COUNT_RE && \
       "$archive_size" -ge 1 && \
       "$archive_size" -le "$MAX_UNKNOWN_PASS2_INPUT_ARCHIVE_BYTES" && \
       "$execution_identity_id" =~ ^phase3exec_[0-9a-f]{64}$ && \
       "$finding_closure_id" =~ ^phase3closure_[0-9a-f]{64}$ && \
       "$file_count" =~ $INTEGER_RE && \
       "$file_count" -ge 2 && "$file_count" -le 50001 ]] || \
        fail wrapper_failure "invalid unknown-pass2 input identity or bound"
    require_owned_run "$run_id" "$owner_id"
    require_owned_run "$parent_run_id" "$parent_owner_id"
    run="$(run_directory "$run_id")"
    parent="$(run_directory "$parent_run_id")"
    profile="$(<"$run/state/profile")"
    [[ "$profile" == unknown-pass2 && \
       "$(<"$run/state/phase")" == staged && \
       ! -e "$run/state/job-id" ]] || \
        fail wrapper_failure "unknown-pass2 child is not safely staged"
    [[ "$(<"$parent/state/profile")" == unknown-single-component && \
       "$(<"$parent/state/phase")" == completed && \
       "$(<"$parent/state/failure-class")" == success && \
       "$(<"$parent/state/exit-code")" == 0 ]] || \
        fail wrapper_failure "unknown-pass2 parent is not successful"
    [[ "$(<"$run/state/commit")" == "$(<"$parent/state/commit")" && \
       "$(<"$run/state/site-id")" == "$(<"$parent/state/site-id")" && \
       "$(<"$run/state/phenix-manifest-sha256")" == \
       "$(<"$parent/state/phenix-manifest-sha256")" ]] || \
        fail wrapper_failure "unknown-pass2 parent authority differs"
    source_commit="$(<"$run/state/commit")"
    source_tree="$(git -C "$run/source" rev-parse --verify 'HEAD^{tree}' \
        2>"$DISCARD")" || \
        fail wrapper_failure "unknown-pass2 staged source tree is unavailable"
    [[ "$source_commit" =~ $COMMIT_RE && "$source_tree" =~ $COMMIT_RE && \
       "$(git -C "$run/source" rev-parse --verify HEAD 2>"$DISCARD")" == \
       "$source_commit" ]] || \
        fail wrapper_failure "unknown-pass2 staged source identity differs"
    [[ -f "$run/source/docs/phase-iii-finding-ledger.md" && \
       ! -L "$run/source/docs/phase-iii-finding-ledger.md" ]] || \
        fail wrapper_failure "unknown-pass2 tracked finding ledger is unavailable"
    finding_ledger_sha256="$(sha256sum \
        "$run/source/docs/phase-iii-finding-ledger.md" | awk '{print $1}')"
    [[ "$finding_ledger_sha256" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "unknown-pass2 tracked finding ledger cannot be hashed"
    archive="$run/execution/.unknown-pass2-inputs.tar.tmp.$$"
    staging="$run/execution/.unknown-pass2-inputs.tmp.$$"
    output="$run/artifacts/unknown-pass2"
    [[ ! -e "$archive" && ! -e "$staging" && ! -e "$output" ]] || \
        fail wrapper_failure "unknown-pass2 staging target already exists"
    if ! head -c "$archive_size" >"$archive"; then
        fail transfer_failure "unknown-pass2 input transfer failed"
    fi
    [[ "$(stat -c '%s' "$archive")" -eq "$archive_size" ]] || \
        fail transfer_failure "unknown-pass2 input was truncated"
    [[ "$(sha256sum "$archive" | awk '{print $1}')" == "$archive_sha256" ]] || \
        fail transfer_failure "unknown-pass2 archive checksum differs"
    if ! tar -tf "$archive" >"$run/logs/unknown-pass2-input-members.log" 2>&1; then
        fail transfer_failure "unknown-pass2 archive cannot be listed"
    fi
    if awk 'BEGIN { bad=0 } /^\// || /(^|\/)\.\.($|\/)/ { bad=1 } END { exit bad }' \
        "$run/logs/unknown-pass2-input-members.log"; then
        :
    else
        fail wrapper_failure "unknown-pass2 archive has an unsafe path"
    fi
    mkdir -m 700 "$staging"
    tar -xf "$archive" -C "$staging" \
        >"$run/logs/unknown-pass2-input-extract.log" 2>&1 || \
        fail transfer_failure "unknown-pass2 extraction failed"
    if find "$staging" -xdev -type l -print -quit | grep -q .; then
        fail wrapper_failure "unknown-pass2 input tree contains a symlink"
    fi
    observed_count="$(find "$staging" -xdev -type f | wc -l | awk '{print $1}')"
    [[ "$observed_count" -eq "$file_count" ]] || \
        fail transfer_failure "unknown-pass2 input file count differs"
    python="$run/source/.pixi/envs/hpc/bin/python"
    [[ -x "$python" ]] || fail environment_failure "locked Python is unavailable"
    "$python" -m genome_to_diffraction.hpc.unknown_pass2_inputs \
        "$staging" \
        --expected-input-id "$input_id" \
        --expected-source-commit "$source_commit" \
        --expected-source-tree "$source_tree" \
        --expected-parent-run-id "$parent_run_id" \
        --expected-finding-ledger-sha256 "$finding_ledger_sha256" \
        --write-checksums "$run/state/unknown-pass2-authority-checksums.sha256" \
        >"$run/logs/unknown-pass2-input-validation.log" 2>&1 || \
        fail wrapper_failure "unknown-pass2 input validation failed"
    mv -- "$staging" "$output"
    rm -f -- "$archive"
    atomic_text "$run/state/unknown-pass2-parent-run-id" "$parent_run_id"
    atomic_text "$run/state/unknown-pass2-input-id" "$input_id"
    atomic_text "$run/state/unknown-pass2-input-sha256" "$archive_sha256"
    atomic_text "$run/state/unknown-pass2-execution-identity-id" \
        "$execution_identity_id"
    atomic_text "$run/state/unknown-pass2-finding-closure-id" "$finding_closure_id"
    atomic_text "$run/state/unknown-pass2-source-tree" "$source_tree"
    atomic_text "$run/state/unknown-pass2-finding-ledger-sha256" \
        "$finding_ledger_sha256"
    atomic_text "$run/state/unknown-pass2-file-count" "$file_count"
    append_event "$run" "stage_unknown_pass2_bound"
    emit operation unknown-pass2-inputs-stage
    emit run_id "$run_id"
    emit parent_run_id "$parent_run_id"
    emit input_id "$input_id"
    emit finding_closure_id "$finding_closure_id"
    emit status ready
}

