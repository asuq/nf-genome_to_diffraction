validate_m6_smoke_site_state() {
    local run="$1"
    local expected_profile expected_policy expected_policy_id
    local policy actual_policy_sha cache
    local state_name
    for state_name in \
        site-id \
        nextflow-profile \
        execution-policy-relative \
        execution-policy-id \
        execution-policy-sha256 \
        apptainer-cache-dir; do
        [[ -f "$run/state/$state_name" && ! -L "$run/state/$state_name" && \
           -O "$run/state/$state_name" ]] || \
            fail wrapper_failure "M6 site policy state is absent or unsafe"
    done
    [[ "$(<"$run/state/site-id")" == "$SITE_ID" ]] || \
        fail wrapper_failure "M6 run site differs from the installed dispatcher"
    if [[ "$SITE_ID" == viper-cpu ]]; then
        expected_profile=viper-cpu
        expected_policy=benchmarks/m6/execution-nextflow-v1.yaml
        expected_policy_id=m6_nextflow_slurm_v1
    elif [[ "$SITE_ID" == marmic ]]; then
        expected_profile=marmic
        expected_policy=benchmarks/m6/execution-nextflow-marmic-v1.yaml
        expected_policy_id=m6_nextflow_slurm_marmic_v1
    else
        fail environment_failure "unsupported fixed HPC site"
    fi
    [[ "$(<"$run/state/nextflow-profile")" == "$expected_profile" && \
       "$(<"$run/state/execution-policy-relative")" == "$expected_policy" && \
       "$(<"$run/state/execution-policy-id")" == "$expected_policy_id" ]] || \
        fail wrapper_failure "M6 run site policy mapping changed after staging"
    policy="$run/source/$expected_policy"
    [[ -f "$policy" && ! -L "$policy" && -O "$policy" ]] || \
        fail filesystem_failure "fixed M6 execution policy is absent or unsafe"
    actual_policy_sha="$(sha256sum "$policy" | awk '{print $1}')"
    [[ "$actual_policy_sha" == \
       "$(<"$run/state/execution-policy-sha256")" ]] || \
        fail wrapper_failure "M6 execution policy changed after staging"
    cache="$(<"$run/state/apptainer-cache-dir")"
    [[ "$cache" == "$run/cache/apptainer" && -d "$cache" && \
       ! -L "$cache" && -O "$cache" ]] || \
        fail filesystem_failure "run-owned M6 Apptainer cache is unsafe"
}

