    local archive_sha256="$5" archive_size="$6" review_sha256="$7"
    local decisions_sha256="$8" mtz_sha256="$9"
    local run import_archive import_root stage_out gtd phenix_manifest
    local site_id run_root configured_pixi profile cache_root database_root configured_phenix
    local expected_home expected_root
    local staged_manifest seed_count candidate command original_sha staged_sha

    [[ "$archive_sha256" =~ $CHECKSUM_RE && "$review_sha256" =~ $CHECKSUM_RE && \
       "$decisions_sha256" =~ $CHECKSUM_RE && "$mtz_sha256" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "invalid M4 import checksum"
    [[ "$archive_size" =~ $BYTE_COUNT_RE ]] || \
        fail wrapper_failure "invalid M4 import size"
    (( archive_size >= 1 && archive_size <= MAX_M4_IMPORT_ARCHIVE_BYTES )) || \
        fail wrapper_failure "M4 import size is outside the fixed limit"
    [[ -f "$SITE_CONFIG" && ! -L "$SITE_CONFIG" && -O "$SITE_CONFIG" && \
       "$(stat -c '%a' "$SITE_CONFIG")" == 600 ]] || \
        fail environment_failure "fixed Viper site configuration is absent or unsafe"
    local -a site_values=()
    mapfile -t site_values < "$SITE_CONFIG"
    [[ "${#site_values[@]}" -eq 7 ]] || \
        fail environment_failure "fixed Viper site configuration must contain seven lines"
    site_id="${site_values[0]}"
    run_root="${site_values[1]}"
    configured_pixi="${site_values[2]}"
    profile="${site_values[3]}"
    cache_root="${site_values[4]}"
    database_root="${site_values[5]}"
    configured_phenix="${site_values[6]}"
    expected_home="/viper/u1/${USER}"
    expected_root="/ptmp/${USER}/nf-genome_to_diffraction"
    [[ "$site_id" == viper-cpu && "$run_root" == "$ROOT" && \
       "$profile" == viper-cpu && "$configured_pixi" == \
       "$expected_home/miniforge3/envs/pixi/bin/pixi" && \
       "$cache_root" == "/ptmp/${USER}/apptainer-cache" && \
       "$database_root" == "$expected_root/databases" && \
