        --discovery-package "$discovery_copy" \
        --outdir "$preparation" \
        >"$run/logs/unknown-screen-login-stage.log" 2>&1; then
        atomic_text "$run/state/phase" stage_failed
        atomic_text "$run/state/failure-class" transfer_failure
        append_event "$run" "stage_unknown_screen_acquisition_failed"
        fail transfer_failure "unknown-screen provider acquisition failed"
    fi
    if ! "$gtd" --no-progress --log-format json \
        structure-search validate-phase3-provider-login-stage \
        --preparation "$preparation" \
        >"$run/logs/unknown-screen-provider-validation.log" 2>&1; then
        atomic_text "$run/state/phase" stage_failed
        atomic_text "$run/state/failure-class" wrapper_failure
        append_event "$run" "stage_unknown_screen_preparation_invalid"
        fail wrapper_failure "unknown-screen provider preparation validation failed"
    fi
    preparation_sha256="$(sha256sum \
        "$preparation/provider_preparation.json" | awk '{print $1}')"
    [[ "$preparation_sha256" =~ $CHECKSUM_RE ]] || \
        fail filesystem_failure "unknown-screen provider checksum failed"
    preparation_checksums="$run/state/unknown-screen-provider-checksums.sha256"
    preparation_checksums_temporary="${preparation_checksums}.tmp.$$"
    (
        cd "$preparation"
        while IFS= read -r relative; do
            relative="${relative#./}"
            [[ "$relative" == provider_preparation.json ]] || sha256sum "$relative"
        done < <(find . -xdev -type f -print | LC_ALL=C sort)
    ) > "$preparation_checksums_temporary"
    preparation_file_count="$(wc -l < "$preparation_checksums_temporary")"
    [[ "$preparation_file_count" =~ $INTEGER_RE && \
       "$preparation_file_count" -ge 1 && \
       "$preparation_file_count" -le 1024 ]] || \
        fail filesystem_failure "unknown-screen provider inventory is invalid"
    mv -- "$screen_staging" "$screen_root"
    mv -f -- "$preparation_checksums_temporary" "$preparation_checksums"
    preparation="${screen_root}/provider_preparation"
    cp -- "$parent/state/unknown-discovery-input-checksums.sha256" \
        "$run/state/unknown-screen-input-checksums.sha256"
    cp -- "$parent/state/unknown-discovery-input-file-count" \
        "$run/state/unknown-screen-input-file-count"
    atomic_text "$run/state/unknown-discovery-parent-run-id" "$parent_run_id"
    atomic_text "$run/state/provider-preparation-sha256" "$preparation_sha256"
    atomic_text "$run/state/unknown-screen-provider-file-count" \
        "$preparation_file_count"
    atomic_text "$run/state/phase3-execution-identity-id" \
        "$(<"$parent/state/phase3-execution-identity-id")"
    append_event "$run" "stage_unknown_screen_provider_bound"
    trap - EXIT
    emit operation unknown-screen-stage
    emit run_id "$run_id"
    emit parent_run_id "$parent_run_id"
    emit provider_preparation_sha256 "$preparation_sha256"
    emit status ready
}

unknown_single_component_stage_run() {
    [[ "$#" -eq 7 ]] || \
        fail wrapper_failure \
            "unknown-single-component-stage expects seven fixed fields"
    local run_id="$1" owner_id="$2" parent_run_id="$3" parent_owner_id="$4"
    local input_id="$5" archive_sha256="$6" archive_size="$7"
    local run parent profile parent_profile archive staging actual_sha256
    local unsafe_member python output stage_sha256 authority_checksums
    local authority_checksums_temporary authority_file_count actual_authority_count
    validate_run_id "$run_id"
    validate_owner "$owner_id"
    validate_run_id "$parent_run_id"
    validate_owner "$parent_owner_id"
    [[ "$input_id" =~ ^unknownsingleinputs_[a-f0-9]{64}$ ]] || \
        fail wrapper_failure "invalid unknown-single-component input ID"
    [[ "$archive_sha256" =~ $CHECKSUM_RE && \
       "$archive_size" =~ $BYTE_COUNT_RE ]] || \
        fail wrapper_failure "invalid unknown-single-component archive identity"
    (( archive_size >= 1 && archive_size <= MAX_UNKNOWN_SINGLE_INPUT_ARCHIVE_BYTES )) || \
        fail wrapper_failure "unknown-single-component archive exceeds its bound"
    require_owned_run "$run_id" "$owner_id"
    require_owned_run "$parent_run_id" "$parent_owner_id"
    run="$(run_directory "$run_id")"
    parent="$(run_directory "$parent_run_id")"
    profile="$(<"$run/state/profile")"
    parent_profile="$(<"$parent/state/profile")"
    [[ "$profile" == unknown-single-component && \
       "$parent_profile" == unknown-screen ]] || \
        fail wrapper_failure "unknown-single-component has an invalid profile chain"
    [[ "$(<"$run/state/phase")" == staged && ! -e "$run/state/job-id" ]] || \
        fail wrapper_failure "unknown-single-component child is not safely staged"
    [[ "$(<"$parent/state/phase")" == completed && \
       "$(<"$parent/state/failure-class")" == success && \
       "$(<"$parent/state/exit-code")" == 0 && \
       -f "$parent/state/job-result.json" ]] || \
        fail wrapper_failure "unknown-single-component parent is not successful"
    [[ "$(<"$run/state/site-id")" == "$(<"$parent/state/site-id")" && \
       "$(<"$run/state/commit")" == "$(<"$parent/state/commit")" && \
       "$(<"$run/state/phenix-manifest-sha256")" == \
       "$(<"$parent/state/phenix-manifest-sha256")" && \
       "$(<"$run/state/p0-config-sha256")" == \
       "$(<"$parent/state/p0-config-sha256")" && \
       "$(<"$run/state/database-manifest-sha256")" == \
       "$(<"$parent/state/database-manifest-sha256")" ]] || \
        fail wrapper_failure "unknown-single-component authorities differ"
    archive="$run/execution/.unknown-single-inputs.tar.tmp.$$"
    staging="$run/execution/.unknown-single-inputs.tmp.$$"
    output="$run/artifacts/unknown-single-component"
    [[ ! -e "$output" && ! -L "$output" ]] || \
        fail wrapper_failure "unknown-single-component output already exists"
    trap 'rm -f -- "${archive:-}"; rm -rf -- "${staging:-}"' EXIT
    head -c "$archive_size" > "$archive" || \
        fail transfer_failure "unknown-single-component input transfer failed"
    [[ "$(file_size "$archive")" == "$archive_size" ]] || \
        fail transfer_failure "unknown-single-component input was truncated"
    actual_sha256="$(sha256sum "$archive" | awk '{print $1}')"
    [[ "$actual_sha256" == "$archive_sha256" ]] || \
        fail transfer_failure "unknown-single-component archive checksum differs"
    if ! tar -tf "$archive" > \
        "$run/logs/unknown-single-component-input-members.log" 2>&1; then
        fail transfer_failure "unknown-single-component archive cannot be listed"
    fi
    if awk 'BEGIN {bad=0} /^\// || /(^|\/)\.\.($|\/)/ {bad=1} END {exit bad ? 0 : 1}' \
        "$run/logs/unknown-single-component-input-members.log"; then
        fail wrapper_failure "unknown-single-component archive has an unsafe path"
    fi
    mkdir -- "$staging"
    tar --no-same-owner --no-same-permissions -xf "$archive" -C "$staging" \
        >"$run/logs/unknown-single-component-input-extract.log" 2>&1 || \
        fail transfer_failure "unknown-single-component extraction failed"
    unsafe_member="$(find "$staging" -xdev \
        \( -type l -o \( ! -type f ! -type d \) \) -print -quit)"
    [[ -z "$unsafe_member" ]] || \
        fail wrapper_failure "unknown-single-component input tree is unsafe"
    python="$run/source/.pixi/envs/hpc/bin/python"
    [[ -x "$python" ]] || \
        fail environment_failure "locked continuation Python is unavailable"
    PYTHONPATH="$run/source/src" \
    "$python" -m genome_to_diffraction.hpc.unknown_single_inputs validate \
        --input-root "$staging" \
        --expected-input-id "$input_id" \
        --expected-parent-run-id "$parent_run_id" \
        >"$run/logs/unknown-single-component-input-validation.log" 2>&1 || \
        fail wrapper_failure "unknown-single-component input validation failed"
    PYTHONPATH="$run/source/src" \
    "$python" -m genome_to_diffraction.hpc.unknown_single_inputs stage-handoff \
        --parent-run-root "$parent" \
        --child-run-root "$run" \
        --input-root "$staging" \
        --child-run-id "$run_id" \
        --expected-input-id "$input_id" \
        >"$run/logs/unknown-single-component-handoff.log" 2>&1 || \
        fail wrapper_failure "unknown-single-component handoff failed"
    stage_sha256="$(sha256sum \
        "$output/unknown_single_component_stage_manifest.json" | awk '{print $1}')"
    [[ "$stage_sha256" =~ $CHECKSUM_RE ]] || \
        fail filesystem_failure "unknown-single-component stage checksum failed"
    mv -- "$staging" "$output/operator_decisions"
    find "$output/operator_decisions" -xdev -type f -exec chmod 0444 {} +
    find "$output/operator_decisions" -xdev -type d -exec chmod 0555 {} +
    authority_checksums="$run/state/unknown-single-authority-checksums.sha256"
    authority_checksums_temporary="${authority_checksums}.tmp.$$"
    (
        cd "$output"
        while IFS= read -r relative; do
            relative="${relative#./}"
            sha256sum "$relative"
        done < <(find . -xdev -type f -print | LC_ALL=C sort)
    ) > "$authority_checksums_temporary"
    authority_file_count="$(wc -l < "$authority_checksums_temporary")"
    actual_authority_count="$(find "$output" -xdev -type f | wc -l)"
    [[ "$authority_file_count" =~ $INTEGER_RE && \
       "$actual_authority_count" =~ $INTEGER_RE && \
       "$authority_file_count" -eq "$actual_authority_count" && \
       "$authority_file_count" -ge 1 && \
       "$authority_file_count" -le 4096 ]] || \
        fail filesystem_failure "unknown-single-component authority is incomplete"
    mv -f -- "$authority_checksums_temporary" "$authority_checksums"
    rm -f -- "$archive"
    atomic_text "$run/state/unknown-screen-parent-run-id" "$parent_run_id"
    atomic_text "$run/state/unknown-single-input-id" "$input_id"
    atomic_text "$run/state/unknown-single-stage-sha256" "$stage_sha256"
    atomic_text "$run/state/unknown-single-authority-file-count" \
        "$authority_file_count"
    atomic_text "$run/state/phase3-execution-identity-id" \
        "$(<"$parent/state/phase3-execution-identity-id")"
    append_event "$run" "stage_unknown_single_component_bound"
    trap - EXIT
    emit operation unknown-single-component-stage
    emit run_id "$run_id"
    emit parent_run_id "$parent_run_id"
    emit input_id "$input_id"
    emit stage_sha256 "$stage_sha256"
    emit status ready
}

m4_copy_stage_run() {
    [[ "$#" -eq 10 ]] || \
        fail wrapper_failure "m4-copy-stage expects ten fixed arguments"
    local run_id="$1"
    local commit="$2"
    local lock_sha256="$3"
    local owner_id="$4"
    local iteration="$5"
    local parent_run_id="$6"
    local parent_owner_id="$7"
    local decisions_sha256="$8"
    local review_sha256="$9"
    local decisions_base64="${10}"
    local run parent decisions stage_out gtd mtz_candidate mtz phenix_manifest
    local staged_manifest seed_count
    local -a p0_values=()

    validate_run_id "$parent_run_id"
    [[ "$parent_run_id" == gtd-p2-diverse-* ]] || \
        fail wrapper_failure "M4 parent must be a retained P2-diverse run"
    validate_owner "$parent_owner_id"
    [[ "$decisions_sha256" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "invalid M4 decisions checksum"
    [[ "$review_sha256" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "invalid M4 review checksum"
    require_owned_run "$parent_run_id" "$parent_owner_id"
    parent="$(run_directory "$parent_run_id")"
    [[ "$(<"$parent/state/profile")" == p2-diverse && \
       "$(<"$parent/state/phase")" == completed && \
       "$(<"$parent/state/failure-class")" == success && \
       "$(<"$parent/state/exit-code")" == 0 ]] || \
        fail wrapper_failure "M4 parent is not a retained successful P2-diverse run"
    [[ -f "$parent/artifacts/qualification/p2-diverse-review/mr_seed_review_manifest.json" && \
       "$(sha256sum "$parent/artifacts/qualification/p2-diverse-review/mr_seed_review_manifest.json" | awk '{print $1}')" == \
       "$review_sha256" ]] || \
        fail transfer_failure "retained M4 review manifest differs from local evidence"

    stage_run_common \
        "$run_id" "$commit" "$lock_sha256" "$owner_id" "$iteration" m4-copy
    run="$(run_directory "$run_id")"
    atomic_text "$run/state/phase" m4_input_staging
    atomic_text "$run/state/parent-run-id" "$parent_run_id"
    atomic_text "$run/state/parent-owner-id" "$parent_owner_id"
    atomic_text "$run/state/m4-decisions-sha256" "$decisions_sha256"
    atomic_text "$run/state/m4-review-manifest-sha256" "$review_sha256"
    decisions="$run/artifacts/m4-copy-decisions.tsv"
    if ! printf '%s' "$decisions_base64" | base64 -d > "$decisions" 2>"$DISCARD"; then
        atomic_text "$run/state/phase" stage_failed
        atomic_text "$run/state/failure-class" transfer_failure
        fail transfer_failure "M4 decisions are not valid base64"
    fi
    [[ -s "$decisions" && "$(file_size "$decisions")" -le 32768 && \
       "$(sha256sum "$decisions" | awk '{print $1}')" == "$decisions_sha256" ]] || {
        atomic_text "$run/state/phase" stage_failed
        atomic_text "$run/state/failure-class" transfer_failure
        fail transfer_failure "M4 decisions payload failed size or checksum validation"
    }
    mapfile -t p0_values < "$P0_CONFIG"
    [[ "${#p0_values[@]}" -eq 7 ]] || \
        fail wrapper_failure "P0 configuration changed during M4 staging"
    phenix_manifest="${p0_values[6]}"
    [[ "$(basename "$(dirname "${p0_values[2]}")")" == manifests ]] || \
        fail wrapper_failure "M4 requires the checksum-frozen P0 bundle layout"
    mtz_candidate="$(dirname "$(dirname "${p0_values[2]}")")/inputs/CD6QS2P2G1_5.mtz"
    mtz="$(realpath -e "$mtz_candidate")" || \
        fail filesystem_failure "fixed CD6 MTZ cannot be resolved for M4"
    [[ "$mtz" == "$mtz_candidate" && -f "$mtz" && ! -L "$mtz_candidate" ]] || \
        fail filesystem_failure "fixed CD6 MTZ is unsafe for M4"

    stage_out="$run/artifacts/m4-copy-inputs"
    gtd="$run/source/.pixi/envs/hpc/bin/genome-to-diffraction"
    if ! "$gtd" --log-format json --no-progress mr stage-add-copy \
        --parent-run "$parent" \
        --decisions "$decisions" \
        --review-manifest-sha256 "$review_sha256" \
        --mtz "$mtz" \
        --phenix-manifest "$phenix_manifest" \
        --outdir "$stage_out" \
        --expected-seed-count 11 \
        > "$run/logs/m4-copy-stage.log" 2>&1; then
        atomic_text "$run/state/phase" stage_failed
        atomic_text "$run/state/failure-class" test_failure
        append_event "$run" m4_copy_input_stage_failed
        fail test_failure "checksum-bound M4 input staging failed"
    fi
    staged_manifest="$stage_out/m4_copy_stage_manifest.json"
    [[ -f "$staged_manifest" && ! -L "$staged_manifest" ]] || \
        fail filesystem_failure "M4 stage manifest was not produced"
    seed_count="$(awk 'NR > 1 && NF { count++ } END { print count + 0 }' \
        "$stage_out/seeds.tsv")"
    [[ "$seed_count" -eq 11 ]] || \
        fail test_failure "M4 stage did not retain exactly 11 approved seeds"
    atomic_text "$run/state/m4-stage-manifest-sha256" \
        "$(sha256sum "$staged_manifest" | awk '{print $1}')"
    atomic_text "$run/state/phase" staged
    append_event "$run" m4_copy_inputs_ready
    emit operation m4-copy-stage
    emit run_id "$run_id"
    emit parent_run_id "$parent_run_id"
    emit seed_count "$seed_count"
    emit decisions_sha256 "$decisions_sha256"
    emit review_manifest_sha256 "$review_sha256"
    emit phase staged
}

