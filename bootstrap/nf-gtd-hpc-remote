       ! -L "$configured_phenix" ]] || \
        fail environment_failure "fixed Viper Pixi or Phenix manifest is unavailable"

    M4_CROSS_SITE_IMPORT=true stage_run_common \
        "$run_id" "$commit" "$lock_sha256" "$owner_id" 1 m4-copy
    run="$(run_directory "$run_id")"
    atomic_text "$run/state/site-id" viper-cpu
    atomic_text "$run/state/phase" m4_importing
    import_archive="$run/m4-import.tar.gz"
    head -c "$archive_size" > "$import_archive" || \
        fail transfer_failure "M4 import stream failed"
    [[ "$(wc -c < "$import_archive")" -eq "$archive_size" && \
       "$(sha256sum "$import_archive" | awk '{print $1}')" == "$archive_sha256" ]] || \
        fail transfer_failure "M4 import archive is truncated or changed"
    import_root="$run/artifacts/m4-import-parent"
    mkdir -m 0700 "$import_root"
    if ! "$run/source/.pixi/envs/hpc/bin/python" - \
        "$import_archive" "$import_root" \
        > "$run/logs/m4-import-members.log" 2>&1 <<'PY'
import pathlib, sys, tarfile
archive_path = pathlib.Path(sys.argv[1])
destination = pathlib.Path(sys.argv[2])
with tarfile.open(archive_path, "r:gz") as archive:
    members = archive.getmembers()
    names = []
    for member in members:
        path = pathlib.PurePosixPath(member.name)
        if path.is_absolute() or ".." in path.parts or not member.isfile():
            raise SystemExit("unsafe M4 import archive member")
        names.append(path.as_posix())
    if len(names) != len(set(names)) or "m4_import_manifest.json" not in names:
        raise SystemExit("invalid M4 import archive inventory")
    for name in sorted(names):
        print(name)
    archive.extractall(destination, members=members, filter="data")
PY
    then
        fail wrapper_failure "M4 import archive validation or extraction failed"
    fi
    rm -f -- "$import_archive"
    [[ "$(sha256sum "$import_root/review_package/mr_seed_review_manifest.json" | awk '{print $1}')" == \
       "$review_sha256" && \
       "$(sha256sum "$import_root/decisions.tsv" | awk '{print $1}')" == \
       "$decisions_sha256" && \
       "$(sha256sum "$import_root/inputs/CD6QS2P2G1_5.mtz" | awk '{print $1}')" == \
       "$mtz_sha256" ]] || \
        fail transfer_failure "M4 import identity anchors changed"
    "$run/source/.pixi/envs/hpc/bin/python" - "$import_root" <<'PY'
import hashlib, json, pathlib, sys
root = pathlib.Path(sys.argv[1])
manifest = json.loads((root / "m4_import_manifest.json").read_text())
if manifest.get("adapter_version") != "m4-cross-site-import-v1": raise SystemExit(1)
if manifest.get("source_site_id") != "marmic": raise SystemExit(1)
if manifest.get("destination_site_id") != "viper-cpu": raise SystemExit(1)
if manifest.get("seed_count") != 11: raise SystemExit(1)
inventory = manifest.get("inventory")
if not isinstance(inventory, dict): raise SystemExit(1)
for relative, record in inventory.items():
    path = root / relative
    if path.is_symlink() or not path.is_file(): raise SystemExit(1)
    if hashlib.sha256(path.read_bytes()).hexdigest() != record.get("sha256"):
        raise SystemExit(1)
PY
    atomic_text "$run/state/parent-run-id" \
        "gtd-p2-diverse-20260812T045236Z-5b5100e8651c-1f2fe41a"
    atomic_text "$run/state/parent-site-id" marmic
    atomic_text "$run/state/m4-import-archive-sha256" "$archive_sha256"
    atomic_text "$run/state/m4-decisions-sha256" "$decisions_sha256"
    atomic_text "$run/state/m4-review-manifest-sha256" "$review_sha256"
    atomic_text "$run/state/m4-mtz-sha256" "$mtz_sha256"
    stage_out="$run/artifacts/m4-copy-inputs"
    gtd="$run/source/.pixi/envs/hpc/bin/genome-to-diffraction"
    if ! "$gtd" --log-format json --no-progress mr stage-add-copy \
        --parent-run "$import_root" \
        --decisions "$import_root/decisions.tsv" \
        --review-manifest-sha256 "$review_sha256" \
        --mtz "$import_root/inputs/CD6QS2P2G1_5.mtz" \
        --phenix-manifest "$configured_phenix" \
        --outdir "$stage_out" \
        --expected-seed-count 11 \
        --use-solution-coordinates-as-models \
        --source-site-id marmic \
        > "$run/logs/m4-import-stage.log" 2>&1; then
        atomic_text "$run/state/phase" stage_failed
        atomic_text "$run/state/failure-class" test_failure
        fail test_failure "checksum-bound cross-site M4 staging failed"
    fi
    staged_manifest="$stage_out/m4_copy_stage_manifest.json"
    seed_count="$(awk 'NR > 1 && NF { count++ } END { print count + 0 }' \
        "$stage_out/seeds.tsv")"
    [[ "$seed_count" -eq 11 && -f "$staged_manifest" && ! -L "$staged_manifest" ]] || \
        fail test_failure "cross-site M4 stage did not retain exactly 11 seeds"
    while IFS=$'\t' read -r candidate _ staged_sha; do
        [[ "$candidate" == seed_solution_id ]] && continue
        command="$import_root/review_package/assets/$candidate/phaser_command.json"
        original_sha="$(sed -n 's/.*"model_sha256"[[:space:]]*:[[:space:]]*"\([0-9a-f]\{64\}\)".*/\1/p' "$command")"
        [[ "$original_sha" =~ $CHECKSUM_RE && "$staged_sha" =~ $CHECKSUM_RE ]] || \
            fail test_failure "cross-site model provenance is incomplete"
    done < "$stage_out/seeds.tsv"
    atomic_text "$run/state/m4-stage-manifest-sha256" \
        "$(sha256sum "$staged_manifest" | awk '{print $1}')"
    atomic_text "$run/state/phase" staged
    append_event "$run" m4_import_inputs_ready
    emit operation m4-import-stage
    emit run_id "$run_id"
    emit site_id viper-cpu
    emit source_site_id marmic
    emit seed_count "$seed_count"
    emit archive_sha256 "$archive_sha256"
    emit phase staged
}

