control_slice_stage_run() {
    [[ "$#" -eq 8 ]] || \
        fail wrapper_failure "control-slice-stage expects eight fixed arguments"
    local run_id="$1" commit="$2" lock_sha256="$3" owner_id="$4"
    local archive_sha256="$5" archive_size="$6" manifest_sha256="$7"
    local case_count="$8" run import_archive import_root python phenix_manifest

    [[ "$archive_sha256" =~ $CHECKSUM_RE && \
       "$manifest_sha256" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "invalid control-slice checksum"
    [[ "$archive_size" =~ $BYTE_COUNT_RE && "$case_count" =~ $INTEGER_RE ]] || \
        fail wrapper_failure "invalid control-slice size or case count"
    (( archive_size >= 1 && archive_size <= MAX_CONTROL_SLICE_ARCHIVE_BYTES )) || \
        fail wrapper_failure "control-slice archive is outside the fixed limit"
    [[ "$case_count" -eq 6 ]] || \
        fail wrapper_failure "control-slice must contain exactly six cases"
    [[ -f "$SITE_CONFIG" && ! -L "$SITE_CONFIG" && \
       "$(head -n 1 "$SITE_CONFIG")" == viper-cpu ]] || \
        fail environment_failure "control-slice-stage requires the fixed Viper site"
    phenix_manifest="$(sed -n '7p' "$SITE_CONFIG")"
    [[ "$phenix_manifest" =~ $SAFE_PATH_RE && -f "$phenix_manifest" && \
       ! -L "$phenix_manifest" ]] || \
        fail environment_failure "fixed Viper Phenix manifest is unavailable"

    stage_run_common \
        "$run_id" "$commit" "$lock_sha256" "$owner_id" 1 control-slice
    run="$(run_directory "$run_id")"
    atomic_text "$run/state/phase" control_slice_importing
    import_archive="$run/control-slice.tar.gz"
    head -c "$archive_size" > "$import_archive" || \
        fail transfer_failure "control-slice archive transfer failed"
    [[ "$(file_size "$import_archive")" -eq "$archive_size" && \
       "$(sha256sum "$import_archive" | awk '{print $1}')" == \
       "$archive_sha256" ]] || \
        fail transfer_failure "control-slice archive changed during transfer"

    import_root="$run/artifacts/control-slice-inputs"
    mkdir -m 0700 "$import_root"
    python="$run/source/.pixi/envs/hpc/bin/python"
    if ! "$python" - "$import_archive" "$import_root" "$manifest_sha256" \
        > "$run/logs/control-slice-stage.log" 2>&1 <<'PY'
import hashlib
import json
import pathlib
import sys
import tarfile

archive_path = pathlib.Path(sys.argv[1])
destination = pathlib.Path(sys.argv[2])
expected_manifest_sha256 = sys.argv[3]
expected_cases = [
    "POS_1JCF",
    "POS_3W45",
    "NEG_MODEL_3W45_6HF7",
    "NEG_ABSENT_3W45",
    "NEG_CATALOGUE_3W45_1JCF",
    "NEG_ASSUMPTION_6CXH",
]
expected_assets = {
    "controls/NEG_MODEL_3W45_6HF7/model.pdb",
    "controls/PDB_1JCF/input.mtz",
    "controls/PDB_1JCF/models/pdb_1jce_chain_a_exact.pdb",
    "controls/PDB_1JCF/models/pdb_8azg_chain_m_homolog.pdb",
    "controls/PDB_1JCF/proteome.faa",
    "controls/PDB_3W45/input.mtz",
    "controls/PDB_3W45/models/pdb_3t91_chain_a_homolog.pdb",
    "controls/PDB_3W45/models/pdb_3w43_chain_a_exact.pdb",
    "controls/PDB_3W45/proteome.faa",
}
with tarfile.open(archive_path, "r:gz") as archive:
    members = archive.getmembers()
    names = []
    for member in members:
        path = pathlib.PurePosixPath(member.name)
        if path.is_absolute() or ".." in path.parts or not member.isfile():
            raise SystemExit("unsafe control-slice archive member")
        names.append(path.as_posix())
    if len(names) != len(set(names)):
        raise SystemExit("duplicate control-slice archive member")
    expected_names = expected_assets | {"control_slice_import_manifest.json"}
    if set(names) != expected_names:
        raise SystemExit("control-slice archive inventory differs from fixed slice")
    archive.extractall(destination, members=members, filter="data")

manifest_path = destination / "control_slice_import_manifest.json"
manifest_bytes = manifest_path.read_bytes()
if hashlib.sha256(manifest_bytes).hexdigest() != expected_manifest_sha256:
    raise SystemExit("control-slice manifest checksum changed")
manifest = json.loads(manifest_bytes)
