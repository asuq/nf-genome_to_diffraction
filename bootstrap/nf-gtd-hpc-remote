#!/usr/bin/env bash
# Fixed site-isolated dispatcher for immutable nf-genome_to_diffraction profiles.

set -euo pipefail
umask 077

RUN_ID_RE='^gtd-(smoke|p0|p1|p2-diverse|p2-control|p2|heteromer-smoke|phase3-phenix-probe|phase3-network-probe|unknown-discovery|unknown-screen|unknown-single-component|unknown-pass2|control-slice|control-matrix|m6-inputs|m6-nextflow-smoke|m6-operational|m6-leakage|m4-copy|t12|database)-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}-[0-9a-f]{8}$'
PROFILE_RE='^(smoke|p0|p1|p2-diverse|p2-control|p2|heteromer-smoke|phase3-phenix-probe|phase3-network-probe|unknown-discovery|unknown-screen|unknown-single-component|unknown-pass2|control-slice|control-matrix|m6-inputs|m6-nextflow-smoke|m6-operational|m6-leakage|m4-copy|t12|database)$'
COMMIT_RE='^[0-9a-f]{40}$'
CHECKSUM_RE='^[0-9a-f]{64}$'
OWNER_RE='^[0-9a-f]{32}$'
INTEGER_RE='^[0-9]+$'
BYTE_COUNT_RE='^(0|[1-9][0-9]*)$'
SAFE_PATH_RE='^/[A-Za-z0-9._/-]+$'
MAX_FILE_BYTES=$((128 * 1024 * 1024))
MAX_TOTAL_BYTES=$((12 * 1024 * 1024 * 1024))
MAX_LOG_BYTES=$((2 * 1024 * 1024))
MAX_NEXTFLOW_DIAGNOSTIC_BYTES=$((2 * 1024 * 1024))
MAX_REVIEW_FILE_BYTES=$((128 * 1024 * 1024))
MAX_REVIEW_TOTAL_BYTES=$((512 * 1024 * 1024))
MAX_P0_INPUT_ARCHIVE_BYTES=$((128 * 1024 * 1024))
MAX_UNKNOWN_DISCOVERY_INPUT_ARCHIVE_BYTES=$((512 * 1024 * 1024))
MAX_UNKNOWN_SINGLE_INPUT_ARCHIVE_BYTES=$((4 * 1024 * 1024))
MAX_UNKNOWN_PASS2_INPUT_ARCHIVE_BYTES=$((8 * 1024 * 1024 * 1024))
MAX_SOURCE_ARCHIVE_BYTES=$((64 * 1024 * 1024))
MAX_M4_IMPORT_ARCHIVE_BYTES=$((128 * 1024 * 1024))
MAX_CONTROL_SLICE_ARCHIVE_BYTES=$((64 * 1024 * 1024))
MAX_CONTROL_MATRIX_ARCHIVE_BYTES=$((128 * 1024 * 1024))
MAX_M6_RUNNER_ARCHIVE_BYTES=$((256 * 1024 * 1024))
MAX_T12_SOURCE_RECORD_BYTES=$((2 * 1024 * 1024))

TOOL_DIR="$(cd "$(dirname "$0")" && pwd -P)"
LEGACY_ROOT="$(cd "$TOOL_DIR/.." && pwd -P)"
SITE_CONFIG="$TOOL_DIR/site.paths"
ROOT="$LEGACY_ROOT"
SITE_ID=marmic
if [[ -e "$SITE_CONFIG" || -L "$SITE_CONFIG" ]]; then
    [[ -f "$SITE_CONFIG" && ! -L "$SITE_CONFIG" ]] || {
        printf 'unsafe HPC site configuration\n' >&2
        exit 1
    }
    IFS= read -r site_config_id < "$SITE_CONFIG" || true
    if [[ "$site_config_id" == viper-cpu ]]; then
        [[ -O "$SITE_CONFIG" && "$(stat -c '%a' "$SITE_CONFIG")" == 600 ]] || {
            printf 'unsafe Viper site configuration\n' >&2
            exit 1
        }
        [[ "${USER:-}" =~ ^[A-Za-z0-9._-]+$ ]] || {
            printf 'unsafe Viper account identity\n' >&2
            exit 1
        }
        mapfile -t startup_site_values < "$SITE_CONFIG"
        expected_viper_home="/viper/u1/${USER}"
        expected_viper_root="/ptmp/${USER}/nf-genome_to_diffraction"
        [[ "${#startup_site_values[@]}" -eq 7 && \
           "${startup_site_values[0]}" == viper-cpu && \
           "${startup_site_values[1]}" == "$expected_viper_root" && \
           "${startup_site_values[2]}" == \
           "$expected_viper_home/miniforge3/envs/pixi/bin/pixi" && \
           "${startup_site_values[3]}" == viper-cpu && \
           "${startup_site_values[4]}" == "/ptmp/${USER}/apptainer-cache" && \
           "${startup_site_values[5]}" == "$expected_viper_root/databases" && \
           "${startup_site_values[6]}" == \
           "$expected_viper_home/Softwares/manifests/phenix-2.1-6048.json" ]] || {
            printf 'Viper site configuration differs from reviewed fixed paths\n' >&2
            exit 1
        }
        ROOT="$expected_viper_root"
        SITE_ID=viper-cpu
    elif [[ "$site_config_id" == marmic ]]; then
        [[ -O "$SITE_CONFIG" && "$(stat -c '%a' "$SITE_CONFIG")" == 600 ]] || {
            printf 'unsafe Marmic site configuration\n' >&2
            exit 1
        }
        mapfile -t startup_site_values < "$SITE_CONFIG"
        [[ "${#startup_site_values[@]}" -eq 1 && \
           "${startup_site_values[0]}" == marmic ]] || {
            printf 'Marmic site configuration differs from the reviewed fixed identity\n' >&2
            exit 1
        }
    else
        printf 'unsupported HPC site configuration\n' >&2
        exit 1
    fi
fi
RUNS="$ROOT/runs"
MIRROR="$ROOT/_cache/git/nf-genome_to_diffraction.git"
LOCKS="$ROOT/_locks"
PIXI_PATH_FILE="$TOOL_DIR/pixi.path"
P0_CONFIG="$ROOT/_config/p0.paths"
P0_INPUTS="$ROOT/_p0_inputs"
DATABASE_CONFIG="$ROOT/_config/database.paths"
DISPATCHER="$TOOL_DIR/nf-gtd-hpc-remote"
SMOKE_JOB="$TOOL_DIR/nf-gtd-hpc-smoke-job"
DISCARD="$TOOL_DIR/.discard"

emit() {
    local key="$1"
    local value="${2-}"
    printf '%s\t' "$key"
    printf '%s' "$value" | base64 | tr -d '\n'
    printf '\n'
}

fail() {
    emit failure_class "$1"
    emit message "$2"
    exit 1
}

now_utc() {
    date -u '+%Y-%m-%dT%H:%M:%SZ'
}

validate_run_id() {
    [[ "$1" =~ $RUN_ID_RE ]] || fail wrapper_failure "invalid run ID"
}

validate_owner() {
    [[ "$1" =~ $OWNER_RE ]] || fail wrapper_failure "invalid owner ID"
}

validate_profile() {
    [[ "$1" =~ $PROFILE_RE ]] || fail wrapper_failure "invalid fixed profile"
}

run_directory() {
    printf '%s/%s' "$RUNS" "$1"
}

require_owned_run() {
    local run_id="$1"
    local owner_id="$2"
    local run
    validate_run_id "$run_id"
    validate_owner "$owner_id"
    run="$(run_directory "$run_id")"
    [[ -d "$run" ]] || fail filesystem_failure "remote run does not exist"
    [[ -f "$run/state/owner-id" ]] || fail wrapper_failure "run owner record is absent"
    [[ "$(<"$run/state/owner-id")" == "$owner_id" ]] || \
        fail wrapper_failure "run ownership does not match the local capability"
}

atomic_text() {
    local path="$1"
    local value="$2"
    local temporary="${path}.tmp.$$"
    printf '%s\n' "$value" > "$temporary"
    mv -f -- "$temporary" "$path"
}

append_event() {
    local run="$1"
    local event="$2"
    local timestamp
    timestamp="$(now_utc)"
    printf '{"event":"%s","timestamp":"%s"}\n' "$event" "$timestamp" \
        >> "$run/events.jsonl"
}

file_size() {
    stat -c '%s' "$1" 2>"$DISCARD" || stat -f '%z' "$1"
}

scheduler_queue_state() {
    local job_id="$1"
    local state
    # Marmic squeue exits 1 after a job leaves the live queue. That means
    # "not queued", not a dispatcher failure; sacct supplies terminal state.
    state="$(squeue -h -j "$job_id" -o '%T' 2>"$DISCARD" || true)"
    state="${state%%$'\n'*}"
    printf '%s' "$state"
}

resolve_pixi() {
    local pixi_bin=""
    if [[ -f "$PIXI_PATH_FILE" ]]; then
        IFS= read -r pixi_bin < "$PIXI_PATH_FILE"
    else
        pixi_bin="$(command -v pixi || true)"
    fi
    [[ "$pixi_bin" =~ $SAFE_PATH_RE ]] || \
        fail environment_failure "Pixi is not available as a safe absolute executable path"
    [[ -x "$pixi_bin" ]] || fail environment_failure "Pixi executable is not executable"
    RESOLVED_PIXI="$pixi_bin"
}

path_within_root() {
    local root="$1"
    local path="$2"
    [[ "$path" == "$root"/* ]]
}

p0_config_readiness() {
    local allowed candidate resolved index
    local -a values=()
    local config_path="${1:-$P0_CONFIG}"
    P0_CONFIG_STATUS=unknown
    P0_CONFIG_SHA256=""
    P0_DATABASE_MANIFEST=""
    if [[ ! -f "$config_path" || -L "$config_path" || ! -O "$config_path" ]]; then
        P0_CONFIG_STATUS=absent_or_unsafe
        return 1
    fi
    if [[ "$(stat -c '%a' "$config_path")" != 600 ]]; then
        P0_CONFIG_STATUS=mode_mismatch
        return 1
    fi
    P0_CONFIG_SHA256="$(sha256sum "$config_path" | awk '{print $1}')"
    if [[ ! "$P0_CONFIG_SHA256" =~ $CHECKSUM_RE ]]; then
        P0_CONFIG_STATUS=checksum_failure
        return 1
    fi
    mapfile -t values < "$config_path"
    if [[ "${#values[@]}" -ne 7 ]]; then
        P0_CONFIG_STATUS=line_count_mismatch
        return 1
    fi
    for candidate in "${values[@]}"; do
        if [[ ! "$candidate" =~ $SAFE_PATH_RE ]]; then
            P0_CONFIG_STATUS=unsafe_path
            return 1
        fi
    done
    if ! allowed="$(realpath -e "${values[0]}" 2>"$DISCARD")" || \
        [[ "$allowed" != "${values[0]}" || ! -d "$allowed" || -L "${values[0]}" || \
           ! -O "${values[0]}" || "$allowed" == / ]]; then
        P0_CONFIG_STATUS=allowed_root_invalid
        return 1
    fi
    for index in 1 2 3 5 6; do
        candidate="${values[$index]}"
        if ! resolved="$(realpath -e "$candidate" 2>"$DISCARD")" || \
            [[ "$resolved" != "$candidate" || ! -f "$resolved" || -L "$candidate" ]] || \
            ! path_within_root "$allowed" "$resolved"; then
            P0_CONFIG_STATUS=input_file_invalid
            return 1
        fi
    done
    candidate="${values[4]}"
    if ! resolved="$(realpath -e "$candidate" 2>"$DISCARD")" || \
        [[ "$resolved" != "$candidate" || ! -d "$resolved" || -L "$candidate" ]] || \
        ! path_within_root "$allowed" "$resolved"; then
        P0_CONFIG_STATUS=database_root_invalid
        return 1
    fi
    P0_DATABASE_MANIFEST="${values[5]}"
    P0_CONFIG_STATUS=ready
    return 0
}

readiness_p0() {
    [[ "$#" -eq 1 ]] || fail wrapper_failure "readiness expects one fixed profile"
    local profile="$1"
    local pixi_bin="" pixi_version="" pixi_status=unavailable ready=false
    validate_profile "$profile"
    [[ "$profile" == p0 || "$profile" == p1 || "$profile" == p2 || \
       "$profile" == p2-diverse || "$profile" == p2-control ]] || \
        fail wrapper_failure \
            "readiness is available only for p0, p1, p2, p2-diverse, and p2-control"

    if [[ -f "$PIXI_PATH_FILE" ]]; then
        IFS= read -r pixi_bin < "$PIXI_PATH_FILE"
    else
        pixi_bin="$(command -v pixi || true)"
    fi
    if [[ "$pixi_bin" =~ $SAFE_PATH_RE && -x "$pixi_bin" ]]; then
        if pixi_version="$("$pixi_bin" --version 2>&1)"; then
            if [[ "$pixi_version" =~ ^pixi[[:space:]]+0\.76\.2$ ]]; then
                pixi_status=ready
            else
                pixi_status=version_mismatch
            fi
        else
            pixi_status=version_check_failed
        fi
    fi
    p0_config_readiness || true
    if [[ "$pixi_status" == ready && "$P0_CONFIG_STATUS" == ready ]]; then
        ready=true
    fi

    emit operation readiness
    emit profile "$profile"
    emit ready "$ready"
    emit pixi_status "$pixi_status"
    emit pixi_version "$pixi_version"
    emit p0_config_status "$P0_CONFIG_STATUS"
    emit p0_config_sha256 "$P0_CONFIG_SHA256"
    emit scope staging_prerequisites_only
}

p0_configure() {
    [[ "$#" -eq 2 || "$#" -eq 3 ]] || \
        fail wrapper_failure \
            "p0-configure expects a checksum, encoded paths, and optional current checksum"
    local expected_checksum="$1"
    local encoded="$2"
    local replace_current_checksum="${3:-}"
    local config_directory resolved temporary actual_checksum status size
    local current_checksum retired run_candidate run_phase run_checksum
    local run_job_id scheduler_state sacct_line
    [[ "$expected_checksum" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "P0 configuration checksum is invalid"
    if [[ -n "$replace_current_checksum" ]]; then
        [[ "$replace_current_checksum" =~ $CHECKSUM_RE ]] || \
            fail wrapper_failure "current P0 configuration checksum is invalid"
        [[ "$replace_current_checksum" != "$expected_checksum" ]] || \
            fail wrapper_failure \
                "replacement P0 configuration must differ from the current checksum"
    fi
    [[ -n "$encoded" && "${#encoded}" -le 5464 && \
        "$encoded" =~ ^[A-Za-z0-9+/=]+$ ]] || \
        fail wrapper_failure "encoded P0 configuration is invalid"
    config_directory="$(dirname "$P0_CONFIG")"
    if [[ ! -e "$config_directory" && ! -L "$config_directory" ]]; then
        mkdir -p "$config_directory" || \
            fail filesystem_failure "P0 configuration directory cannot be created"
        chmod 0700 "$config_directory"
    fi
    resolved="$(realpath -e "$config_directory" 2>"$DISCARD")" || \
        fail filesystem_failure "P0 configuration directory cannot be resolved"
    [[ "$resolved" == "$config_directory" && -d "$config_directory" && \
        ! -L "$config_directory" && -O "$config_directory" ]] || \
        fail filesystem_failure "P0 configuration directory is unsafe"
    temporary="${P0_CONFIG}.tmp.$$"
    if ! printf '%s' "$encoded" | base64 -d > "$temporary"; then
        rm -f -- "$temporary"
        fail transfer_failure "P0 configuration payload cannot be decoded"
    fi
    chmod 0600 "$temporary"
    size="$(file_size "$temporary")"
    if [[ ! "$size" =~ $BYTE_COUNT_RE ]] || (( size < 1 || size > 4096 )); then
        rm -f -- "$temporary"
        fail wrapper_failure "P0 configuration payload size is invalid"
    fi
    actual_checksum="$(sha256sum "$temporary" | awk '{print $1}')"
    if [[ "$actual_checksum" != "$expected_checksum" ]]; then
        rm -f -- "$temporary"
        fail transfer_failure "P0 configuration checksum does not match"
    fi
    if ! p0_config_readiness "$temporary"; then
        status="$P0_CONFIG_STATUS"
        rm -f -- "$temporary"
        fail environment_failure "P0 configuration is not ready: $status"
    fi

    mkdir -p -- "$LOCKS"
    [[ -d "$LOCKS" && ! -L "$LOCKS" && -O "$LOCKS" ]] || {
        rm -f -- "$temporary"
        fail filesystem_failure "P0 configuration lock directory is unsafe"
    }
    exec 8>"$LOCKS/p0-configure.lock"
    flock -x 8
    exec 9>"$LOCKS/stage.lock"
    flock -x 9

    if [[ ! -e "$P0_CONFIG" && ! -L "$P0_CONFIG" ]]; then
        if [[ -n "$replace_current_checksum" ]]; then
            rm -f -- "$temporary"
            fail wrapper_failure "P0 configuration to replace is absent"
        fi
        if ! ln "$temporary" "$P0_CONFIG"; then
            rm -f -- "$temporary"
            fail filesystem_failure "P0 configuration could not be created atomically"
        fi
        rm -f -- "$temporary"
        emit operation p0-configure
        emit configured true
        emit p0_config_sha256 "$expected_checksum"
        emit p0_config_status ready
        return 0
    fi

    if [[ -z "$replace_current_checksum" ]]; then
        rm -f -- "$temporary"
        fail wrapper_failure "P0 configuration already exists"
    fi
    if ! p0_config_readiness "$P0_CONFIG"; then
        status="$P0_CONFIG_STATUS"
        rm -f -- "$temporary"
        fail environment_failure "current P0 configuration is not ready: $status"
    fi
    current_checksum="$P0_CONFIG_SHA256"
    retired="${P0_CONFIG}.retired-${replace_current_checksum}"

    if [[ "$current_checksum" == "$expected_checksum" ]]; then
        [[ -f "$retired" && ! -L "$retired" && -O "$retired" && \
           "$(sha256sum "$retired" | awk '{print $1}')" == \
             "$replace_current_checksum" ]] || {
            rm -f -- "$temporary"
            fail filesystem_failure \
                "idempotent P0 rotation lacks its checksum-retained predecessor"
        }
        rm -f -- "$temporary"
        emit operation p0-configure
        emit configured false
        emit rotated true
        emit previous_p0_config_sha256 "$replace_current_checksum"
        emit p0_config_sha256 "$expected_checksum"
        emit p0_config_status ready
        return 0
    fi
    if [[ "$current_checksum" != "$replace_current_checksum" ]]; then
        rm -f -- "$temporary"
        fail wrapper_failure "current P0 configuration checksum differs"
    fi

    for run_candidate in "$RUNS"/gtd-*; do
        [[ -d "$run_candidate" ]] || continue
        [[ ! -L "$run_candidate" && -O "$run_candidate" ]] || {
            rm -f -- "$temporary"
            fail filesystem_failure "P0 rotation encountered an unsafe run directory"
        }
        [[ -e "$run_candidate/state/p0-config-sha256" ]] || continue
        [[ -f "$run_candidate/state/p0-config-sha256" && \
           ! -L "$run_candidate/state/p0-config-sha256" && \
           -f "$run_candidate/state/phase" && \
           ! -L "$run_candidate/state/phase" ]] || {
            rm -f -- "$temporary"
            fail filesystem_failure "P0 rotation encountered unsafe run state"
        }
        run_checksum="$(<"$run_candidate/state/p0-config-sha256")"
        [[ "$run_checksum" == "$current_checksum" ]] || continue
        run_phase="$(<"$run_candidate/state/phase")"
        if [[ ! -e "$run_candidate/state/job-id" ]]; then
            case "$run_phase" in
                stage_failed|staged|submission_failed) ;;
                *)
                    rm -f -- "$temporary"
                    fail wrapper_failure \
                        "P0 configuration is referenced by an active run"
                    ;;
            esac
            continue
        fi
        [[ -f "$run_candidate/state/job-id" && \
           ! -L "$run_candidate/state/job-id" ]] || {
            rm -f -- "$temporary"
            fail filesystem_failure "P0 rotation encountered an unsafe job identity"
        }
        run_job_id="$(<"$run_candidate/state/job-id")"
        [[ "$run_job_id" =~ $INTEGER_RE ]] || {
            rm -f -- "$temporary"
            fail wrapper_failure "P0 rotation encountered an invalid job identity"
        }
        scheduler_state="$(scheduler_queue_state "$run_job_id")"
        if [[ -z "$scheduler_state" ]]; then
            sacct_line="$({
                sacct -n -P -j "$run_job_id" --format=State 2>"$DISCARD" || true
            } | awk -F'|' '$1 != "" {print $1; exit}')"
            scheduler_state="${sacct_line%% *}"
            scheduler_state="${scheduler_state%%+*}"
        fi
        case "$scheduler_state" in
            BOOT_FAIL|CANCELLED|COMPLETED|DEADLINE|FAILED|NODE_FAIL|OUT_OF_MEMORY|PREEMPTED|REVOKED|TIMEOUT) ;;
            *)
                rm -f -- "$temporary"
                fail wrapper_failure \
                    "P0 configuration is referenced by an active run"
                ;;
        esac
    done

    if [[ -e "$retired" || -L "$retired" ]]; then
        [[ -f "$retired" && ! -L "$retired" && -O "$retired" && \
           "$(sha256sum "$retired" | awk '{print $1}')" == \
             "$replace_current_checksum" ]] || {
            rm -f -- "$temporary"
            fail filesystem_failure "retired P0 configuration identity differs"
        }
    elif ! ln "$P0_CONFIG" "$retired"; then
        rm -f -- "$temporary"
        fail filesystem_failure "current P0 configuration could not be retained"
    fi
    if ! mv -f -- "$temporary" "$P0_CONFIG"; then
        rm -f -- "$temporary"
        fail filesystem_failure "P0 configuration could not be replaced atomically"
    fi
    if ! p0_config_readiness "$P0_CONFIG" || \
       [[ "$P0_CONFIG_SHA256" != "$expected_checksum" ]]; then
        fail filesystem_failure "replacement P0 configuration failed verification"
    fi
    emit operation p0-configure
    emit configured true
    emit rotated true
    emit previous_p0_config_sha256 "$replace_current_checksum"
    emit p0_config_sha256 "$expected_checksum"
    emit p0_config_status ready
}

p0_input_tree_verify() {
    [[ "$#" -eq 5 ]] || fail wrapper_failure "internal P0 tree verifier misuse"
    local tree="$1" source_id="$2" archive_sha256="$3"
    local expected_database_sha256="$4" expected_phenix_sha256="$5"
    local extra file_count directory_count header digest size relative file count
    local tree_file archive_inventory_sha256
    local -A seen=()
    [[ -d "$tree" && ! -L "$tree" && -O "$tree" ]] || \
        fail filesystem_failure "P0 input tree is unsafe"
    extra="$(find "$tree" -xdev ! -type d ! -type f -print -quit)"
    [[ -z "$extra" ]] || fail transfer_failure "P0 input tree has unsafe entries"
    file_count="$(find "$tree" -xdev -type f -print | wc -l)"
    directory_count="$(find "$tree" -xdev -type d -print | wc -l)"
    [[ "$file_count" -eq 17 && "$directory_count" -eq 3 && \
       -d "$tree/inputs" && -d "$tree/manifests" ]] || \
        fail transfer_failure "P0 input tree layout differs from the fixed layout"
    while IFS= read -r -d '' tree_file; do
        [[ "$(stat -c '%h' "$tree_file")" -eq 1 ]] || \
            fail transfer_failure "P0 input tree contains linked files"
    done < <(find "$tree" -xdev -type f -print0)
    [[ -f "$tree/_archive.tar.gz" && ! -L "$tree/_archive.tar.gz" && \
       "$(stat -c '%h' "$tree/_archive.tar.gz")" -eq 1 && \
       "$(sha256sum "$tree/_archive.tar.gz" | awk '{print $1}')" == \
         "$archive_sha256" && \
       -f "$tree/_archive.sha256" && \
       "$(<"$tree/_archive.sha256")" == "$archive_sha256" && \
       -f "$tree/_source-id" && \
       "$(<"$tree/_source-id")" == "p0i_$source_id" && \
       -f "$tree/_database-manifest.sha256" && \
       "$(<"$tree/_database-manifest.sha256")" == \
         "$expected_database_sha256" && \
       -f "$tree/_phenix-manifest.sha256" && \
       "$(<"$tree/_phenix-manifest.sha256")" == \
         "$expected_phenix_sha256" ]] || \
        fail transfer_failure "P0 input tree identity differs"
    archive_inventory_sha256="$(
        tar -xOzf "$tree/_archive.tar.gz" inventory.tsv | sha256sum | awk '{print $1}'
    )" || fail transfer_failure "P0 archive inventory cannot be read"
    [[ "$(sha256sum "$tree/inventory.tsv" | awk '{print $1}')" == \
       "$archive_inventory_sha256" ]] || \
        fail transfer_failure "P0 input inventory differs from its archived copy"
    IFS= read -r header < "$tree/inventory.tsv"
    [[ "$header" == $'sha256\tsize_bytes\tpath' ]] || \
        fail transfer_failure "P0 input inventory header is invalid"
    count=0
    while IFS=$'\t' read -r digest size relative extra; do
        [[ -n "$digest" && -n "$size" && -n "$relative" && -z "$extra" ]] || \
            fail transfer_failure "P0 input inventory row is malformed"
        [[ "$digest" =~ $CHECKSUM_RE && "$size" =~ $BYTE_COUNT_RE ]] || \
            fail transfer_failure "P0 input inventory identity is invalid"
        case "$relative" in
            bundle.json|manifests/catalogues.json|manifests/crystals.json|\
            manifests/config.yaml|inputs/proteome.faa|inputs/genome.fna|\
            inputs/annotation.gff|inputs/annotation.gbff|\
            inputs/AD4QS1P4G2_18.mtz|inputs/CD4QS2P2G1_15.mtz|\
            inputs/CD6QS2P2G1_5.mtz) ;;
            *) fail transfer_failure "P0 input inventory path is not approved" ;;
        esac
        [[ -z "${seen[$relative]+x}" ]] || \
            fail transfer_failure "P0 input inventory contains a duplicate path"
        seen[$relative]=1
        file="$tree/$relative"
        [[ -f "$file" && ! -L "$file" && "$(stat -c '%h' "$file")" -eq 1 ]] || \
            fail transfer_failure "P0 input inventory target is unsafe"
        [[ "$(file_size "$file")" == "$size" ]] || \
            fail transfer_failure "P0 input inventory size differs"
        [[ "$(sha256sum "$file" | awk '{print $1}')" == "$digest" ]] || \
            fail transfer_failure "P0 input inventory checksum differs"
        count=$((count + 1))
    done < <(tail -n +2 "$tree/inventory.tsv")
    [[ "$count" -eq 11 ]] || fail transfer_failure "P0 input inventory count differs"
    grep -Eq "^  \"source_id\": \"p0i_$source_id\",?$" \
        "$tree/bundle.json" || fail transfer_failure "P0 bundle source identity differs"
    grep -Eq \
        "^  \"database_manifest_sha256\": \"$expected_database_sha256\",?$" \
        "$tree/bundle.json" || \
        fail transfer_failure "P0 bundle database anchor differs"
    grep -Eq \
        "^  \"phenix_manifest_sha256\": \"$expected_phenix_sha256\",?$" \
        "$tree/bundle.json" || fail transfer_failure "P0 bundle Phenix anchor differs"
}

p0_inputs_stage() {
    [[ "$#" -eq 5 ]] || \
        fail wrapper_failure "p0-inputs-stage expects five fixed identity fields"
    local source_id="$1" archive_sha256="$2" archive_size="$3"
    local expected_database_sha256="$4" expected_phenix_sha256="$5"
    local site_root phenix_directory phenix_manifest="" phenix_matches=0
    local candidate actual_sha256 archive staging destination paths_candidate parent
    local p0_config_sha256 p0_paths_base64
    [[ "$source_id" =~ $CHECKSUM_RE ]] || fail wrapper_failure "invalid P0 input ID"
    [[ "$archive_sha256" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "invalid P0 input archive checksum"
    [[ "$archive_size" =~ $BYTE_COUNT_RE ]] || \
        fail wrapper_failure "invalid P0 input archive size"
    (( archive_size >= 1 && archive_size <= MAX_P0_INPUT_ARCHIVE_BYTES )) || \
        fail wrapper_failure "P0 input archive size exceeds the fixed boundary"
    [[ "$expected_database_sha256" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "invalid expected database-manifest checksum"
    [[ "$expected_phenix_sha256" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "invalid expected Phenix-manifest checksum"

    database_config_readiness runtime || \
        fail environment_failure "database configuration is not ready"
    site_root="$ROOT"
    while [[ "$DATABASE_ALLOWED_ROOT" != "$site_root" ]] && \
          ! path_within_root "$site_root" "$DATABASE_ALLOWED_ROOT"; do
        parent="$(dirname "$site_root")"
        [[ "$parent" != "$site_root" && "$parent" != / ]] || \
            fail filesystem_failure "qualified site root has no safe common ancestor"
        site_root="$parent"
    done
    [[ "$site_root" != / && -d "$site_root" && ! -L "$site_root" && \
       -O "$site_root" ]] || fail filesystem_failure "qualified site root is unsafe"
    [[ "$ROOT" == "$site_root" ]] || path_within_root "$site_root" "$ROOT" || \
        fail filesystem_failure "dispatcher root is outside the qualified site root"
    [[ "$DATABASE_ALLOWED_ROOT" == "$site_root" ]] || \
        path_within_root "$site_root" "$DATABASE_ALLOWED_ROOT" || \
        fail filesystem_failure "database authority is outside the qualified site root"
    path_within_root "$site_root" "$DATABASE_ROOT" || \
        fail environment_failure "qualified database root is outside the site root"
    path_within_root "$site_root" "$DATABASE_MANIFEST" || \
        fail environment_failure "qualified database manifest is outside the site root"
    actual_sha256="$(sha256sum "$DATABASE_MANIFEST" | awk '{print $1}')"
    [[ "$actual_sha256" == "$expected_database_sha256" ]] || \
        fail environment_failure "qualified database-manifest checksum differs"

    phenix_directory="$site_root/Softwares/manifests"
    [[ -d "$phenix_directory" && ! -L "$phenix_directory" ]] || \
        fail environment_failure "Phenix manifest directory is absent or unsafe"
    shopt -s nullglob
    for candidate in "$phenix_directory"/*; do
        [[ -f "$candidate" && ! -L "$candidate" && -O "$candidate" ]] || continue
        actual_sha256="$(sha256sum "$candidate" | awk '{print $1}')"
        if [[ "$actual_sha256" == "$expected_phenix_sha256" ]]; then
            phenix_manifest="$candidate"
            phenix_matches=$((phenix_matches + 1))
        fi
    done
    shopt -u nullglob
    [[ "$phenix_matches" -eq 1 ]] || \
        fail environment_failure "expected exactly one qualified Phenix manifest"

    mkdir -p -- "$P0_INPUTS" "$LOCKS"
    [[ -d "$P0_INPUTS" && ! -L "$P0_INPUTS" && -O "$P0_INPUTS" ]] || \
        fail filesystem_failure "fixed P0 input root is unsafe"
    chmod 0700 "$P0_INPUTS"
    archive="$P0_INPUTS/.p0i-$source_id.tar.gz.tmp.$$"
    staging="$P0_INPUTS/.staging-$source_id-$$"
    destination="$P0_INPUTS/p0i_$source_id"
    paths_candidate="$ROOT/_config/.p0-paths-$source_id.tmp.$$"
    trap 'rm -f -- "$archive" "$paths_candidate"; rm -rf -- "$staging"' EXIT

    head -c "$archive_size" > "$archive" || \
        fail transfer_failure "P0 input archive transfer failed"
    [[ "$(file_size "$archive")" == "$archive_size" ]] || \
        fail transfer_failure "P0 input archive transfer was truncated"
    actual_sha256="$(sha256sum "$archive" | awk '{print $1}')"
    [[ "$actual_sha256" == "$archive_sha256" ]] || \
        fail transfer_failure "P0 input archive checksum differs"

    exec 9>"$LOCKS/p0-inputs-stage.lock"
    flock -x 9
    if [[ -e "$destination" || -L "$destination" ]]; then
        [[ -d "$destination" && ! -L "$destination" && -O "$destination" ]] || \
            fail filesystem_failure "existing P0 input destination is unsafe"
        p0_input_tree_verify \
            "$destination" \
            "$source_id" \
            "$archive_sha256" \
            "$expected_database_sha256" \
            "$expected_phenix_sha256"
    else
        mkdir -- "$staging"
        tar --no-same-owner --no-same-permissions -xzf "$archive" -C "$staging" || \
            fail transfer_failure "P0 input archive extraction failed"
        mv -- "$archive" "$staging/_archive.tar.gz"
        printf '%s\n' "$archive_sha256" > "$staging/_archive.sha256"
        printf 'p0i_%s\n' "$source_id" > "$staging/_source-id"
        printf '%s\n' "$expected_database_sha256" \
            > "$staging/_database-manifest.sha256"
        printf '%s\n' "$expected_phenix_sha256" \
            > "$staging/_phenix-manifest.sha256"
        p0_input_tree_verify \
            "$staging" \
            "$source_id" \
            "$archive_sha256" \
            "$expected_database_sha256" \
            "$expected_phenix_sha256"
        find "$staging" -xdev -type f -exec chmod 0444 {} +
        find "$staging" -xdev -type d -exec chmod 0555 {} +
        mv -- "$staging" "$destination"
    fi

    printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n' \
        "$site_root" \
        "$destination/manifests/catalogues.json" \
        "$destination/manifests/crystals.json" \
        "$destination/manifests/config.yaml" \
        "$DATABASE_ROOT" \
        "$DATABASE_MANIFEST" \
        "$phenix_manifest" > "$paths_candidate"
    chmod 0600 "$paths_candidate"
    p0_config_readiness "$paths_candidate" || \
        fail environment_failure "staged P0 configuration candidate is not ready"
    p0_config_sha256="$(sha256sum "$paths_candidate" | awk '{print $1}')"
    p0_paths_base64="$(base64 < "$paths_candidate" | tr -d '\n')"
    rm -f -- "$archive" "$paths_candidate"
    trap - EXIT
    emit operation p0-inputs-stage
    emit p0_input_id "p0i_$source_id"
    emit archive_sha256 "$archive_sha256"
    emit archive_size_bytes "$archive_size"
    emit p0_config_sha256 "$p0_config_sha256"
    emit p0_paths_base64 "$p0_paths_base64"
    emit scientific_input_count 7
    emit regular_file_count 17
    emit status ready
}

unknown_discovery_inputs_stage() {
    [[ "$#" -eq 7 ]] || \
        fail wrapper_failure \
            "unknown-discovery-inputs-stage expects seven fixed identity fields"
    local run_id="$1" owner_id="$2" input_id="$3" archive_sha256="$4"
    local archive_size="$5" execution_identity_id="$6" review_stage_index_id="$7"
    local run profile archive staging destination actual_sha256 unsafe_member python
    local input_checksums input_checksums_temporary relative
    local input_file_count source_commit source_tree nf_helper_commit pixi_lock_sha256
    local allowed_mtz_root
    local -a p0_values=()
    validate_run_id "$run_id"
    validate_owner "$owner_id"
    [[ "$input_id" =~ ^unknowninputs_[a-f0-9]{64}$ ]] || \
        fail wrapper_failure "invalid unknown-discovery input ID"
    [[ "$archive_sha256" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "invalid unknown-discovery archive checksum"
    [[ "$archive_size" =~ $BYTE_COUNT_RE ]] || \
        fail wrapper_failure "invalid unknown-discovery archive size"
    (( archive_size >= 1 && \
       archive_size <= MAX_UNKNOWN_DISCOVERY_INPUT_ARCHIVE_BYTES )) || \
        fail wrapper_failure \
            "unknown-discovery archive exceeds the fixed size boundary"
    [[ "$execution_identity_id" =~ ^phase3exec_[a-f0-9]{64}$ ]] || \
        fail wrapper_failure "invalid Phase III execution identity"
    [[ "$review_stage_index_id" =~ ^unknownreviewstages_[a-f0-9]{64}$ ]] || \
        fail wrapper_failure "invalid crystallographic review-stage identity"
    require_owned_run "$run_id" "$owner_id"
    run="$(run_directory "$run_id")"
    profile="$(<"$run/state/profile")"
    [[ "$profile" == unknown-discovery && \
       "$(<"$run/state/phase")" == staged ]] || \
        fail wrapper_failure \
            "unknown-discovery inputs require their exact staged run"
    destination="$run/artifacts/unknown-discovery/inputs"
    [[ ! -e "$destination" && ! -L "$destination" ]] || \
        fail wrapper_failure "unknown-discovery inputs are already attached"
    mkdir -p -- "$run/artifacts/unknown-discovery"
    archive="$run/execution/.unknown-discovery-inputs.tar.tmp.$$"
    staging="$run/execution/.unknown-discovery-inputs.tmp.$$"
    trap 'rm -f -- "${archive:-}"; rm -rf -- "${staging:-}"' EXIT
    head -c "$archive_size" > "$archive" || \
        fail transfer_failure "unknown-discovery input transfer failed"
    [[ "$(file_size "$archive")" == "$archive_size" ]] || \
        fail transfer_failure "unknown-discovery input transfer was truncated"
    actual_sha256="$(sha256sum "$archive" | awk '{print $1}')"
    [[ "$actual_sha256" == "$archive_sha256" ]] || \
        fail transfer_failure "unknown-discovery archive checksum differs"
    if ! tar -tf "$archive" > \
        "$run/logs/unknown-discovery-input-members.log" 2>&1; then
        fail transfer_failure "unknown-discovery archive cannot be listed"
    fi
    if awk 'BEGIN {bad=0} /^\// || /(^|\/)\.\.($|\/)/ {bad=1} END {exit bad ? 0 : 1}' \
        "$run/logs/unknown-discovery-input-members.log"; then
        fail wrapper_failure "unknown-discovery archive contains an unsafe path"
    fi
    mkdir -- "$staging"
    if ! tar --no-same-owner --no-same-permissions -xf "$archive" -C "$staging" \
        >"$run/logs/unknown-discovery-input-extract.log" 2>&1; then
        fail transfer_failure "unknown-discovery archive extraction failed"
    fi
    unsafe_member="$(find "$staging" -xdev \
        \( -type l -o \( ! -type f ! -type d \) \) -print -quit)"
    [[ -z "$unsafe_member" ]] || \
        fail wrapper_failure "unknown-discovery input tree has an unsafe member"
    python="$run/source/.pixi/envs/hpc/bin/python"
    [[ -x "$python" ]] || \
        fail environment_failure "locked unknown-discovery Python is unavailable"
    p0_config_readiness || \
        fail environment_failure "unknown-discovery P0 authority is unavailable"
    mapfile -t p0_values < "$P0_CONFIG"
    [[ "${#p0_values[@]}" -eq 7 ]] || \
        fail environment_failure "unknown-discovery P0 authority is malformed"
    allowed_mtz_root="${p0_values[0]}"
    source_commit="$(<"$run/state/commit")"
    source_tree="$(git -C "$run/source" rev-parse 'HEAD^{tree}')"
    nf_helper_commit="$(git -C "$run/source" submodule status -- \
        external/nf-helper | awk '{sha=$1; sub(/^[-+U]/,"",sha); print sha}')"
    pixi_lock_sha256="$(sha256sum "$run/source/pixi.lock" | awk '{print $1}')"
    [[ "$source_commit" =~ $COMMIT_RE && "$source_tree" =~ $COMMIT_RE && \
       "$nf_helper_commit" =~ $COMMIT_RE && \
       "$pixi_lock_sha256" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "unknown-discovery staged source identity is invalid"
    if ! PYTHONPATH="$run/source/src" \
        "$python" -m genome_to_diffraction.hpc.unknown_inputs \
        --input-root "$staging" \
        --expected-input-id "$input_id" \
        --expected-execution-identity-id "$execution_identity_id" \
        --expected-review-stage-index-id "$review_stage_index_id" \
        --expected-source-commit "$source_commit" \
        --expected-source-tree "$source_tree" \
        --expected-nf-helper-commit "$nf_helper_commit" \
        --expected-pixi-lock-sha256 "$pixi_lock_sha256" \
        --allowed-mtz-root "$allowed_mtz_root" \
        >"$run/logs/unknown-discovery-input-validation.log" 2>&1; then
        fail wrapper_failure "unknown-discovery input validation failed"
    fi
    mv -- "$staging" "$destination"
    input_checksums="$run/state/unknown-discovery-input-checksums.sha256"
    input_checksums_temporary="${input_checksums}.tmp.$$"
    (
        cd "$destination"
        while IFS= read -r relative; do
            relative="${relative#./}"
            sha256sum "$relative"
        done < <(find . -xdev -type f -print | LC_ALL=C sort)
    ) > "$input_checksums_temporary"
    [[ -s "$input_checksums_temporary" ]] || \
        fail filesystem_failure "unknown-discovery input checksum inventory is empty"
    input_file_count="$(wc -l < "$input_checksums_temporary")"
    [[ "$input_file_count" =~ $INTEGER_RE && \
       "$input_file_count" -ge 1 && "$input_file_count" -le 256 ]] || \
        fail filesystem_failure "unknown-discovery input file count is invalid"
    mv -f -- "$input_checksums_temporary" "$input_checksums"
    find "$destination" -xdev -type f -exec chmod 0444 {} +
    find "$destination" -xdev -type d -exec chmod 0555 {} +
    rm -f -- "$archive"
    atomic_text "$run/state/unknown-discovery-input-id" "$input_id"
    atomic_text "$run/state/unknown-discovery-input-archive-sha256" \
        "$archive_sha256"
    atomic_text "$run/state/unknown-discovery-input-file-count" \
        "$input_file_count"
    atomic_text "$run/state/phase3-execution-identity-id" \
        "$execution_identity_id"
    atomic_text "$run/state/unknown-review-stage-index-id" \
        "$review_stage_index_id"
    append_event "$run" "stage_unknown_discovery_inputs_bound"
    trap - EXIT
    emit operation unknown-discovery-inputs-stage
    emit run_id "$run_id"
    emit input_id "$input_id"
    emit archive_sha256 "$archive_sha256"
    emit archive_size_bytes "$archive_size"
    emit execution_identity_id "$execution_identity_id"
    emit review_stage_index_id "$review_stage_index_id"
    emit status ready
}

database_config_readiness() {
    local manifest_mode="${1:-output}"
    local config_path="${2:-$DATABASE_CONFIG}"
    local allowed allowed_configured candidate resolved manifest_parent
    local -a values=()
    DATABASE_CONFIG_STATUS=unknown
    DATABASE_CONFIG_SHA256=""
    DATABASE_ALLOWED_ROOT=""
    DATABASE_ROOT=""
    DATABASE_MANIFEST=""
    STORAGE_LIMIT_BYTES=""
    MINIMUM_FREE_BYTES=""
    REQUIRED_DATABASE_CAPACITY_BYTES=""
    MINIMUM_SCRATCH_FREE_BYTES=""
    if [[ ! -f "$config_path" || -L "$config_path" || ! -O "$config_path" ]]; then
        DATABASE_CONFIG_STATUS=absent_or_unsafe
        return 1
    fi
    if [[ "$(stat -c '%a' "$config_path")" != 600 ]]; then
        DATABASE_CONFIG_STATUS=mode_mismatch
        return 1
    fi
    DATABASE_CONFIG_SHA256="$(sha256sum "$config_path" | awk '{print $1}')"
    if [[ ! "$DATABASE_CONFIG_SHA256" =~ $CHECKSUM_RE ]]; then
        DATABASE_CONFIG_STATUS=checksum_failure
        return 1
    fi
    mapfile -t values < "$config_path"
    if [[ "${#values[@]}" -ne 7 ]]; then
        DATABASE_CONFIG_STATUS=line_count_mismatch
        return 1
    fi
    for candidate in "${values[0]}" "${values[1]}" "${values[2]}"; do
        if [[ ! "$candidate" =~ $SAFE_PATH_RE ]]; then
            DATABASE_CONFIG_STATUS=unsafe_path
            return 1
        fi
    done
    for candidate in "${values[3]}" "${values[4]}" "${values[5]}" "${values[6]}"; do
        if [[ ! "$candidate" =~ $BYTE_COUNT_RE || "${#candidate}" -gt 13 ]]; then
            DATABASE_CONFIG_STATUS=invalid_capacity
            return 1
        fi
    done
    allowed_configured="${values[0]}"
    if ! allowed="$(realpath -e "$allowed_configured" 2>"$DISCARD")" || \
        [[ ! -d "$allowed" || -L "$allowed_configured" || \
           "$allowed" == / || "$allowed" == "${HOME:-}" ]]; then
        DATABASE_CONFIG_STATUS=allowed_root_invalid
        return 1
    fi
    if ! resolved="$(realpath -e "${values[1]}" 2>"$DISCARD")" || \
        [[ ! -d "$resolved" || -L "${values[1]}" || \
           ! -O "${values[1]}" ]] || \
        ! path_within_root "$allowed_configured" "${values[1]}" || \
        ! path_within_root "$allowed" "$resolved"; then
        DATABASE_CONFIG_STATUS=database_root_invalid
        return 1
    fi
    if [[ "$manifest_mode" == output ]]; then
        if [[ -e "${values[2]}" || -L "${values[2]}" ]] || \
            ! path_within_root "$allowed_configured" "${values[2]}"; then
            DATABASE_CONFIG_STATUS=manifest_output_invalid
            return 1
        fi
    elif [[ "$manifest_mode" == runtime ]]; then
        if ! resolved="$(realpath -e "${values[2]}" 2>"$DISCARD")" || \
            [[ ! -f "$resolved" || \
               -L "${values[2]}" || ! -O "${values[2]}" ]] || \
            ! path_within_root "$allowed_configured" "${values[2]}" || \
            ! path_within_root "$allowed" "$resolved"; then
            DATABASE_CONFIG_STATUS=manifest_input_invalid
            return 1
        fi
    else
        DATABASE_CONFIG_STATUS=manifest_mode_invalid
        return 1
    fi
    manifest_parent="$(dirname "${values[2]}")"
    if ! resolved="$(realpath -e "$manifest_parent" 2>"$DISCARD")" || \
        [[ ! -d "$resolved" || \
           -L "$manifest_parent" || ! -O "$manifest_parent" ]]; then
        DATABASE_CONFIG_STATUS=manifest_parent_invalid
        return 1
    fi
    if (( values[3] <= 0 || values[3] > 2000000000000 || \
          values[4] < 0 || values[4] >= values[3] || \
          values[5] <= 0 || values[5] > values[3] || values[6] <= 0 )); then
        DATABASE_CONFIG_STATUS=capacity_out_of_bounds
        return 1
    fi
    DATABASE_ALLOWED_ROOT="$allowed_configured"
    DATABASE_ROOT="${values[1]}"
    DATABASE_MANIFEST="${values[2]}"
    STORAGE_LIMIT_BYTES="${values[3]}"
    MINIMUM_FREE_BYTES="${values[4]}"
    REQUIRED_DATABASE_CAPACITY_BYTES="${values[5]}"
    MINIMUM_SCRATCH_FREE_BYTES="${values[6]}"
    DATABASE_CONFIG_STATUS=ready
    return 0
}

database_readiness() {
    [[ "$#" -eq 0 ]] || fail wrapper_failure "database-readiness accepts no arguments"
    local pixi_bin="" pixi_version="" pixi_status=unavailable ready=false
    if [[ -f "$PIXI_PATH_FILE" ]]; then
        IFS= read -r pixi_bin < "$PIXI_PATH_FILE"
    else
        pixi_bin="$(command -v pixi || true)"
    fi
    if [[ "$pixi_bin" =~ $SAFE_PATH_RE && -x "$pixi_bin" ]]; then
        if pixi_version="$("$pixi_bin" --version 2>&1)"; then
            if [[ "$pixi_version" =~ ^pixi[[:space:]]+0\.76\.2$ ]]; then
                pixi_status=ready
            else
                pixi_status=version_mismatch
            fi
        else
            pixi_status=version_check_failed
        fi
    fi
    database_config_readiness || true
    if [[ "$pixi_status" == ready && "$DATABASE_CONFIG_STATUS" == ready ]]; then
        ready=true
    fi
    emit operation database-readiness
    emit profile database
    emit ready "$ready"
    emit pixi_status "$pixi_status"
    emit pixi_version "$pixi_version"
    emit database_config_status "$DATABASE_CONFIG_STATUS"
    emit database_config_sha256 "$DATABASE_CONFIG_SHA256"
    emit scope login_prerequisites_only
}

database_runtime_configure() {
    [[ "$#" -eq 2 ]] || \
        fail wrapper_failure \
            "database-runtime-configure expects a checksum and encoded paths"
    local expected_checksum="$1"
    local encoded="$2"
    local config_directory resolved temporary actual_checksum status size
    [[ "$expected_checksum" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "database runtime configuration checksum is invalid"
    [[ -n "$encoded" && "${#encoded}" -le 5464 && \
        "$encoded" =~ ^[A-Za-z0-9+/=]+$ ]] || \
        fail wrapper_failure "encoded database runtime configuration is invalid"
    [[ ! -e "$DATABASE_CONFIG" && ! -L "$DATABASE_CONFIG" ]] || \
        fail wrapper_failure "database configuration already exists"
    config_directory="$(dirname "$DATABASE_CONFIG")"
    if [[ ! -e "$config_directory" && ! -L "$config_directory" ]]; then
        mkdir -p "$config_directory" || \
            fail filesystem_failure \
                "database configuration directory cannot be created"
        chmod 0700 "$config_directory"
    fi
    resolved="$(realpath -e "$config_directory" 2>"$DISCARD")" || \
        fail filesystem_failure "database configuration directory cannot be resolved"
    [[ "$resolved" == "$config_directory" && -d "$config_directory" && \
        ! -L "$config_directory" && -O "$config_directory" ]] || \
        fail filesystem_failure "database configuration directory is unsafe"
    temporary="${DATABASE_CONFIG}.tmp.$$"
    if ! printf '%s' "$encoded" | base64 -d > "$temporary"; then
        rm -f -- "$temporary"
        fail transfer_failure "database runtime configuration cannot be decoded"
    fi
    chmod 0600 "$temporary"
    size="$(file_size "$temporary")"
    if [[ ! "$size" =~ $BYTE_COUNT_RE ]] || (( size < 1 || size > 4096 )); then
        rm -f -- "$temporary"
        fail wrapper_failure "database runtime configuration size is invalid"
    fi
    actual_checksum="$(sha256sum "$temporary" | awk '{print $1}')"
    if [[ "$actual_checksum" != "$expected_checksum" ]]; then
        rm -f -- "$temporary"
        fail transfer_failure "database runtime configuration checksum does not match"
    fi
    if ! database_config_readiness runtime "$temporary"; then
        status="$DATABASE_CONFIG_STATUS"
        rm -f -- "$temporary"
        fail environment_failure \
            "database runtime configuration is not ready: $status"
    fi
    if ! ln "$temporary" "$DATABASE_CONFIG"; then
        rm -f -- "$temporary"
        fail filesystem_failure \
            "database runtime configuration could not be created atomically"
    fi
    rm -f -- "$temporary"
    emit operation database-runtime-configure
    emit configured true
    emit database_config_sha256 "$expected_checksum"
    emit database_config_status ready
    emit manifest_mode runtime
}

cleanup_deploy_staging() {
    local staging="$1"
    [[ "$staging" == "$TOOL_DIR"/.deploy-tools.* ]] || return 1
    chmod -R u+w "$staging" 2>"$DISCARD" || true
    rm -rf -- "$staging"
}

deploy_failure() {
    local staging="$1"
    local failure_class="$2"
    local message="$3"
    cleanup_deploy_staging "$staging" || true
    fail "$failure_class" "$message"
}

deploy_tools() {
    [[ "$#" -eq 3 ]] || fail wrapper_failure "deploy-tools expects commit and two checksums"
    local commit="$1"
    local expected_dispatcher="$2"
    local expected_smoke_job="$3"
    local staging new_dispatcher new_smoke_job actual_dispatcher actual_smoke_job
    local previous_dispatcher previous_smoke_job record

    [[ "$commit" =~ $COMMIT_RE ]] || fail wrapper_failure "invalid deployment commit SHA"
    [[ "$expected_dispatcher" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "invalid dispatcher checksum"
    [[ "$expected_smoke_job" =~ $CHECKSUM_RE ]] || \
        fail wrapper_failure "invalid smoke-job checksum"
    [[ -d "$MIRROR" ]] || fail filesystem_failure "bare Git mirror is absent"
    [[ "$(git --git-dir="$MIRROR" rev-parse --is-bare-repository \
        <"$DISCARD" 2>"$DISCARD")" == true ]] || \
        fail filesystem_failure "configured Git mirror is not bare"
    [[ -f "$DISPATCHER" && ! -L "$DISPATCHER" ]] || \
        fail filesystem_failure "installed dispatcher is not a regular file"
    [[ -f "$SMOKE_JOB" && ! -L "$SMOKE_JOB" ]] || \
        fail filesystem_failure "installed smoke job is not a regular file"

    mkdir -p "$LOCKS"
    exec 9>"$LOCKS/deploy-tools.lock"
    flock -x 9
    staging="$(mktemp -d "$TOOL_DIR/.deploy-tools.XXXXXXXX")" || \
        fail filesystem_failure "cannot create tool deployment staging directory"
    new_dispatcher="$staging/nf-gtd-hpc-remote"
    new_smoke_job="$staging/nf-gtd-hpc-smoke-job"
    previous_dispatcher="$staging/previous-nf-gtd-hpc-remote"
    previous_smoke_job="$staging/previous-nf-gtd-hpc-smoke-job"
    record="$staging/deployed-tools.json"

    if ! git --git-dir="$MIRROR" fetch --prune origin <"$DISCARD" \
        >"$staging/git-fetch.log" 2>&1; then
        deploy_failure "$staging" transfer_failure "Git mirror fetch failed during tool deployment"
    fi
    if ! git --git-dir="$MIRROR" cat-file -e "${commit}^{commit}" \
        <"$DISCARD" 2>"$DISCARD"; then
        deploy_failure "$staging" transfer_failure "deployment commit is unavailable from the private mirror"
    fi
    if ! git --git-dir="$MIRROR" rev-parse --verify refs/heads/main \
        <"$DISCARD" >"$DISCARD" 2>&1 || \
        ! git --git-dir="$MIRROR" merge-base --is-ancestor "$commit" \
        refs/heads/main <"$DISCARD"; then
        deploy_failure "$staging" transfer_failure "deployment commit is not reachable from origin main"
    fi
    if ! git --git-dir="$MIRROR" show \
        "${commit}:bootstrap/nf-gtd-hpc-remote" <"$DISCARD" > "$new_dispatcher"; then
        deploy_failure "$staging" transfer_failure "fixed dispatcher file is absent from deployment commit"
    fi
    if ! git --git-dir="$MIRROR" show \
        "${commit}:bootstrap/nf-gtd-hpc-smoke-job" <"$DISCARD" > "$new_smoke_job"; then
        deploy_failure "$staging" transfer_failure "fixed smoke-job file is absent from deployment commit"
    fi
    actual_dispatcher="$(sha256sum "$new_dispatcher" | awk '{print $1}')"
    actual_smoke_job="$(sha256sum "$new_smoke_job" | awk '{print $1}')"
    [[ "$actual_dispatcher" == "$expected_dispatcher" ]] || \
        deploy_failure "$staging" transfer_failure "dispatcher SHA-256 differs from the local review"
    [[ "$actual_smoke_job" == "$expected_smoke_job" ]] || \
        deploy_failure "$staging" transfer_failure "smoke-job SHA-256 differs from the local review"
    bash -n "$new_dispatcher" "$new_smoke_job" || \
        deploy_failure "$staging" wrapper_failure "deployed tool failed Bash syntax validation"
    grep -Fq 'deploy-tools) deploy_tools "$@" ;;' "$new_dispatcher" || \
        deploy_failure "$staging" wrapper_failure "deployed dispatcher would remove the safe upgrade operation"

    cp -p -- "$DISPATCHER" "$previous_dispatcher" || \
        deploy_failure "$staging" filesystem_failure "cannot preserve previous dispatcher"
    cp -p -- "$SMOKE_JOB" "$previous_smoke_job" || \
        deploy_failure "$staging" filesystem_failure "cannot preserve previous smoke job"
    chmod 0555 "$new_dispatcher" "$new_smoke_job"
    cat > "$record" <<EOF
{
  "schema_version": "1.0",
  "commit": "$commit",
  "dispatcher_sha256": "$actual_dispatcher",
  "smoke_job_sha256": "$actual_smoke_job",
  "deployed_at": "$(now_utc)"
}
EOF

    if ! mv -f -- "$new_smoke_job" "$SMOKE_JOB" || \
        ! mv -f -- "$new_dispatcher" "$DISPATCHER"; then
        mv -f -- "$previous_smoke_job" "$SMOKE_JOB" 2>"$DISCARD" || true
        mv -f -- "$previous_dispatcher" "$DISPATCHER" 2>"$DISCARD" || true
        deploy_failure "$staging" filesystem_failure "atomic remote-tool replacement failed"
    fi
    if [[ "$(sha256sum "$DISPATCHER" | awk '{print $1}')" != "$actual_dispatcher" ]] || \
        [[ "$(sha256sum "$SMOKE_JOB" | awk '{print $1}')" != "$actual_smoke_job" ]] || \
        ! mv -f -- "$record" "$TOOL_DIR/deployed-tools.json"; then
        mv -f -- "$previous_smoke_job" "$SMOKE_JOB" 2>"$DISCARD" || true
        mv -f -- "$previous_dispatcher" "$DISPATCHER" 2>"$DISCARD" || true
        deploy_failure "$staging" filesystem_failure "installed remote-tool verification failed"
    fi
    cleanup_deploy_staging "$staging" || \
        fail filesystem_failure "cannot remove deployment staging directory"

    emit operation deploy-tools
    emit commit "$commit"
    emit dispatcher_sha256 "$actual_dispatcher"
    emit smoke_job_sha256 "$actual_smoke_job"
    emit deployment_record "$TOOL_DIR/deployed-tools.json"
    emit deployed true
}

stage_run_common() {
    [[ "$#" -eq 6 || "$#" -eq 8 || "$#" -eq 9 || "$#" -eq 11 ]] || \
        fail wrapper_failure "stage argument count is outside fixed profiles"
    local run_id="$1"
    local commit="$2"
    local expected_lock="$3"
    local owner_id="$4"
    local iteration="$5"
    local profile="$6"
    local run pixi_bin pixi_version actual_lock submodule_commit manifest_tmp
    local phenix_manifest
    local gtd nextflow java mmseqs foldseek hpc_path
    local p0_config_sha256="" p0_config_json="null"
    local database_manifest_sha256="" database_manifest_json="null"
    local database_config_sha256="" database_config_json="null"
    local database_source_bundle_sha256="" database_source_bundle_json="null"
    local p1_prefetch_sha256="" p1_prefetch_json="null"
    local p1_catalogue p1_provider_plan p1_prefetch p1_prefetch_checksums
    local p1_prefetch_tmp
    local p2_diverse_sha256="" p2_diverse_json="null"
    local p2_diverse_search p2_diverse_registration p2_diverse_checksums
    local p2_diverse_tmp mapping_count source_count
    local p2_control_sha256="" p2_control_json="null"
    local p2_control_root p2_control_catalogue p2_control_checksums p2_control_tmp
    local heteromer_sha256="" heteromer_json="null"
    local heteromer_root heteromer_multicopy_root heteromer_catalogue_root
    local heteromer_p6_root heteromer_p6_missing_model_relative
    local heteromer_p6_scope_relative
    local heteromer_checksums heteromer_tmp
    local heteromer_phenix_manifest="" heteromer_phenix_sha256=""
    local heteromer_phenix_json="null"
    local phase3_probe_phenix_json="null"
    local candidate coordinate_count hit_count
    local source_archive=false source_archive_sha256="" source_archive_size=""
    local expected_submodule_commit="" source_archive_json="null"
    local m6_site_contract_json="null"
    local phase3_network_site_contract_json="null"
    local -a p0_values=() heteromer_p6_values=()

    if [[ "$profile" == heteromer-smoke || \
          "$profile" == phase3-phenix-probe || \
          "$profile" == unknown-discovery || \
          "$profile" == unknown-screen || \
          "$profile" == unknown-single-component || \
          "$profile" == unknown-pass2 || \
          ( "$SITE_ID" == marmic && \
            ( "$profile" == m6-operational || "$profile" == m6-leakage ) ) ]]; then
        [[ "$#" -eq 8 || "$#" -eq 11 ]] || \
            fail wrapper_failure "Phenix-bound stage expects its fixed manifest"
        heteromer_phenix_manifest="$7"
        heteromer_phenix_sha256="$8"
        [[ "$heteromer_phenix_manifest" =~ $SAFE_PATH_RE && \
           "$heteromer_phenix_sha256" =~ $CHECKSUM_RE ]] || \
            fail wrapper_failure "invalid fixed Phenix binding"
    else
        [[ "$#" -eq 6 || "$#" -eq 9 ]] || \
            fail wrapper_failure "non-heteromer stage received extra arguments"
    fi

    if [[ "$#" -eq 9 || "$#" -eq 11 ]]; then
        source_archive=true
        if [[ "$profile" == heteromer-smoke || \
              "$profile" == phase3-phenix-probe || \
              "$profile" == unknown-discovery || \
              "$profile" == unknown-screen || \
              "$profile" == unknown-single-component || \
              "$profile" == unknown-pass2 || \
              ( "$SITE_ID" == marmic && \
                ( "$profile" == m6-operational || "$profile" == m6-leakage ) ) ]]; then
            source_archive_sha256="$9"
            source_archive_size="${10}"
            expected_submodule_commit="${11}"
        else
            source_archive_sha256="$7"
            source_archive_size="$8"
            expected_submodule_commit="$9"
        fi
        [[ "$source_archive_sha256" =~ $CHECKSUM_RE ]] || \
            fail wrapper_failure "invalid source archive checksum"
        [[ "$source_archive_size" =~ $BYTE_COUNT_RE ]] || \
            fail wrapper_failure "invalid source archive size"
        (( source_archive_size >= 1 && \
           source_archive_size <= MAX_SOURCE_ARCHIVE_BYTES )) || \
            fail wrapper_failure "source archive size is outside the fixed limit"
        [[ "$expected_submodule_commit" =~ $COMMIT_RE ]] || \
            fail wrapper_failure "invalid source archive nf-helper commit"
    fi

    validate_run_id "$run_id"
    [[ "$commit" =~ $COMMIT_RE ]] || fail wrapper_failure "invalid commit SHA"
    [[ "$expected_lock" =~ $CHECKSUM_RE ]] || fail wrapper_failure "invalid lock checksum"
    validate_owner "$owner_id"
    validate_profile "$profile"
    [[ "$SITE_ID" == marmic || "$SITE_ID" == viper-cpu ]] || \
        fail environment_failure "unsupported fixed HPC site"
    [[ "$run_id" == "gtd-${profile}-"* ]] || \
        fail wrapper_failure "run ID profile does not match the requested profile"
    [[ "$iteration" =~ $INTEGER_RE ]] || fail wrapper_failure "invalid iteration"
    (( iteration >= 1 && iteration <= 6 )) || fail wrapper_failure "iteration is outside 1..6"

    mkdir -p "$RUNS" "$LOCKS" "$ROOT/_cache/pixi"
    if [[ "$source_archive" == false ]]; then
        [[ -d "$MIRROR" ]] || fail filesystem_failure "bare Git mirror is absent"
        [[ "$(git --git-dir="$MIRROR" rev-parse --is-bare-repository \
            <"$DISCARD" 2>"$DISCARD")" == true ]] || \
            fail filesystem_failure "configured Git mirror is not bare"
    fi

    RESOLVED_PIXI=""
    resolve_pixi
    pixi_bin="$RESOLVED_PIXI"
    pixi_version="$("$pixi_bin" --version 2>&1)" || \
        fail environment_failure "Pixi version check failed"
    [[ "$pixi_version" =~ ^pixi[[:space:]]+0\.76\.2$ ]] || \
        fail environment_failure "Pixi 0.76.2 is required"

    exec 9>"$LOCKS/stage.lock"
    flock -x 9
    run="$(run_directory "$run_id")"
    [[ ! -e "$run" ]] || fail wrapper_failure "run ID already exists"
    mkdir -p \
        "$run/source" \
        "$run/state" \
        "$run/logs" \
        "$run/artifacts" \
        "$run/cache" \
        "$run/environment/.pixi" \
        "$run/execution"
    atomic_text "$run/state/owner-id" "$owner_id"
    atomic_text "$run/state/phase" "staging"
    atomic_text "$run/state/commit" "$commit"
    atomic_text "$run/state/pixi-bin" "$pixi_bin"
    atomic_text "$run/state/profile" "$profile"
    atomic_text "$run/state/site-id" "$SITE_ID"
    append_event "$run" "stage_started"

    if [[ "$source_archive" == true ]]; then
        local source_tar="$run/source.tar"
        head -c "$source_archive_size" >"$source_tar" || \
            fail transfer_failure "source archive stream failed"
        [[ "$(wc -c <"$source_tar")" -eq "$source_archive_size" ]] || \
            fail transfer_failure "source archive is truncated"
        [[ "$(sha256sum "$source_tar" | awk '{print $1}')" == \
            "$source_archive_sha256" ]] || \
            fail transfer_failure "source archive checksum differs from local commit"
        if ! tar -tf "$source_tar" >"$run/logs/source-archive-members.log" 2>&1; then
            fail transfer_failure "source archive cannot be listed"
        fi
        if awk 'BEGIN {bad=0} /^\// || /(^|\/)\.\.($|\/)/ {bad=1} END {exit bad ? 0 : 1}' \
            "$run/logs/source-archive-members.log"; then
            fail wrapper_failure "source archive contains an unsafe member path"
        fi
        if ! tar -xf "$source_tar" --no-same-owner --no-same-permissions \
            -C "$run/source" >"$run/logs/source-archive-extract.log" 2>&1; then
            fail filesystem_failure "source archive extraction failed"
        fi
        rm -f -- "$source_tar"
        [[ -d "$run/source/.git" && \
           -f "$run/source/external/nf-helper/.git" ]] || \
            fail wrapper_failure "source archive omits detached Git provenance"
        submodule_commit="$expected_submodule_commit"
        source_archive_json="\"$source_archive_sha256\""
        atomic_text "$run/state/source-archive-sha256" "$source_archive_sha256"
        append_event "$run" "stage_source_archive_verified"
    else
        if ! git --git-dir="$MIRROR" fetch --prune origin <"$DISCARD" \
            >"$run/logs/git-fetch.log" 2>&1; then
            atomic_text "$run/state/phase" "stage_failed"
            atomic_text "$run/state/failure-class" "transfer_failure"
            append_event "$run" "stage_fetch_failed"
            fail transfer_failure "Git mirror fetch failed"
        fi
        git --git-dir="$MIRROR" cat-file -e "${commit}^{commit}" \
            <"$DISCARD" 2>"$DISCARD" || {
            atomic_text "$run/state/phase" "stage_failed"
            atomic_text "$run/state/failure-class" "transfer_failure"
            append_event "$run" "stage_commit_unavailable"
            fail transfer_failure "commit is not available from the private Git mirror"
        }
        rmdir "$run/source"
        if ! git clone --no-hardlinks --no-checkout "$MIRROR" "$run/source" \
            <"$DISCARD" >"$run/logs/git-clone.log" 2>&1; then
            atomic_text "$run/state/phase" "stage_failed"
            atomic_text "$run/state/failure-class" "filesystem_failure"
            append_event "$run" "stage_clone_failed"
            fail filesystem_failure "isolated Git clone failed"
        fi
        if ! git -C "$run/source" checkout --detach "$commit" <"$DISCARD" \
            >>"$run/logs/git-clone.log" 2>&1; then
            atomic_text "$run/state/phase" "stage_failed"
            atomic_text "$run/state/failure-class" "transfer_failure"
            append_event "$run" "stage_checkout_failed"
            fail transfer_failure "exact commit checkout failed"
        fi
        if ! git -C "$run/source" submodule update --init --recursive <"$DISCARD" \
            >>"$run/logs/git-clone.log" 2>&1; then
            atomic_text "$run/state/phase" "stage_failed"
            atomic_text "$run/state/failure-class" "transfer_failure"
            append_event "$run" "stage_submodule_failed"
            fail transfer_failure "submodule checkout failed"
        fi
        [[ "$(git -C "$run/source" rev-parse HEAD <"$DISCARD")" == "$commit" ]] || \
            fail wrapper_failure "staged commit does not match the request"
        submodule_commit="$(git -C "$run/source" submodule status -- external/nf-helper \
            <"$DISCARD" | \
            awk '{sha=$1; sub(/^[-+U]/,"",sha); print sha}')"
    fi
    actual_lock="$(sha256sum "$run/source/pixi.lock" | awk '{print $1}')"
    [[ "$actual_lock" == "$expected_lock" ]] || {
        atomic_text "$run/state/phase" "stage_failed"
        atomic_text "$run/state/failure-class" "transfer_failure"
        append_event "$run" "stage_lock_mismatch"
        fail transfer_failure "Pixi lock checksum differs from the local commit"
    }
    atomic_text "$run/state/pixi-lock-sha256" "$actual_lock"
    [[ "$submodule_commit" =~ $COMMIT_RE ]] || \
        fail transfer_failure "nf-helper submodule commit could not be recorded"
    ln -s "$run/environment/.pixi" "$run/source/.pixi" || \
        fail filesystem_failure "cannot attach the per-run Pixi environment"

    if [[ "$profile" == m6-nextflow-smoke || \
          "$profile" == m6-operational || "$profile" == m6-leakage ]]; then
        local nextflow_profile execution_policy_relative execution_policy
        local execution_policy_sha256 execution_policy_id apptainer_cache
        if [[ "$SITE_ID" == viper-cpu ]]; then
            nextflow_profile=viper-cpu
            execution_policy_relative=benchmarks/m6/execution-nextflow-v1.yaml
            execution_policy_id=m6_nextflow_slurm_v1
        else
            nextflow_profile=marmic
            execution_policy_relative=benchmarks/m6/execution-nextflow-marmic-v1.yaml
            execution_policy_id=m6_nextflow_slurm_marmic_v1
        fi
        execution_policy="$run/source/$execution_policy_relative"
        [[ -f "$execution_policy" && ! -L "$execution_policy" && \
           -O "$execution_policy" ]] || \
            fail filesystem_failure "fixed M6 execution policy is absent or unsafe"
        git -C "$run/source" ls-files --error-unmatch "$execution_policy_relative" \
            <"$DISCARD" >"$DISCARD" 2>&1 || \
            fail wrapper_failure "fixed M6 execution policy is not tracked"
        execution_policy_sha256="$(sha256sum "$execution_policy" | awk '{print $1}')"
        [[ "$execution_policy_sha256" =~ $CHECKSUM_RE ]] || \
            fail filesystem_failure "fixed M6 execution policy checksum failed"
        apptainer_cache="$run/cache/apptainer"
        mkdir -p "$apptainer_cache"
        chmod 700 "$apptainer_cache"
        [[ -d "$apptainer_cache" && ! -L "$apptainer_cache" && \
           -O "$apptainer_cache" ]] || \
            fail filesystem_failure "run-owned Apptainer cache is unsafe"
        atomic_text "$run/state/nextflow-profile" "$nextflow_profile"
        atomic_text "$run/state/execution-policy-relative" \
            "$execution_policy_relative"
        atomic_text "$run/state/execution-policy-id" "$execution_policy_id"
        atomic_text "$run/state/execution-policy-sha256" \
            "$execution_policy_sha256"
        atomic_text "$run/state/apptainer-cache-dir" "$apptainer_cache"
        m6_site_contract_json="{\"nextflow_profile\":\"$nextflow_profile\",\"execution_policy\":\"$execution_policy_relative\",\"execution_policy_id\":\"$execution_policy_id\",\"execution_policy_sha256\":\"$execution_policy_sha256\",\"apptainer_cache_scope\":\"run_owned\"}"
        append_event "$run" "stage_m6_site_policy_bound"
    fi

    if [[ "$profile" == phase3-network-probe ]]; then
        local network_nextflow_profile network_site_config_relative
        local network_site_config network_site_config_sha256
        local network_shell_relative network_shell network_shell_sha256
        [[ "$SITE_ID" == marmic ]] || \
            fail environment_failure \
                "fixed Phase III network probe is currently qualified only on Marmic"
        network_nextflow_profile=marmic
        network_site_config_relative=conf/marmic.config
        network_shell_relative=bootstrap/nf-gtd-worker-offline-shell
        network_site_config="$run/source/$network_site_config_relative"
        network_shell="$run/source/$network_shell_relative"
        for candidate in "$network_site_config" "$network_shell"; do
            [[ -f "$candidate" && ! -L "$candidate" && -O "$candidate" ]] || \
                fail filesystem_failure \
                    "fixed Phase III network policy is absent or unsafe"
        done
        git -C "$run/source" ls-files --error-unmatch \
            "$network_site_config_relative" "$network_shell_relative" \
            <"$DISCARD" >"$DISCARD" 2>&1 || \
            fail wrapper_failure "fixed Phase III network policy is not tracked"
        network_site_config_sha256="$(sha256sum "$network_site_config" | awk '{print $1}')"
        network_shell_sha256="$(sha256sum "$network_shell" | awk '{print $1}')"
        [[ "$network_site_config_sha256" =~ $CHECKSUM_RE && \
           "$network_shell_sha256" =~ $CHECKSUM_RE ]] || \
            fail filesystem_failure "fixed Phase III network policy checksum failed"
        atomic_text "$run/state/nextflow-profile" "$network_nextflow_profile"
        atomic_text "$run/state/network-site-config-relative" \
            "$network_site_config_relative"
        atomic_text "$run/state/network-site-config-sha256" \
            "$network_site_config_sha256"
        atomic_text "$run/state/network-shell-relative" "$network_shell_relative"
        atomic_text "$run/state/network-shell-sha256" "$network_shell_sha256"
        phase3_network_site_contract_json="{\"nextflow_profile\":\"$network_nextflow_profile\",\"site_config\":\"$network_site_config_relative\",\"site_config_sha256\":\"$network_site_config_sha256\",\"worker_shell\":\"$network_shell_relative\",\"worker_shell_sha256\":\"$network_shell_sha256\"}"
        append_event "$run" "stage_phase3_network_policy_bound"
    fi

    if [[ "$profile" == heteromer-smoke || \
          "$profile" == phase3-phenix-probe || \
          "$profile" == unknown-discovery || \
          "$profile" == unknown-screen || \
          "$profile" == unknown-single-component || \
          "$profile" == unknown-pass2 ]]; then
        [[ "$SITE_ID" == marmic ]] || \
            fail environment_failure \
                "fixed Phenix-bound profile is currently qualified only on Marmic"
        [[ -f "$heteromer_phenix_manifest" && \
           ! -L "$heteromer_phenix_manifest" ]] || \
            fail environment_failure "fixed Phenix manifest is absent"
        [[ "$(sha256sum "$heteromer_phenix_manifest" | awk '{print $1}')" == \
           "$heteromer_phenix_sha256" ]] || \
            fail environment_failure "fixed heteromer Phenix manifest changed"
        atomic_text "$run/state/phenix-manifest" "$heteromer_phenix_manifest"
        atomic_text "$run/state/phenix-manifest-sha256" \
            "$heteromer_phenix_sha256"
        if [[ "$profile" == heteromer-smoke ]]; then
            heteromer_phenix_json="\"$heteromer_phenix_sha256\""
            append_event "$run" "stage_heteromer_phenix_bound"
        elif [[ "$profile" == phase3-phenix-probe ]]; then
            phase3_probe_phenix_json="\"$heteromer_phenix_sha256\""
            append_event "$run" "stage_phase3_phenix_probe_bound"
        else
            append_event "$run" "stage_phase3_unknown_phenix_bound"
        fi
    fi

    if [[ "$profile" == p0 || "$profile" == p1 || "$profile" == p2 || \
          "$profile" == p2-diverse || "$profile" == p2-control || \
          "$profile" == unknown-discovery || \
          "$profile" == unknown-screen || \
          "$profile" == unknown-single-component || \
          "$profile" == unknown-pass2 || \
          ( "$profile" == m4-copy && "${M4_CROSS_SITE_IMPORT:-false}" != true ) ]]; then
        p0_config_readiness || true
        [[ "$P0_CONFIG_STATUS" == ready ]] || {
            atomic_text "$run/state/phase" "stage_failed"
            atomic_text "$run/state/failure-class" "environment_failure"
            append_event "$run" "stage_p0_config_absent"
            fail environment_failure "fixed P0 configuration is absent or unsafe"
        }
        p0_config_sha256="$P0_CONFIG_SHA256"
        [[ "$p0_config_sha256" =~ $CHECKSUM_RE ]] || \
            fail filesystem_failure "P0 configuration checksum failed"
        database_manifest_sha256="$(sha256sum "$P0_DATABASE_MANIFEST" | awk '{print $1}')"
        [[ "$database_manifest_sha256" =~ $CHECKSUM_RE ]] || \
            fail filesystem_failure "expected database manifest checksum failed"
        atomic_text "$run/state/p0-config-sha256" "$p0_config_sha256"
        atomic_text "$run/state/database-manifest-sha256" "$database_manifest_sha256"
        p0_config_json="\"$p0_config_sha256\""
        database_manifest_json="\"$database_manifest_sha256\""
    elif [[ "$profile" == m6-operational || "$profile" == m6-leakage ]]; then
        database_config_readiness runtime || true
        [[ "$DATABASE_CONFIG_STATUS" == ready ]] || {
            atomic_text "$run/state/phase" "stage_failed"
            atomic_text "$run/state/failure-class" "environment_failure"
            append_event "$run" "stage_m6_database_config_absent"
            fail environment_failure \
                "fixed M6 runtime database configuration is absent or unsafe"
        }
        database_config_sha256="$DATABASE_CONFIG_SHA256"
        database_manifest_sha256="$(sha256sum "$DATABASE_MANIFEST" | awk '{print $1}')"
        [[ "$database_config_sha256" =~ $CHECKSUM_RE && \
           "$database_manifest_sha256" =~ $CHECKSUM_RE ]] || \
            fail filesystem_failure "M6 database provenance checksum failed"
        if [[ "$SITE_ID" == marmic ]]; then
            phenix_manifest="$heteromer_phenix_manifest"
            [[ "$(sha256sum "$phenix_manifest" | awk '{print $1}')" == \
               "$heteromer_phenix_sha256" ]] || \
                fail environment_failure "fixed Marmic M6 Phenix manifest changed"
        else
            phenix_manifest="${startup_site_values[6]}"
        fi
        [[ "$phenix_manifest" =~ $SAFE_PATH_RE && -f "$phenix_manifest" && \
           ! -L "$phenix_manifest" ]] || {
            atomic_text "$run/state/phase" "stage_failed"
            atomic_text "$run/state/failure-class" "environment_failure"
            append_event "$run" "stage_m6_phenix_manifest_absent"
            fail environment_failure \
                "fixed M6 Phenix manifest is absent or unsafe"
        }
        atomic_text "$run/state/database-config-sha256" "$database_config_sha256"
        atomic_text "$run/state/database-manifest" "$DATABASE_MANIFEST"
        atomic_text "$run/state/database-manifest-sha256" "$database_manifest_sha256"
        atomic_text "$run/state/phenix-manifest" "$phenix_manifest"
        atomic_text "$run/state/phenix-manifest-sha256" \
