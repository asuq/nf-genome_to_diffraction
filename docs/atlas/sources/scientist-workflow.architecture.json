      {
        "id": "composition_loop",
        "label": "Additional distinct-component loop",
        "focus": ["review_first_component", "next_distinct_component", "additional_component_copy_search", "report"],
        "note": "Test each additional component in order, repeat the run-and-review cycle, then stop with a reviewed report."
      }
    ]
