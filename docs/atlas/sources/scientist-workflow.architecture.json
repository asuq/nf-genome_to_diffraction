  "meta": {
    "title": "Genome-to-Diffraction Scientific Workflow",
    "locale": "en",
    "output": "docs/atlas/current/diagrams/scientist-workflow.html",
    "quality_profile": "showcase",
    "viewBox": [1250, 710],
    "legend": {"mode": "hidden"},
    "views": [
      {
        "id": "end_to_end",
        "label": "End-to-end analysis",
        "focus": ["diffraction_data", "protein_sequences", "preflight", "discover_prepare", "first_component_search_review", "next_distinct_component", "additional_component_copy_search", "report"],
        "note": "Follow the required scientific inputs through model testing and a reviewed report."
      },
      {
        "id": "inputs_records",
        "label": "Inputs and evidence",
        "focus": ["organism_metadata", "protein_sequences", "genome_sequence", "annotation_input", "diffraction_data", "localisation_weight"],
        "note": "Required and optional inputs are shown separately so missing optional evidence is not mistaken for missing required data."
      },
      {
        "id": "search_and_review",
        "label": "Search and review",
        "focus": ["preflight", "discover_prepare", "first_component_search_review", "next_distinct_component", "additional_component_copy_search", "report"],
        "note": "Model discovery leads to copy-count testing, map review, and a bounded conclusion."
      },
      {
        "id": "composition_loop",
        "label": "Additional-component loop",
        "focus": ["first_component_search_review", "next_distinct_component", "additional_component_copy_search", "report"],
        "note": "Choose another protein, test plausible copy counts, review the result, and either repeat or stop."
      }
    ]
  },
  "components": [
    {
      "id": "organism_metadata",
      "type": "database",
      "label": "Organism / Sample Name",
      "sublabel": "human-readable identity",
      "tag": "dedicated field not yet implemented",
      "pos": [30, 40],
      "size": [200, 68]
    },
    {
      "id": "genome_sequence",
      "type": "database",
      "label": "Genome Sequence",
      "sublabel": "genome FASTA (.fna)",
      "tag": "optional",
      "pos": [260, 40],
      "size": [190, 68]
    },
    {
      "id": "annotation_input",
      "type": "database",
      "label": "Gene Annotation",
      "sublabel": "GFF / GBFF + source version",
      "tag": "source + version required",
      "pos": [500, 40],
      "size": [230, 68]
    },
    {
      "id": "diffraction_data",
      "type": "database",
      "label": "Diffraction Data",
      "sublabel": "MTZ + crystal name",
      "tag": "required",
      "pos": [30, 150],
      "size": [190, 68]
    },
    {
      "id": "protein_sequences",
      "type": "database",
      "label": "Protein Sequences",
      "sublabel": "protein FASTA (.faa)",
      "tag": "required",
      "pos": [290, 150],
      "size": [190, 68]
    },
    {
      "id": "localisation_weight",
      "type": "database",
      "label": "Optional Evidence",
      "sublabel": "localisation + molecular weight",
      "tag": "missing is neutral",
      "pos": [570, 150],
      "size": [220, 68]
    },
    {
      "id": "preflight",
      "type": "security",
      "label": "MTZ Preflight",
      "sublabel": "symmetry + Free-R",
      "tag": "automatic check",
      "pos": [50, 320],
      "size": [150, 68]
    },
    {
      "id": "discover_prepare",
      "type": "backend",
      "label": "Find Protein Structure Models",
      "sublabel": "PDB: MMseqs2 + ProstT5/Foldseek",
      "tag": "E-value + ≥50% coverage filters",
      "pos": [265, 320],
      "size": [240, 68]
    },
    {
      "id": "first_component_search_review",
      "type": "backend",
      "label": "First-Component Search + Review",
      "sublabel": "Matthews count → joint search → maps",
      "tag": "retain up to three states",
      "pos": [550, 320],
      "size": [260, 68]
    },
    {
      "id": "next_distinct_component",
      "type": "database",
      "label": "Choose Another Protein",
      "sublabel": "from the supplied list",
      "tag": "up to six total components",
      "pos": [570, 460],
      "size": [220, 68]
    },
    {
      "id": "additional_component_copy_search",
      "type": "backend",
      "label": "Test Copy Count + Review",
      "sublabel": "1, 2, 3, or 4 copies",
      "tag": "repeat when another protein may fit",
      "pos": [580, 590],
      "size": [200, 68]
    },
    {
      "id": "report",
      "type": "database",
      "label": "Reviewed Report",
      "sublabel": "supported + uncertain findings",
      "tag": "bounded conclusion",
      "pos": [300, 590],
      "size": [180, 68]
    }
  ],
  "boundaries": [
    {
      "kind": "region",
      "label": "Inputs supplied before the run",
