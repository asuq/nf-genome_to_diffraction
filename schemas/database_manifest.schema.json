{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/genome-to-diffraction/database_manifest.schema.json",
  "title": "Prepared database manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "created_at", "resources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/resource"}
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_id",
        "name",
        "source",
        "root_path",
        "prepared_with",
        "prepared_at",
        "manifest_sha256",
        "status"
      ],
      "properties": {
        "database_id": {"type": "string"},
        "name": {"type": "string"},
        "source": {"type": "string"},
        "release_or_snapshot": {"type": ["string", "null"]},
        "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "root_path": {"type": "string"},
        "prepared_with": {
          "type": "object",
          "required": ["tool", "version"],
          "properties": {
            "tool": {"type": "string"},
            "version": {"type": "string"}
          },
          "additionalProperties": false
        },
        "parameters": {"type": "object"},
        "prepared_at": {"type": "string", "format": "date-time"},
        "file_count": {"type": ["integer", "null"], "minimum": 0},
        "total_bytes": {"type": ["integer", "null"], "minimum": 0},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "smoke_test_status": {"enum": ["passed", "failed", "not_run"]},
        "status": {"enum": ["ready", "incomplete", "failed"]},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
