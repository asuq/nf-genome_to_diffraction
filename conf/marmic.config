includeConfig "${projectDir}/external/nf-helper/conf/sites/marmic.config"

profiles {
    marmic {
        process {
            beforeScript = "export PATH=\"${projectDir}/.pixi/envs/hpc/bin:/usr/bin:/bin\""
            shell = [
                '/bin/bash',
                "${projectDir}/bootstrap/nf-gtd-worker-offline-shell",
                '-ue',
            ]

            // Select the large-memory node so resources can be built in /dev/shm
            // and published to shared storage with one verified copy-back.
            withLabel: process_database_download {
                cpus = 100
                memory = '2000 GB'
                time = '48 hours'
            }
            withLabel: process_search {
                cpus = 16
                memory = '64 GB'
                time = '24 hours'
            }
            // Phase III Phaser tasks derive 4/6/8-CPU first attempts from their
            // immutable workload plans. One classified resource/infrastructure
            // retry scales CPU, memory, and time linearly; these limits cap the
            // second attempt at 16 CPUs, 64 GB, and 48 hours. Slurm owns aggregate
            // admission and may run or pend every independent hypothesis.
            withLabel: process_mr {
                // Two otherwise identical MR jobs ran substantially slower on
                // slurm-003 than on slurm-401. Keep the exclusion scoped to MR
                // children so controllers and lightweight tasks retain capacity.
                clusterOptions = '--export=ALL --exclude=slurm-003'
                resourceLimits = [
                    cpus: 16,
                    memory: 64.GB,
                    time: 48.h,
                ]
            }
            withLabel: process_mr_fixed {
                cpus = 4
                memory = '16 GB'
                time = '24 hours'
            }
            // Match the existing Viper whole-catalogue bound while avoiding
            // a site-specific 2-TB/100-CPU placement constraint.
            withLabel: process_prostt5_search {
                cpus = 64
                memory = '192 GB'
                time = '24 hours'
            }
            // A real 128-query Phase III batch used 64.6 GiB MaxRSS and
            // 133.8 GiB MaxVM. Retain conservative headroom while allowing
            // Slurm to place independent batches across ordinary nodes.
            withName: SEARCH_PHASE3_FOLDSEEK_BATCH {
                cpus = 32
                memory = '192 GB'
                time = '4 hours'
            }

            // The fixed M6 orchestration smoke uses the same child-job bounds
            // at both reviewed sites so its resource evidence is comparable.
            withLabel: m6_small {
                cpus = 1
                memory = '4 GB'
                time = '1 hour'
            }
            withLabel: m6_pdb_search {
                cpus = 32
                memory = '16 GB'
                time = '24 hours'
            }
            withLabel: m6_foldseek_search {
                cpus = 32
                memory = '16 GB'
                time = '24 hours'
            }
            withLabel: m6_case_prepare {
                cpus = 2
                memory = '8 GB'
                time = '24 hours'
            }
            withLabel: m6_first_copy {
                cpus = 2
                memory = '4 GB'
                time = '24 hours'
            }
            withLabel: m6_add_copy {
                cpus = 2
                memory = '4 GB'
                time = '24 hours'
            }
            withLabel: m6_refinement {
                cpus = 4
                memory = '16 GB'
                time = '24 hours'
            }

        }

        // Zero is Nextflow's unlimited task-monitor capacity. Emit every
        // independent Slurm task and leave admission/concurrency to Slurm.
        executor {
            queueSize = 0
        }
    }
}
