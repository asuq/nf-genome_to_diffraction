includeConfig "${projectDir}/external/nf-helper/conf/sites/marmic.config"

profiles {
    marmic {
        process {
            beforeScript = "export PATH=\"${projectDir}/.pixi/envs/hpc/bin:/usr/bin:/bin\""
            shell = [
                '/bin/bash',
                "${projectDir}/bootstrap/nf-gtd-worker-offline-shell",
                '-ue',
            ]

            // Select the large-memory node so resources can be built in /dev/shm
            // and published to shared storage with one verified copy-back.
            withLabel: process_database_download {
                cpus = 100
                memory = '2000 GB'
                time = '48 hours'
            }
            withLabel: process_search {
                cpus = 16
                memory = '64 GB'
                time = '24 hours'
            }
            // Phaser has no adapter deadline. Use the site's conservative
            // maximum scheduler margin because licensed-runtime and NFS start-up
            // latency are not predictable enough for the four-hour base value.
            // Four workers per bounded hypothesis let the 25-job prototype fanout
            // use at most the site's declared 100-CPU capacity.
            withLabel: process_mr {
                cpus = 4
                memory = '8 GB'
                time = '1000 hours'
            }
            // ProstT5 inference is memory-intensive at catalogue scale. Use the
            // site's qualified large-memory node instead of treating it like a
            // conventional sequence search.
            withLabel: process_prostt5_search {
                cpus = 100
                memory = '2000 GB'
                time = '1000 hours'
            }

            // The fixed M6 orchestration smoke uses the same child-job bounds
            // at both reviewed sites so its resource evidence is comparable.
            withLabel: m6_small {
                cpus = 1
                memory = '4 GB'
                time = '1 hour'
            }
            withLabel: m6_pdb_search {
                cpus = 32
                memory = '16 GB'
                time = '24 hours'
            }
            withLabel: m6_foldseek_search {
                cpus = 32
                memory = '16 GB'
                time = '24 hours'
            }
            withLabel: m6_case_prepare {
                cpus = 2
                memory = '8 GB'
                time = '24 hours'
            }
            withLabel: m6_first_copy {
                cpus = 2
                memory = '4 GB'
                time = '24 hours'
            }
            withLabel: m6_add_copy {
                cpus = 2
                memory = '4 GB'
                time = '24 hours'
            }
            withLabel: m6_refinement {
                cpus = 4
                memory = '16 GB'
                time = '24 hours'
            }

        }
    }
}
