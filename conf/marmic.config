includeConfig "${projectDir}/external/nf-helper/conf/sites/marmic.config"

profiles {
    marmic {
        process {
            beforeScript = "export PATH=\"${projectDir}/.pixi/envs/hpc/bin:/usr/bin:/bin\""

            // Select the large-memory node so resources can be built in /dev/shm
            // and published to shared storage with one verified copy-back.
            withLabel: process_database_download {
                cpus = 100
                memory = '2000 GB'
                time = '48 hours'
            }
        }
    }
}
