includeConfig "${projectDir}/external/nf-helper/conf/sites/raven.config"

profiles {
    raven {
        // The base config derives workDir from the explicitly owned cache_root.
        executor.account = 'mmm_cpu'

        process {
            beforeScript = {
                "module load ${params.raven_apptainer_module}; " +
                "export PATH=\"${projectDir}/.pixi/envs/hpc/bin:\$PATH\""
            }

            // Retain the scientific CPU/memory policy, but obey Raven's
            // 24-hour per-job limit. The adapter records the resolved time.
            withLabel: process_mr {
                resourceLimits = [
                    cpus: 16,
                    memory: 64.GB,
                    time: 24.h,
                ]
            }

            // The approved M6 production batches retain Raven's maintained
            // scheduler queue/rate policy and mandatory 24-hour child limit.
            withLabel: m6_small {
                cpus = 1
                memory = '4 GB'
                time = '1 hour'
            }
            withLabel: m6_pdb_search {
                cpus = 32
                memory = '16 GB'
                time = '24 hours'
            }
            withLabel: m6_foldseek_search {
                cpus = 32
                memory = '96 GB'
                time = '24 hours'
            }
            withLabel: m6_case_prepare {
                cpus = 2
                memory = '8 GB'
                time = '24 hours'
            }
            withLabel: m6_first_copy {
                cpus = 2
                memory = '4 GB'
                time = '24 hours'
            }
            withLabel: m6_add_copy {
                cpus = 2
                memory = '4 GB'
                time = '24 hours'
            }
            withLabel: m6_refinement {
                cpus = 4
                memory = '16 GB'
                time = '24 hours'
            }
        }
    }
}
