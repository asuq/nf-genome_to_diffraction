process.executor = 'local'
executor.queueSize = 2
// Stub acceptance exercises `-resume`; retain disposable test work until the
// temporary test root is removed by the harness.
cleanup = false

process {
    cpus = 1
    memory = '1 GB'
    time = '5 min'

    withLabel: process_single {
        cpus = 1
        memory = '1 GB'
        time = '5 min'
    }
