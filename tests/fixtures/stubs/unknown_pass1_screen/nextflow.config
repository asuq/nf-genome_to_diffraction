workDir = '.cache/work'
cleanup = false

process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    time = '5 min'
    errorStrategy = 'terminate'
    maxRetries = 0

    withName: 'MATERIALISE_UNKNOWN_PASS1_CRYSTAL_ITEM' {
        publishDir = [path: 'results/crystals', mode: 'copy', overwrite: true]
    }
    withName: 'STUB_UNKNOWN_PASS1_A_HYPOTHESIS' {
        publishDir = [path: 'results/hypotheses', mode: 'copy', overwrite: true]
    }
}

trace {
    enabled = true
    file = 'results/pipeline_info/trace.tsv'
    overwrite = true
    fields = 'task_id,hash,name,process,tag,status,exit,submit,start,complete,workdir'
}
