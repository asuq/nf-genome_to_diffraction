params {
    outdir = 'results'
    cache_root = '.cache'
}

workDir = "${params.cache_root}/work"
cleanup = false

process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    time = '5 min'
    errorStrategy = 'terminate'
    maxRetries = 0

    // This portable stub runs on two-core CI workers. Its processes execute
    // only stub blocks, so constrain both current and archival MR labels while
    // production profiles retain their dynamic/fixed scientific allocations.
    withLabel: process_mr {
        cpus = 1
        memory = '1 GB'
        time = '5 min'
    }
    withLabel: process_mr_fixed {
        cpus = 1
        memory = '1 GB'
        time = '5 min'
    }
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
    fields = 'task_id,hash,name,process,tag,status,exit,submit,start,complete,workdir'
}
