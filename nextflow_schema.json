{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/nf-genome-to-diffraction/nextflow_schema.json",
  "title": "nf-genome_to_diffraction operator parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogues",
    "crystals",
    "config",
    "database_manifest",
    "phenix_manifest"
  ],
  "properties": {
    "catalogues": { "type": "string", "format": "file-path" },
    "crystals": { "type": "string", "format": "file-path" },
    "config": { "type": "string", "format": "file-path" },
    "database_manifest": { "type": "string", "format": "file-path" },
    "phenix_manifest": { "type": "string", "format": "file-path" },
    "outdir": { "type": "string", "default": "results" },
    "cache_root": { "type": "string", "default": ".cache" },
    "review_mode": {
      "type": "string",
      "enum": ["prepare", "continue", "auto_future"],
      "default": "prepare"
    },
    "approved_mr_seeds": {
      "type": ["string", "null"],
      "format": "file-path",
      "description": "Explicit human MR-seed decisions required when analysis_stage=additional_copy or t12."
    },
    "approved_sequence_groups": { "type": ["string", "null"] },
    "profile_mode": {
      "type": "string",
      "enum": ["smoke", "pilot", "extended"],
      "default": "smoke"
    },
    "analysis_stage": {
      "type": "string",
      "enum": ["task05", "discovery", "first_copy", "additional_copy", "t12"],
      "default": "task05",
      "description": "Highest normal-workflow boundary to execute. First-copy stops at the retain-all MR-seed checkpoint; additional-copy requires explicit decisions and searches one same-component copy at a time without score filtering; t12 retains every approved best-supported copy state for refinement, maps, and sequence narrowing."
    },
    "skip_xtriage": {
      "type": "boolean",
      "default": false,
      "description": "Skip Xtriage and force review status; intended only for preparation/tests."
    },
    "maximum_evalue": { "type": "number", "minimum": 0, "default": 1e-5 },
    "minimum_query_coverage": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
    "maximum_query_length": { "type": "integer", "minimum": 1, "default": 10000 },
    "prostt5_maximum_evalue": { "type": "number", "minimum": 0, "default": 1e-3 },
    "prostt5_minimum_query_coverage": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
    "prostt5_maximum_query_length": { "type": "integer", "minimum": 1, "default": 10000 },
    "prostt5_maximum_queries": { "type": "integer", "minimum": 0, "default": 0 },
    "prostt5_gpu": { "type": "boolean", "default": false },
    "afdb_accession_map": { "type": ["string", "null"], "format": "file-path" },
    "afdb_request_timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 60 },
    "afdb_retry_count": { "type": "integer", "minimum": 0, "default": 3 },
    "maximum_pdb_hits_per_sequence_group": { "type": "integer", "minimum": 1, "default": 3 },
    "maximum_pdb_mappings": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 25 },
    "maximum_first_copy_jobs": { "type": "integer", "minimum": 1, "maximum": 200, "default": 25 }
  }
}
